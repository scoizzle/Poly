<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <OutputType>Library</OutputType>
        <!-- The types keep namespace Poly.DomainModeling.Runtime until R-05/R-07 so the
             emitted C# surface (ClrTypeReference derives names from RuntimeType.FullName)
             is byte-identical. The folder name must not become the root namespace. -->
        <RootNamespace>Poly.DomainModeling.Runtime</RootNamespace>
        <!-- No type-forwarders: compiled consumers of Poly 1.0.1 take a binary break,
             recorded as a risk. Not packable so no pack picks up a stray dependency. -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

</Project>
