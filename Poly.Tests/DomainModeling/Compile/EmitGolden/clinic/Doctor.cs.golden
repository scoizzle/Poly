#nullable enable
public class Doctor
{
    private Doctor() { }
    private Doctor(string licenseNo, string name, Schedule? schedule = null)
    {
        this.LicenseNo = licenseNo;
        this.Name = name;
        this.Schedule = schedule;
    }
    public string LicenseNo { get; private set; } = default!;
    public string Name { get; private set; } = default!;
    public Schedule? Schedule { get; private set; }
    public DomainResult StartShift()
    {
        if (this.Schedule == null)
        {
            return DomainResult.Failure("'StartShift' requires a linked 'schedule' on entity 'Doctor'.");
        }
        var invoke0 = this.Schedule.Open();
        if (!invoke0.IsSuccess)
        {
            return DomainResult.Failure(invoke0.ErrorMessage ?? "");
        }
        return DomainResult.Success();
    }
    public static DomainResult<Doctor> Create(string licenseNo, string name, Poly.DomainModeling.Runtime.IStoragePort db, Schedule? schedule = null)
    {
        if (!string.IsNullOrEmpty(licenseNo) && !System.Text.RegularExpressions.Regex.IsMatch(licenseNo, "^MD-[0-9]{6}$"))
        {
            return DomainResult<Doctor>.Failure("'LicenseNo' does not match the required pattern.");
        }
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Doctor>.Failure("'Name' is required.");
        }
        if (name.Length < 3L)
        {
            return DomainResult<Doctor>.Failure("'Name' must be at least 3 characters.");
        }
        if (name.Length > 60L)
        {
            return DomainResult<Doctor>.Failure("'Name' must be at most 60 characters.");
        }
        if (Doctor.ExistsWithLicenseNo(db, licenseNo))
        {
            return DomainResult<Doctor>.Failure("Unique constraint violated: 'LicenseNo' value is already used on another 'Doctor'.");
        }
        var created = new Doctor(licenseNo, name, schedule);
        db.Record("Doctor", "LicenseNo", licenseNo);
        return DomainResult<Doctor>.Success(created);
    }
    public DomainResult EnsureUnique(string propertyName, object value) => DomainResult.Success();
    public static System.Boolean ExistsWithLicenseNo(Poly.DomainModeling.Runtime.IStoragePort db, System.String licenseNo) => db.Exists("Doctor", "LicenseNo", licenseNo);
}