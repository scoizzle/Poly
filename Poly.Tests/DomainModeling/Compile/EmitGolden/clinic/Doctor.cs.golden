    private DomainResult<object> BindCreate(string typeName, Dictionary<string, object> values)
    {
        if (typeName == "Doctor")
        {
            var typed = Doctor.Create((values.ContainsKey("LicenseNo") ? (string?)values["LicenseNo"] ?? "" : ""), (values.ContainsKey("Name") ? (string?)values["Name"] ?? "" : ""), (values.ContainsKey("schedule") ? (Schedule?)values["schedule"] ?? null : null));
            if (!typed.IsSuccess)
            {
                return DomainResult<object>.Failure(typed.ErrorMessage ?? "");
            }
            else
            {
                return DomainResult<object>.Success(typed.Value);
            }
        }
        if (typeName == "Schedule")
        {
            var typed = Schedule.Create((values.ContainsKey("Day") ? (string?)values["Day"] ?? "" : ""), (values.ContainsKey("State") ? (string?)values["State"] ?? "" : ""));
            if (!typed.IsSuccess)
            {
                return DomainResult<object>.Failure(typed.ErrorMessage ?? "");
            }
            else
            {
                return DomainResult<object>.Success(typed.Value);
            }
        }
        if (typeName == "Patient")
        {
            var typed = Patient.Create((values.ContainsKey("Name") ? (string?)values["Name"] ?? "" : ""), new List<Visit>());
            if (!typed.IsSuccess)
            {
                return DomainResult<object>.Failure(typed.ErrorMessage ?? "");
            }
            else
            {
                return DomainResult<object>.Success(typed.Value);
            }
        }
        if (typeName == "Visit")
        {
            var typed = Visit.Create((values.ContainsKey("Reason") ? (string?)values["Reason"] ?? "" : ""), (values.ContainsKey("patient") ? (Patient?)values["patient"] ?? null : null), (values.ContainsKey("primaryDoctor") ? (Doctor?)values["primaryDoctor"] ?? null : null), (values.ContainsKey("State") ? (VisitState?)values["State"] ?? VisitState.Scheduled : VisitState.Scheduled));
            if (!typed.IsSuccess)
            {
                return DomainResult<object>.Failure(typed.ErrorMessage ?? "");
            }
            else
            {
                return DomainResult<object>.Success(typed.Value);
            }
        }
        return DomainResult<object>.Failure("Unknown type '" + typeName + "'.");
    }
