#nullable enable
using Poly.Runtime;

public class Doctor
{
    private Doctor() { }
    private Doctor(string name, string licenseNo, Schedule? schedule = null)
    {
        this.Name = name;
        this.LicenseNo = licenseNo;
        this.Schedule = schedule;
    }
    public string Name { get; private set; } = default!;
    public string LicenseNo { get; private set; } = default!;
    public Schedule? Schedule { get; private set; }
    public DomainResult StartShift()
    {
        if (this.Schedule == null)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Required("'StartShift' requires a linked 'schedule' on entity 'Doctor'.", "Doctor.schedule"));
        }
        var invoke0 = this.Schedule.Open();
        if (!invoke0.IsSuccess)
        {
            return DomainResult.Failure(invoke0.Error!.At("Doctor.StartShift"));
        }
        return DomainResult.Success();
    }
    public static DomainResult<Doctor> Create(string name, string licenseNo, Poly.Runtime.IStoragePort db, Schedule? schedule = null)
    {
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Doctor>.Failure(Poly.Runtime.DomainFailure.Required("'Name' is required.", "Doctor.Name"));
        }
        if (name.Length < 3L)
        {
            return DomainResult<Doctor>.Failure(Poly.Runtime.DomainFailure.Length("'Name' must be at least 3 characters.", "Doctor.Name"));
        }
        if (name.Length > 60L)
        {
            return DomainResult<Doctor>.Failure(Poly.Runtime.DomainFailure.Length("'Name' must be at most 60 characters.", "Doctor.Name"));
        }
        if (string.IsNullOrEmpty(licenseNo))
        {
            return DomainResult<Doctor>.Failure(Poly.Runtime.DomainFailure.Required("'LicenseNo' is required.", "Doctor.LicenseNo"));
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(licenseNo, "^MD-[0-9]{6}\\z"))
        {
            return DomainResult<Doctor>.Failure(Poly.Runtime.DomainFailure.Pattern("'LicenseNo' does not match the required pattern.", "Doctor.LicenseNo"));
        }
        if (Doctor.ExistsWithLicenseNo(db, licenseNo))
        {
            return DomainResult<Doctor>.Failure(Poly.Runtime.DomainFailure.Unique("Unique constraint violated: 'LicenseNo' value is already used on another 'Doctor'.", "Doctor.LicenseNo"));
        }
        var created = new Doctor(name, licenseNo, schedule);
        db.Record("Doctor", "LicenseNo", licenseNo);
        return DomainResult<Doctor>.Success(created);
    }
    public DomainResult EnsureUnique(string propertyName, object value)
    {
        if (value == null)
        {
            return DomainResult.Success();
        }
        if (propertyName == "LicenseNo" && object.Equals(this.LicenseNo, value))
        {
            return DomainResult.Success();
        }
        return DomainResult.Failure(Poly.Runtime.DomainFailure.Constraint("A unique assign needs the storage port.", "Doctor"));
    }
    public static System.Boolean ExistsWithLicenseNo(Poly.Runtime.IStoragePort db, System.String licenseNo) => db.Exists("Doctor", "LicenseNo", licenseNo);
}