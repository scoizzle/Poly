#nullable enable
using System.Collections.Generic;

using Poly.Runtime;

public class Patient : Poly.Runtime.IActionScoped
{
    private List<Visit> _visits = new List<Visit>();
    private Patient() { }
    private Patient(string name, IEnumerable<Visit>? visits = null)
    {
        this.Name = name;
        this._visits = new List<Visit>(visits ?? new List<Visit>());
    }
    public string Name { get; private set; } = default!;
    public IReadOnlyList<Visit> Visits
    {
        get => this._visits;
    }
    internal void AttachVisits(Visit child)
    {
        this._visits.Add(child);
    }
    public DomainResult CheckInAll()
    {
        foreach (var target0 in this.Visits)
        {
            if (target0.CurrentStage != VisitStage.Scheduled)
            {
                continue;
            }
            var result1 = target0.CheckIn();
            if (!result1.IsSuccess)
            {
                return DomainResult.Failure(result1.Error!.At("Patient.CheckInAll"));
            }
        }
        return DomainResult.Success();
    }
    public static DomainResult<Patient> Create(string name, IEnumerable<Visit>? visits = null)
    {
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Patient>.Failure(Poly.Runtime.DomainFailure.Required("'Name' is required.", "Patient.Name"));
        }
        var created = new Patient(name, visits);
        return DomainResult<Patient>.Success(created);
    }
    public object __Snapshot()
    {
        var __state = new object?[2];
        __state[0] = this.Name;
        __state[1] = new List<Visit>(this._visits);
        return __state;
    }
    public void __Restore(object state)
    {
        var __saved = (object?[])state;
        this.Name = (string)__saved[0]!;
        ((System.Collections.IList)this._visits).Clear();
        foreach (var __item1 in(List<Visit>)__saved[1]!)
        {
            this._visits.Add(__item1);
        }
    }
}