#nullable enable
using System.Collections.Generic;

public class Patient
{
    private List<Visit> _visits = new List<Visit>();
    private Patient() { }
    private Patient(string name, IEnumerable<Visit>? visits = null)
    {
        this.Name = name;
        this._visits = new List<Visit>(visits ?? new List<Visit>());
    }
    public string Name { get; private set; } = default!;
    public IReadOnlyList<Visit> Visits
    {
        get => this._visits;
    }
    internal void AttachVisits(Visit child)
    {
        this._visits.Add(child);
    }
    public DomainResult CheckInAll()
    {
        foreach (var target0 in this.Visits)
        {
            if (target0.CurrentStage != VisitStage.Scheduled)
            {
                continue;
            }
            var result1 = target0.CheckIn();
            if (!result1.IsSuccess)
            {
                return DomainResult.Failure(result1.ErrorMessage ?? "");
            }
        }
        return DomainResult.Success();
    }
    public static DomainResult<Patient> Create(string name, IEnumerable<Visit>? visits = null)
    {
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Patient>.Failure("'Name' is required.");
        }
        var created = new Patient(name, visits);
        return DomainResult<Patient>.Success(created);
    }
}