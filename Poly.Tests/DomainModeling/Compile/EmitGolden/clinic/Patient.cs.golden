    private List<Visit> _visits;
    private Patient()
    {
        this._visits = new List<Visit>();
    }
    private Patient(string name, IEnumerable<Visit>? visits = null)
    {
        this.Name = name;
        this._visits = new List<Visit>(visits ?? new List<Visit>());
    }
    public string Name { get; private set; } = default!;
    public IReadOnlyList<Visit> Visits
    {
        get => this._visits;
    }
    private DomainResult<Visit> CreateVisits(string reason, Doctor? primaryDoctor, VisitState state = VisitState.Scheduled)
    {
        var visitResult = Visit.Create(reason, this, primaryDoctor, state);
        if (!visitResult.IsSuccess)
        {
            return DomainResult<Visit>.Failure(visitResult.ErrorMessage ?? "");
        }
        var visit = visitResult.Value;
        return DomainResult<Visit>.Success(visit);
    }
    internal void AttachVisits(Visit child)
    {
        this._visits.Add(child);
    }
    public DomainResult CheckInAll()
    {
        var matched1 = false;
        foreach (var target0 in this.Visits)
        {
            if (!(target0.CurrentStage == VisitStage.Scheduled))
            {
                continue;
            }
            matched1 = true;
            var result2 = target0.CheckIn();
            if (!result2.IsSuccess)
            {
                return DomainResult.Failure(result2.ErrorMessage ?? "");
            }
        }
        if (!matched1)
        {
            return DomainResult.Failure("for visits.CheckIn matched zero targets.");
        }
        return DomainResult.Success();
    }
    public static DomainResult<Patient> Create(string name, IEnumerable<Visit>? visits = null)
    {
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Patient>.Failure("'Name' is required.");
        }
        var created = new Patient(name, visits);
        return DomainResult<Patient>.Success(created);
    }
