#nullable enable
using Poly.Runtime;

public class Schedule
{
    private Schedule() { }
    private Schedule(string day, string state = "")
    {
        this.Day = day;
        this.State = state;
    }
    public string Day { get; private set; } = default!;
    public string State { get; private set; } = default!;
    public DomainResult Open()
    {
        this.State = "open";
        return DomainResult.Success();
    }
    public static DomainResult<Schedule> Create(string day, string state = "")
    {
        if (string.IsNullOrEmpty(day))
        {
            return DomainResult<Schedule>.Failure(Poly.Runtime.DomainFailure.Required("'Day' is required.", "Schedule.Day"));
        }
        if (string.IsNullOrEmpty(state))
        {
            return DomainResult<Schedule>.Failure(Poly.Runtime.DomainFailure.Required("'State' is required.", "Schedule.State"));
        }
        var created = new Schedule(day, state);
        return DomainResult<Schedule>.Success(created);
    }
}