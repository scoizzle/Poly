#nullable enable
public enum VisitStage
{
    Scheduled = 0,
    CheckedIn = 1,
    InTreatment = 2,
    Completed = 3,
    NoShow = 4
}

public class Visit
{
    private Visit() { }
    private Visit(string reason, Patient? patient = null, Doctor? primaryDoctor = null, VisitState state = VisitState.Scheduled)
    {
        this.Reason = reason;
        this.State = state;
        this.Patient = patient;
        this.PrimaryDoctor = primaryDoctor;
        this.CurrentStage = VisitStage.Scheduled;
    }
    public string Reason { get; private set; } = default!;
    public VisitState State { get; private set; }
    public Patient? Patient { get; private set; }
    public Doctor? PrimaryDoctor { get; private set; }
    public VisitStage CurrentStage { get; private set; }
    public DomainResult AssignDoctor(Doctor doctor)
    {
        this.Reason = "assigned";
        return DomainResult.Success();
    }
    public DomainResult CheckIn()
    {
        if (this.CurrentStage != VisitStage.Scheduled)
        {
            return DomainResult.Failure("'CheckIn' requires stage 'Scheduled' on entity 'Visit'.");
        }
        this.CurrentStage = VisitStage.CheckedIn;
        this.State = VisitState.CheckedIn;
        return DomainResult.Success();
    }
    public static DomainResult<Visit> Create(string reason, Patient? patient = null, Doctor? primaryDoctor = null, VisitState state = VisitState.Scheduled)
    {
        if (!string.IsNullOrEmpty(reason))
        {
            if (reason.Length < 2L)
            {
                return DomainResult<Visit>.Failure("'Reason' must be at least 2 characters.");
            }
            if (reason.Length > 200L)
            {
                return DomainResult<Visit>.Failure("'Reason' must be at most 200 characters.");
            }
        }
        if (state != VisitState.Scheduled && state != VisitState.CheckedIn && state != VisitState.InTreatment && state != VisitState.Completed && state != VisitState.NoShow)
        {
            return DomainResult<Visit>.Failure(string.Concat("'", state, "' is not a valid member of VisitState for property 'State'."));
        }
        var created = new Visit(reason, patient, primaryDoctor, state);
        if (patient != null)
        {
            patient.AttachVisits(created);
        }
        return DomainResult<Visit>.Success(created);
    }
}