app.MapPost("/api/accounts/{id}/opportunities/{opportunityId}/completeopenwork", async (int id, int opportunityId, CrmDbContext db) => {
    var parentEntity = await db.Accounts.FindAsync(id);
    if (parentEntity == null)
    {
        return Results.NotFound("Account not found");
    }
    var entity = await db.Opportunitys.FindAsync(opportunityId);
    if (entity == null)
    {
        return Results.NotFound("Opportunity not found");
    }
    await db.Entry(parentEntity).Collection(e => e.Opportunities).LoadAsync();
    if (!parentEntity.Opportunities.Any(e => e == entity))
    {
        return Results.NotFound("Opportunity not found for this Account");
    }
    await db.Entry(entity).Collection(e => e.Activities).LoadAsync();
    await db.Entry(entity).Collection(e => e.Lines).LoadAsync();
    await db.Entry(entity).Collection(e => e.Quotes).LoadAsync();
    try
    {
        var result = entity.CompleteOpenWork();
        await db.SaveChangesAsync();
        if (result.IsSuccess)
        {
            return Results.Ok("ok");
        }
        else
        {
            return Results.Conflict(result.ErrorMessage);
        }
    }
    catch (Exception)
    {
        return Results.StatusCode(500);
    }
});

