#nullable enable

using System.Text.Json;
using System.Text.Json.Serialization;
using Microsoft.EntityFrameworkCore;
using System.ComponentModel.DataAnnotations;
using Poly.Generated;

var builder = WebApplication.CreateBuilder(args);

builder.Services.ConfigureHttpJsonOptions(options => {
    options.SerializerOptions.ReferenceHandler = ReferenceHandler.IgnoreCycles;
    options.SerializerOptions.Converters.Add(new JsonStringEnumConverter());
}
);

builder.Services.AddDbContext<CrmDbContext>(options => options.UseSqlite("Data Source=crm.db"));

var app = builder.Build();

using (var scope = app.Services.CreateScope())
{
    var db = scope.ServiceProvider.GetRequiredService<CrmDbContext>();
    await db.Database.EnsureCreatedAsync();
    await SeedAsync(db);
}

app.MapGet("/api/sites", async (CrmDbContext db) => await db.Sites.ToListAsync());

app.MapGet("/api/sites/{id}", async (int id, CrmDbContext db) => (await db.Sites.FindAsync(id) is Site site ? Results.Ok(site) : Results.NotFound()));

app.MapPost("/api/sites", async (SiteDto dto, CrmDbContext db) => {
    var siteResult = Site.Create(dto.City, dto.Region);
    if (!siteResult.IsSuccess)
    {
        return Results.Conflict(siteResult.ErrorMessage);
    }
    db.Sites.Add(siteResult.Value);
    await db.SaveChangesAsync();
    return Results.Ok(siteResult.Value);
}
);

app.MapGet("/api/products", async (CrmDbContext db) => await db.Products.ToListAsync());

app.MapGet("/api/products/{sku}", async (string sku, CrmDbContext db) => (await db.Products.FindAsync(sku) is Product product ? Results.Ok(product) : Results.NotFound()));

app.MapPost("/api/products", async (ProductDto dto, CrmDbContext db) => {
    var productResult = Product.Create(dto.ListPrice, dto.Name, dto.Sku);
    if (!productResult.IsSuccess)
    {
        return Results.Conflict(productResult.ErrorMessage);
    }
    db.Products.Add(productResult.Value);
    await db.SaveChangesAsync();
    return Results.Created(string.Concat("/api/products/", productResult.Value.Sku.ToString()), productResult.Value);
}
);

app.MapGet("/api/campaigns", async (CrmDbContext db) => await db.Campaigns.ToListAsync());

app.MapGet("/api/campaigns/{id}", async (int id, CrmDbContext db) => (await db.Campaigns.FindAsync(id) is Campaign campaign ? Results.Ok(campaign) : Results.NotFound()));

app.MapPost("/api/campaigns", async (CampaignDto dto, CrmDbContext db) => {
    var campaignResult = Campaign.Create(dto.Name, Enumerable.Empty<CampaignMember>());
    if (!campaignResult.IsSuccess)
    {
        return Results.Conflict(campaignResult.ErrorMessage);
    }
    db.Campaigns.Add(campaignResult.Value);
    await db.SaveChangesAsync();
    return Results.Ok(campaignResult.Value);
}
);

app.MapGet("/api/leads/{email}/account", async (string email, CrmDbContext db) => {
    var parent = await db.Leads.FindAsync(email);
    if (parent == null)
    {
        return Results.NotFound();
    }
    await db.Entry(parent).Reference(e => e.Account).LoadAsync();
    return Results.Ok(parent.Account);
}
);

