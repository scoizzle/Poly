app.MapPost("/api/activitys/{id}/opportunity/commit", async (int id, CrmDbContext db) => {
    var parentEntity = await db.Activitys.FindAsync(id);
    if (parentEntity == null)
    {
        return Results.NotFound("Activity not found");
    }
    await db.Entry(parentEntity).Reference(e => e.Opportunity).LoadAsync();
    var entity = parentEntity.Opportunity;
    if (entity == null)
    {
        return Results.NotFound("Opportunity not found");
    }
    await db.Entry(entity).Collection(e => e.Activities).LoadAsync();
    await db.Entry(entity).Collection(e => e.Lines).LoadAsync();
    await db.Entry(entity).Collection(e => e.Quotes).LoadAsync();
    try
    {
        var result = entity.Commit();
        await db.SaveChangesAsync();
        if (result.IsSuccess)
        {
            return Results.Ok("ok");
        }
        else
