app.MapPost("/api/accounts/{id}/contacts/{email}/retire", async (int id, string email, CrmDbContext db) => {
    var parentEntity = await db.Accounts.FindAsync(id);
    if (parentEntity == null)
    {
        return Results.NotFound("Account not found");
    }
    var entity = await db.Contacts.FirstOrDefaultAsync(e => e.Email == email);
    if (entity == null)
    {
        return Results.NotFound("Contact not found");
    }
    await db.Entry(parentEntity).Collection(e => e.Contacts).LoadAsync();
    if (!parentEntity.Contacts.Any(e => e == entity))
    {
        return Results.NotFound("Contact not found for this Account");
    }
    try
    {
        var result = entity.Retire();
        await db.SaveChangesAsync();
        if (result.IsSuccess)
        {
            return Results.Ok("ok");
        }
        else
        {
            return Results.Conflict(result.ErrorMessage);
        }
    }
    catch (Exception)
    {
        return Results.StatusCode(500);
    }
});

