app.MapPost("/api/leads/{email}/convert", async (string email, CrmDbContext db) => {
    var entity = await db.Leads.FirstOrDefaultAsync(e => e.Email == email);
    if (entity == null)
    {
        return Results.NotFound("Lead not found");
    }
    try
    {
        var result = entity.Convert();
        await db.SaveChangesAsync();
        if (result.IsSuccess)
        {
            return Results.Ok("ok");
        }
        else
        {
            return Results.Conflict(result.ErrorMessage);
        }
    }
    catch (Exception)
    {
        return Results.StatusCode(500);
    }
});

