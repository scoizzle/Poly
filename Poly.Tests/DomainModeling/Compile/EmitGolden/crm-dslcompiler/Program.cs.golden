    var parent = await db.Accounts.FindAsync(id);
    if (parent == null)
    {
        return Results.NotFound();
    }
    await db.Entry(parent).Collection(e => e.Contacts).LoadAsync();
    var child = parent.Contacts.FirstOrDefault(e => e.Email == email);
    if (child == null)
    {
        return Results.NotFound();
    }
    return Results.Ok(child);
});

app.MapGet("/api/accounts/{id}/opportunities", async (int id, CrmDbContext db) => {
