app.MapPost("/api/leads/{email}/account/placehq", async (string email, PlaceHqDto dto, CrmDbContext db) => {
    var parentEntity = await db.Leads.FindAsync(email);
    if (parentEntity == null)
    {
        return Results.NotFound("Lead not found");
    }
    await db.Entry(parentEntity).Reference(e => e.Account).LoadAsync();
    var entity = parentEntity.Account;
    if (entity == null)
    {
        return Results.NotFound("Account not found");
    }
    await db.Entry(entity).Collection(e => e.Contacts).LoadAsync();
    await db.Entry(entity).Collection(e => e.Opportunities).LoadAsync();
    await db.Entry(entity).Collection(e => e.Tickets).LoadAsync();
    try
    {
        var result = entity.PlaceHq(dto.city, dto.region);
        await db.SaveChangesAsync();
        if (result.IsSuccess)
        {
            return Results.Ok(result.Value);
        }
        else
        {
            return Results.Conflict(result.ErrorMessage);
        }
    }
    catch (Exception)
    {
        return Results.StatusCode(500);
    }
}
);

