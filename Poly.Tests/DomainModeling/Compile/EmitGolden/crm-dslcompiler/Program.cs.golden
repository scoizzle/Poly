app.MapPost("/api/accounts/{id}/convertlead", async (int id, ConvertLeadDto dto, CrmDbContext db) => {
    var entity = await db.Accounts.FindAsync(id);
    if (entity == null)
    {
        return Results.NotFound("Account not found");
    }
    await db.Entry(entity).Collection(e => e.Contacts).LoadAsync();
    await db.Entry(entity).Collection(e => e.Opportunities).LoadAsync();
    await db.Entry(entity).Collection(e => e.Tickets).LoadAsync();
    try
    {
        var lead = await db.Leads.FirstOrDefaultAsync(e => e.Email == dto.leadId);
        if (lead == null)
        {
            return Results.NotFound("Lead not found");
        }
        var result = entity.ConvertLead(lead);
        await db.SaveChangesAsync();
        if (result.IsSuccess)
        {
            return Results.Ok(result.Value);
        }
        else
        {
            return Results.Conflict(result.ErrorMessage);
        }
    }
    catch (Exception)
    {
        return Results.StatusCode(500);
    }
});

