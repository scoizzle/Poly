#nullable enable

using System.Text.Json;
using System.Text.Json.Serialization;
using Microsoft.EntityFrameworkCore;
using System.ComponentModel.DataAnnotations;
using Poly.Generated;

var builder = WebApplication.CreateBuilder(args);

builder.Services.ConfigureHttpJsonOptions(options => {
    options.SerializerOptions.ReferenceHandler = ReferenceHandler.IgnoreCycles;
    options.SerializerOptions.Converters.Add(new JsonStringEnumConverter());
});

builder.Services.AddDbContext<CrmDbContext>(options => options.UseSqlite("Data Source=crm.db"));

var app = builder.Build();

using (var scope = app.Services.CreateScope())
{
    var db = scope.ServiceProvider.GetRequiredService<CrmDbContext>();
    await db.Database.EnsureCreatedAsync();
    await SeedAsync(db);
}

app.MapGet("/api/products", async (CrmDbContext db) => await db.Products.ToListAsync());

app.MapGet("/api/products/{sku}", async (string sku, CrmDbContext db) => (await db.Products.FirstOrDefaultAsync(e => e.Sku == sku) is Product product ? Results.Ok(product) : Results.NotFound()));

app.MapPost("/api/products", async (ProductDto dto, CrmDbContext db) => {
    var productResult = Product.Create(dto.ListPrice, dto.Name, dto.Sku);
    if (!productResult.IsSuccess)
    {
        return Results.Conflict(productResult.ErrorMessage);
    }
    db.Products.Add(productResult.Value);
    await db.SaveChangesAsync();
    return Results.Created(string.Concat("/api/products/", productResult.Value.Sku.ToString()), productResult.Value);
});

app.MapGet("/api/leads", async (CrmDbContext db) => await db.Leads.ToListAsync());

app.MapGet("/api/leads/{email}", async (string email, CrmDbContext db) => (await db.Leads.FirstOrDefaultAsync(e => e.Email == email) is Lead lead ? Results.Ok(lead) : Results.NotFound()));

app.MapPost("/api/leads", async (LeadDto dto, CrmDbContext db) => {
    var leadResult = Lead.Create(dto.Company, dto.Email, dto.Name, null);
    if (!leadResult.IsSuccess)
    {
        return Results.Conflict(leadResult.ErrorMessage);
    }
    db.Leads.Add(leadResult.Value);
    await db.SaveChangesAsync();
    return Results.Created(string.Concat("/api/leads/", leadResult.Value.Email.ToString()), leadResult.Value);
});

app.MapGet("/api/accounts", async (CrmDbContext db) => await db.Accounts.ToListAsync());

app.MapGet("/api/accounts/{id}", async (int id, CrmDbContext db) => (await db.Accounts.FindAsync(id) is Account account ? Results.Ok(account) : Results.NotFound()));

app.MapPost("/api/accounts", async (AccountDto dto, CrmDbContext db) => {
    var accountResult = Account.Create(dto.Industry, dto.Name, null, null, Enumerable.Empty<Contact>(), Enumerable.Empty<Opportunity>(), Enumerable.Empty<Ticket>());
    if (!accountResult.IsSuccess)
    {
        return Results.Conflict(accountResult.ErrorMessage);
    }
    db.Accounts.Add(accountResult.Value);
    await db.SaveChangesAsync();
    return Results.Ok(accountResult.Value);
});

app.MapGet("/api/campaigns", async (CrmDbContext db) => await db.Campaigns.ToListAsync());

app.MapGet("/api/campaigns/{id}", async (int id, CrmDbContext db) => (await db.Campaigns.FindAsync(id) is Campaign campaign ? Results.Ok(campaign) : Results.NotFound()));

app.MapPost("/api/campaigns", async (CampaignDto dto, CrmDbContext db) => {
    var campaignResult = Campaign.Create(dto.Name, Enumerable.Empty<CampaignMember>());
    if (!campaignResult.IsSuccess)
    {
        return Results.Conflict(campaignResult.ErrorMessage);
    }
    db.Campaigns.Add(campaignResult.Value);
    await db.SaveChangesAsync();
    return Results.Ok(campaignResult.Value);
});

app.MapGet("/api/accounts/{id}/hq", async (int id, CrmDbContext db) => {
    var parent = await db.Accounts.FindAsync(id);
    if (parent == null)
    {
        return Results.NotFound();
    }
    await db.Entry(parent).Reference(e => e.Hq).LoadAsync();
    return Results.Ok(parent.Hq);
});

