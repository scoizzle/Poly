static async Task SeedAsync(CrmDbContext db)
{
    if (db == null)
    {
        return;
    }
    if (await db.Sites.AnyAsync())
    {
        return;
    }
    var siteResult = Site.Create("Sample", "Sample");
    if (siteResult.IsSuccess)
    {
        db.Add(siteResult.Value);
    }
    var productResult = Product.Create(1, "Sample", "XXXXXXXX");
    if (productResult.IsSuccess)
    {
        db.Add(productResult.Value);
    }
    var campaignResult = Campaign.Create("Sample", Enumerable.Empty<CampaignMember>());
    if (campaignResult.IsSuccess)
    {
        db.Add(campaignResult.Value);
    }
    await db.SaveChangesAsync();
}


app.Run();


public record SiteDto
{
    [Required]
    public string City { get; init; } = default!;
    public string Region { get; init; } = default!;
}

public record ProductDto
{
    [Range(0, 100000000)]
    public long ListPrice { get; init; }
    [Required]
    public string Name { get; init; } = default!;
    [Required]
    [MinLength(3)]
    [MaxLength(32)]
    public string Sku { get; init; } = default!;
}

public record CampaignDto
{
    [Required]
    public string Name { get; init; } = default!;
}

public record PlaceHqDto
{
    public string city { get; init; } = default!;
    public string region { get; init; } = default!;
}

public record AddContactDto
{
    public string name { get; init; } = default!;
    public string email { get; init; } = default!;
}

public record ConvertLeadDto
{
    public string leadId { get; init; } = default!;
}

public record OpenDealDto
{
    public string title { get; init; } = default!;
    public long amount { get; init; }
}

public record OpenTicketDto
{
    public string subject { get; init; } = default!;
}

public record OpportunityLogDto
{
    public string subject { get; init; } = default!;
}

public record OpportunityAddLineDto
{
    public string skuId { get; init; } = default!;
    public long qty { get; init; }
}

public record CaptureDto
{
    public ChargeRequest request { get; init; } = default!;
}

public record QuoteAddLineDto
{
    public string skuId { get; init; } = default!;
    public long qty { get; init; }
}

public record EnrollDto
{
    public string whoId { get; init; } = default!;
}