app.MapGet("/api/accounts/{id}/opportunities/{opportunityId}", async (int id, int opportunityId, CrmDbContext db) => {
    var parent = await db.Accounts.FindAsync(id);
    if (parent == null)
    {
        return Results.NotFound();
    }
    await db.Entry(parent).Collection(e => e.Opportunities).LoadAsync();
    var child = await db.Opportunitys.FindAsync(opportunityId);
    if (child == null || !parent.Opportunities.Any(e => e == child))
    {
        return Results.NotFound();
    }
    return Results.Ok(child);
});

