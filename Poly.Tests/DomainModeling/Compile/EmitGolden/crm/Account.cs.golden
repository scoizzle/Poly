#nullable enable
using System;
using System.Collections.Generic;

using Poly.Runtime;

public enum AccountStage
{
    Open = 0,
    Archived = 1
}

public class Account
{
    private List<Contact> _contacts = new List<Contact>();
    private List<Opportunity> _opportunities = new List<Opportunity>();
    private List<Ticket> _tickets = new List<Ticket>();
    private Account() { }
    private Account(string name, Industry industry, Account? parent = null, Site? hq = null, IEnumerable<Contact>? contacts = null, IEnumerable<Opportunity>? opportunities = null, IEnumerable<Ticket>? tickets = null, long wonCount = 0L, decimal openPipeline = 0m, long closedTickets = 0L)
    {
        this.Name = name;
        this.Industry = industry;
        this.WonCount = wonCount;
        this.OpenPipeline = openPipeline;
        this.ClosedTickets = closedTickets;
        this.Parent = parent;
        this.Hq = hq;
        this._contacts = new List<Contact>(contacts ?? new List<Contact>());
        this._opportunities = new List<Opportunity>(opportunities ?? new List<Opportunity>());
        this._tickets = new List<Ticket>(tickets ?? new List<Ticket>());
        this.CurrentStage = AccountStage.Open;
        this.InitializeSubscriptions();
    }
    public string Name { get; private set; } = default!;
    public Industry Industry { get; private set; }
    public long WonCount { get; private set; }
    public decimal OpenPipeline { get; private set; }
    public long ClosedTickets { get; private set; }
    public Account? Parent { get; private set; }
    public Site? Hq { get; private set; }
    public IReadOnlyList<Contact> Contacts
    {
        get => this._contacts;
    }
    public IReadOnlyList<Opportunity> Opportunities
    {
        get => this._opportunities;
    }
    public IReadOnlyList<Ticket> Tickets
    {
        get => this._tickets;
    }
    public AccountStage CurrentStage { get; private set; }
    public DomainResult<Site> CreateHq(string city, string region)
    {
        var siteResult = Site.Create(city, region);
        if (!siteResult.IsSuccess)
        {
            return DomainResult<Site>.Failure(siteResult.Error!);
        }
        var site = siteResult.Value;
        this.Hq = site;
        return DomainResult<Site>.Success(site);
    }
    public DomainResult<Contact> CreateContacts(string name, string email, Poly.Runtime.IStoragePort db)
    {
        var contactResult = Contact.Create(name, email, db, this);
        if (!contactResult.IsSuccess)
        {
            return DomainResult<Contact>.Failure(contactResult.Error!);
        }
        var contact = contactResult.Value;
        return DomainResult<Contact>.Success(contact);
    }
    internal void AttachContacts(Contact child)
    {
        this._contacts.Add(child);
    }
    public DomainResult<Opportunity> CreateOpportunities(string title, decimal amount, Contact? contact = null, DateOnly? closeBy = null)
    {
        var opportunityResult = Opportunity.Create(title, amount, this, contact, new List<Activity>(), new List<Line>(), new List<Quote>(), closeBy);
        if (!opportunityResult.IsSuccess)
        {
            return DomainResult<Opportunity>.Failure(opportunityResult.Error!);
        }
        var opportunity = opportunityResult.Value;
        return DomainResult<Opportunity>.Success(opportunity);
    }
    internal void AttachOpportunities(Opportunity child)
    {
        this._opportunities.Add(child);
        child.RegisterAccountOpportunitiesWonSubscriber(this);
        child.RegisterAccountOpportunitiesProposeSubscriber(this);
        child.RegisterAccountOpportunitiesLostSubscriber(this);
    }
    public DomainResult<Ticket> CreateTickets(string subject)
    {
        var ticketResult = Ticket.Create(subject, this);
        if (!ticketResult.IsSuccess)
        {
            return DomainResult<Ticket>.Failure(ticketResult.Error!);
        }
        var ticket = ticketResult.Value;
        return DomainResult<Ticket>.Success(ticket);
    }
    internal void AttachTickets(Ticket child)
    {
        this._tickets.Add(child);
        child.RegisterAccountTicketsClosedSubscriber(this);
    }
    public DomainResult<Site> PlaceHq(string city, string region)
    {
        if (this.CurrentStage != AccountStage.Open)
        {
            return DomainResult<Site>.Failure(Poly.Runtime.DomainFailure.Stage("'PlaceHq' requires stage 'Open' on entity 'Account'.", "Account.PlaceHq", "Open"));
        }
        if (this.Hq != null)
        {
            return DomainResult<Site>.Failure(Poly.Runtime.DomainFailure.Link("Cannot add a second link on 'hq': the source already has a target.", "Account.hq"));
        }
        var create0 = this.CreateHq(city, region);
        if (!create0.IsSuccess)
        {
            return DomainResult<Site>.Failure(create0.Error!.At("Account.PlaceHq"));
        }
        var created1 = create0.Value;
        return DomainResult<Site>.Success(created1);
    }
    public DomainResult<Contact> AddContact(string name, string email, Poly.Runtime.IStoragePort db)
    {
        if (this.CurrentStage != AccountStage.Open)
        {
            return DomainResult<Contact>.Failure(Poly.Runtime.DomainFailure.Stage("'AddContact' requires stage 'Open' on entity 'Account'.", "Account.AddContact", "Open"));
        }
        var create0 = this.CreateContacts(name, email, db);
        if (!create0.IsSuccess)
        {
            return DomainResult<Contact>.Failure(create0.Error!.At("Account.AddContact"));
        }
        var created1 = create0.Value;
        return DomainResult<Contact>.Success(created1);
    }
    public DomainResult<Contact> ConvertLead(Lead lead, Poly.Runtime.IStoragePort db)
    {
        if (this.CurrentStage != AccountStage.Open)
        {
            return DomainResult<Contact>.Failure(Poly.Runtime.DomainFailure.Stage("'ConvertLead' requires stage 'Open' on entity 'Account'.", "Account.ConvertLead", "Open"));
        }
        var create0 = this.CreateContacts(lead.Name, lead.Email, db);
        if (!create0.IsSuccess)
        {
            return DomainResult<Contact>.Failure(create0.Error!.At("Account.ConvertLead"));
        }
        var created1 = create0.Value;
        return DomainResult<Contact>.Success(created1);
    }
    public DomainResult<Opportunity> OpenDeal(string title, long amount)
    {
        if (this.CurrentStage != AccountStage.Open)
        {
            return DomainResult<Opportunity>.Failure(Poly.Runtime.DomainFailure.Stage("'OpenDeal' requires stage 'Open' on entity 'Account'.", "Account.OpenDeal", "Open"));
        }
        var create0 = this.CreateOpportunities(title, amount);
        if (!create0.IsSuccess)
        {
            return DomainResult<Opportunity>.Failure(create0.Error!.At("Account.OpenDeal"));
        }
        var created1 = create0.Value;
        return DomainResult<Opportunity>.Success(created1);
    }
    public DomainResult Archive()
    {
        if (this.CurrentStage != AccountStage.Open)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'Archive' requires stage 'Open' on entity 'Account'.", "Account.Archive", "Open"));
        }
        this.CurrentStage = AccountStage.Archived;
        return DomainResult.Success();
    }
    public DomainResult<Ticket> OpenTicket(string subject)
    {
        if (this.CurrentStage != AccountStage.Open)
        {
            return DomainResult<Ticket>.Failure(Poly.Runtime.DomainFailure.Stage("'OpenTicket' requires stage 'Open' on entity 'Account'.", "Account.OpenTicket", "Open"));
        }
        var create0 = this.CreateTickets(subject);
        if (!create0.IsSuccess)
        {
            return DomainResult<Ticket>.Failure(create0.Error!.At("Account.OpenTicket"));
        }
        var created1 = create0.Value;
        return DomainResult<Ticket>.Success(created1);
    }
    public DomainResult Restore()
    {
        if (this.CurrentStage != AccountStage.Archived)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'Restore' requires stage 'Archived' on entity 'Account'.", "Account.Restore", "Archived"));
        }
        this.CurrentStage = AccountStage.Open;
        return DomainResult.Success();
    }
    public bool HasHq() => this.Hq != null;
    public bool IsUrban() => this.Hq != null && this.Hq!.City == "Metropolis";
    internal void WhenEachOpportunityWon()
    {
        this.WonCount = this.WonCount + 1L;
    }
    internal void WhenEachOpportunityPropose(Opportunity deal)
    {
        this.OpenPipeline = this.OpenPipeline + deal.Amount;
    }
    internal void WhenEachOpportunityWon(Opportunity deal)
    {
        this.OpenPipeline = this.OpenPipeline - deal.Amount;
    }
    internal void WhenEachOpportunityLost(Opportunity deal)
    {
        this.OpenPipeline = this.OpenPipeline - deal.Amount;
    }
    internal void WhenEachTicketClosed()
    {
        this.ClosedTickets = this.ClosedTickets + 1L;
    }
    public static DomainResult<Account> Create(string name, Industry industry, Account? parent = null, Site? hq = null, IEnumerable<Contact>? contacts = null, IEnumerable<Opportunity>? opportunities = null, IEnumerable<Ticket>? tickets = null, long wonCount = 0L, decimal openPipeline = 0m, long closedTickets = 0L)
    {
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Account>.Failure(Poly.Runtime.DomainFailure.Required("'Name' is required.", "Account.Name"));
        }
        if ((object)industry == null)
        {
            return DomainResult<Account>.Failure(Poly.Runtime.DomainFailure.Required("'Industry' is required.", "Account.Industry"));
        }
        if (industry != Industry.Technology && industry != Industry.Healthcare && industry != Industry.Finance && industry != Industry.Other)
        {
            return DomainResult<Account>.Failure(Poly.Runtime.DomainFailure.Enum(string.Concat("'", industry, "' is not a valid member of Industry for property 'Industry'."), "Account.Industry"));
        }
        var created = new Account(name, industry, parent, hq, contacts, opportunities, tickets, wonCount, openPipeline, closedTickets);
        return DomainResult<Account>.Success(created);
    }
    private void InitializeSubscriptions()
    {
        foreach (var target in this.Opportunities)
        {
            target.RegisterAccountOpportunitiesWonSubscriber(this);
        }
        foreach (var target in this.Opportunities)
        {
            target.RegisterAccountOpportunitiesProposeSubscriber(this);
        }
        foreach (var target in this.Opportunities)
        {
            target.RegisterAccountOpportunitiesLostSubscriber(this);
        }
        foreach (var target in this.Tickets)
        {
            target.RegisterAccountTicketsClosedSubscriber(this);
        }
    }
}