#nullable enable
using System;
using System.Collections.Generic;

public enum ActivityStage
{
    Open = 0,
    Done = 1
}

public class Activity
{
    private Activity()
    { }
    private Activity(string subject, Opportunity? opportunity = null, DateOnly? dueOn = null)
    {
        this.DueOn = dueOn ?? DateOnly.FromDateTime(DateTime.Today);
        this.Subject = subject;
        this.Opportunity = opportunity;
        this.CurrentStage = ActivityStage.Open;
    }
    public DateOnly DueOn { get; private set; }
    public string Subject { get; private set; } = default!;
    public Opportunity? Opportunity { get; private set; }
    public ActivityStage CurrentStage { get; private set; }
    public DomainResult Snooze()
    {
        if (this.CurrentStage != ActivityStage.Open)
        {
            return DomainResult.Failure("'Snooze' requires stage 'Open' on entity 'Activity'.");
        }
        this.DueOn = this.DueOn.AddDays((int)7L);
        return DomainResult.Success();
    }
    public DomainResult Complete()
    {
        if (this.CurrentStage != ActivityStage.Open)
        {
            return DomainResult.Failure("'Complete' requires stage 'Open' on entity 'Activity'.");
        }
        this.CurrentStage = ActivityStage.Done;
        return DomainResult.Success();
    }
    public static DomainResult<Activity> Create(string subject, Opportunity? opportunity = null, DateOnly? dueOn = null)
    {
        if (string.IsNullOrEmpty(subject))
        {
            return DomainResult<Activity>.Failure("'Subject' is required.");
        }
        var created = new Activity(subject, opportunity, dueOn);
        if (opportunity != null)
        {
            opportunity.AttachActivities(created);
        }
        return DomainResult<Activity>.Success(created);
    }
}