#nullable enable
using System;
using System.Collections.Generic;

public enum CampaignStage
{
    Active = 0,
    Ended = 1
}

public class Campaign
{
    private List<CampaignMember> _members;
    private Campaign()
    {
        this._members = new List<CampaignMember>();
    }
    private Campaign(string name, IEnumerable<CampaignMember>? members = null)
    {
        this.Name = name;
        this._members = new List<CampaignMember>(members ?? new List<CampaignMember>());
        this.CurrentStage = CampaignStage.Active;
    }
    public string Name { get; private set; } = default!;
    public IReadOnlyList<CampaignMember> Members
    {
        get => this._members;
    }
    public CampaignStage CurrentStage { get; private set; }
    private DomainResult<CampaignMember> CreateMembers(Contact? contact = null)
    {
        var campaignMemberResult = CampaignMember.Create(contact, this);
        if (!campaignMemberResult.IsSuccess)
        {
            return DomainResult<CampaignMember>.Failure(campaignMemberResult.ErrorMessage ?? "");
        }
        var campaignMember = campaignMemberResult.Value;
        return DomainResult<CampaignMember>.Success(campaignMember);
    }
    internal void AttachMembers(CampaignMember child)
    {
        this._members.Add(child);
    }
    public DomainResult<CampaignMember> Enroll(Contact who)
    {
        if (this.CurrentStage != CampaignStage.Active)
        {
            return DomainResult<CampaignMember>.Failure("'Enroll' requires stage 'Active' on entity 'Campaign'.");
        }
        var create0 = this.CreateMembers(who);
        if (!create0.IsSuccess)
        {
            return DomainResult<CampaignMember>.Failure(create0.ErrorMessage ?? "");
        }
        var created1 = create0.Value;
        return DomainResult<CampaignMember>.Success(created1);
    }
    public DomainResult End()
    {
        if (this.CurrentStage != CampaignStage.Active)
        {
            return DomainResult.Failure("'End' requires stage 'Active' on entity 'Campaign'.");
        }
        this.CurrentStage = CampaignStage.Ended;
        return DomainResult.Success();
    }
    public static DomainResult<Campaign> Create(string name, IEnumerable<CampaignMember>? members = null)
    {
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Campaign>.Failure("'Name' is required.");
        }
        var created = new Campaign(name, members);
        return DomainResult<Campaign>.Success(created);
    }
}