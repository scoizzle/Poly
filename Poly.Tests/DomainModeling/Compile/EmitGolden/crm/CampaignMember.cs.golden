#nullable enable
using Poly.Runtime;

public class CampaignMember : Poly.Runtime.IActionScoped
{
    private CampaignMember() { }
    private CampaignMember(Contact? contact = null, Campaign? campaign = null)
    {
        this.Contact = contact;
        this.Campaign = campaign;
    }
    public Contact? Contact { get; private set; }
    public Campaign? Campaign { get; private set; }
    public static DomainResult<CampaignMember> Create(Contact? contact = null, Campaign? campaign = null)
    {
        var created = new CampaignMember(contact, campaign);
        if (campaign != null)
        {
            campaign.AttachMembers(created);
        }
        return DomainResult<CampaignMember>.Success(created);
    }
    public object __Snapshot()
    {
        var __state = new object?[2];
        __state[0] = this.Contact;
        __state[1] = this.Campaign;
        return __state;
    }
    public void __Restore(object state)
    {
        var __saved = (object?[])state;
        this.Contact = (Contact?)__saved[0]!;
        this.Campaign = (Campaign?)__saved[1]!;
    }
}