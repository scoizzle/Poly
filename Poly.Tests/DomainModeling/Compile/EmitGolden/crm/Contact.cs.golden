#nullable enable
public enum ContactStage
{
    Active = 0,
    Inactive = 1
}

public class Contact
{
    private Contact(string email, string name, Account? account = null)
    {
        this.Email = email;
        this.Name = name;
        this.Account = account;
        this.CurrentStage = ContactStage.Active;
    }
    public string Email { get; private set; } = default!;
    public string Name { get; private set; } = default!;
    public Account? Account { get; private set; }
    public ContactStage CurrentStage { get; private set; }
    public DomainResult Retire()
    {
        if (this.CurrentStage != ContactStage.Active)
        {
            return DomainResult.Failure("'Retire' requires stage 'Active' on entity 'Contact'.");
        }
        this.CurrentStage = ContactStage.Inactive;
        return DomainResult.Success();
    }
    public DomainResult Reactivate()
    {
        if (this.CurrentStage != ContactStage.Inactive)
        {
            return DomainResult.Failure("'Reactivate' requires stage 'Inactive' on entity 'Contact'.");
        }
        this.CurrentStage = ContactStage.Active;
        return DomainResult.Success();
    }
    public static DomainResult<Contact> Create(string email, string name, Account? account = null)
    {
        if (string.IsNullOrEmpty(email))
        {
            return DomainResult<Contact>.Failure("'Email' is required.");
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(email, "^[^@]+@[^@]+$"))
        {
            return DomainResult<Contact>.Failure("'Email' does not match the required pattern.");
        }
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Contact>.Failure("'Name' is required.");
        }
        var created = new Contact(email, name, account);
        var uniqueCheck = Contact.CheckUnique("Email", email);
        if (!uniqueCheck.IsSuccess)
        {
            return DomainResult<Contact>.Failure(uniqueCheck.ErrorMessage ?? "");
        }
        Poly.DomainModeling.Runtime.DomainInstanceStore.PrintedRecord("Contact", "Email", email);
        if (account != null)
        {
            account.AttachContacts(created);
        }
        return DomainResult<Contact>.Success(created);
    }
    private static DomainResult CheckUnique(string propertyName, object value)
    {
        if (value == null)
        {
            return DomainResult.Success();
        }
        var message = Poly.DomainModeling.Runtime.DomainInstanceStore.PrintedCollision("Contact", propertyName, value.ToString());
        if (message != null)
        {
            return DomainResult.Failure(message);
        }
        return DomainResult.Success();
    }
    public DomainResult EnsureUnique(string propertyName, object value)
    {
        if (value == null)
        {
            return DomainResult.Success();
        }
        if (propertyName == "Email" && object.Equals(this.Email, value))
        {
            return DomainResult.Success();
        }
        return Contact.CheckUnique(propertyName, value);
    }
}