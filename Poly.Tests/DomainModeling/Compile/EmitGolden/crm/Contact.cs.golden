#nullable enable
using Poly.Runtime;

public enum ContactStage
{
    Active = 0,
    Inactive = 1
}

public class Contact : Poly.Runtime.IActionScoped
{
    private Contact() { }
    private Contact(string name, string email, Account? account = null)
    {
        this.Name = name;
        this.Email = email;
        this.Account = account;
        this.CurrentStage = ContactStage.Active;
    }
    public string Name { get; private set; } = default!;
    public string Email { get; private set; } = default!;
    public Account? Account { get; private set; }
    public ContactStage CurrentStage { get; private set; }
    public DomainResult Retire()
    {
        if (this.CurrentStage != ContactStage.Active)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'Retire' requires stage 'Active' on entity 'Contact'.", "Contact.Retire", "Active"));
        }
        this.CurrentStage = ContactStage.Inactive;
        return DomainResult.Success();
    }
    public DomainResult Reactivate()
    {
        if (this.CurrentStage != ContactStage.Inactive)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'Reactivate' requires stage 'Inactive' on entity 'Contact'.", "Contact.Reactivate", "Inactive"));
        }
        this.CurrentStage = ContactStage.Active;
        return DomainResult.Success();
    }
    public static DomainResult<Contact> Create(string name, string email, Poly.Runtime.IStoragePort db, Account? account = null)
    {
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Contact>.Failure(Poly.Runtime.DomainFailure.Required("'Name' is required.", "Contact.Name"));
        }
        if (string.IsNullOrEmpty(email))
        {
            return DomainResult<Contact>.Failure(Poly.Runtime.DomainFailure.Required("'Email' is required.", "Contact.Email"));
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(email, "^[^@]+@[^@]+\\z"))
        {
            return DomainResult<Contact>.Failure(Poly.Runtime.DomainFailure.Pattern("'Email' does not match the required pattern.", "Contact.Email"));
        }
        if (Contact.ExistsWithEmail(db, email))
        {
            return DomainResult<Contact>.Failure(Poly.Runtime.DomainFailure.Unique("Unique constraint violated: 'Email' value is already used on another 'Contact'.", "Contact.Email"));
        }
        var created = new Contact(name, email, account);
        if (account != null)
        {
            account.AttachContacts(created);
        }
        db.Record("Contact", "Email", email);
        return DomainResult<Contact>.Success(created);
    }
    public DomainResult EnsureUnique(string propertyName, object value)
    {
        if (value == null)
        {
            return DomainResult.Success();
        }
        if (propertyName == "Email" && object.Equals(this.Email, value))
        {
            return DomainResult.Success();
        }
        return DomainResult.Failure(Poly.Runtime.DomainFailure.Constraint("A unique assign needs the storage port.", "Contact"));
    }
    public object __Snapshot()
    {
        var __state = new object?[4];
        __state[0] = this.Name;
        __state[1] = this.Email;
        __state[2] = this.Account;
        __state[3] = this.CurrentStage;
        return __state;
    }
    public void __Restore(object state)
    {
        var __saved = (object?[])state;
        this.Name = (string)__saved[0]!;
        this.Email = (string)__saved[1]!;
        this.Account = (Account?)__saved[2]!;
        this.CurrentStage = (ContactStage)__saved[3]!;
    }
    public static System.Boolean ExistsWithEmail(Poly.Runtime.IStoragePort db, System.String email) => db.Exists("Contact", "Email", email);
}