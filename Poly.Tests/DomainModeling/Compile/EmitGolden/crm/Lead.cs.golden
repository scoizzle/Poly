#nullable enable
using Poly.Runtime;

public enum LeadStage
{
    New = 0,
    Converted = 1,
    Dead = 2
}

public class Lead
{
    private Lead() { }
    private Lead(string name, string email, string company, Account? account = null)
    {
        this.Name = name;
        this.Email = email;
        this.Company = company;
        this.Account = account;
        this.CurrentStage = LeadStage.New;
    }
    public string Name { get; private set; } = default!;
    public string Email { get; private set; } = default!;
    public string Company { get; private set; } = default!;
    public Account? Account { get; private set; }
    public LeadStage CurrentStage { get; private set; }
    public DomainResult Convert()
    {
        if (this.CurrentStage != LeadStage.New)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'Convert' requires stage 'New' on entity 'Lead'.", "Lead.Convert", "New"));
        }
        if (!this.HasAccount())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'Convert' blocked by policy 'HasAccount'.", "Lead.Convert", "HasAccount"));
        }
        this.CurrentStage = LeadStage.Converted;
        return DomainResult.Success();
    }
    public DomainResult Disqualify()
    {
        if (this.CurrentStage != LeadStage.New)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'Disqualify' requires stage 'New' on entity 'Lead'.", "Lead.Disqualify", "New"));
        }
        this.CurrentStage = LeadStage.Dead;
        return DomainResult.Success();
    }
    public bool HasAccount() => this.Account != null;
    public static DomainResult<Lead> Create(string name, string email, string company, Poly.Runtime.IStoragePort db, Account? account = null)
    {
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Lead>.Failure(Poly.Runtime.DomainFailure.Required("'Name' is required.", "Lead.Name"));
        }
        if (string.IsNullOrEmpty(email))
        {
            return DomainResult<Lead>.Failure(Poly.Runtime.DomainFailure.Required("'Email' is required.", "Lead.Email"));
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(email, "^[^@]+@[^@]+\\z"))
        {
            return DomainResult<Lead>.Failure(Poly.Runtime.DomainFailure.Pattern("'Email' does not match the required pattern.", "Lead.Email"));
        }
        if (string.IsNullOrEmpty(company))
        {
            return DomainResult<Lead>.Failure(Poly.Runtime.DomainFailure.Required("'Company' is required.", "Lead.Company"));
        }
        if (Lead.ExistsWithEmail(db, email))
        {
            return DomainResult<Lead>.Failure(Poly.Runtime.DomainFailure.Unique("Unique constraint violated: 'Email' value is already used on another 'Lead'.", "Lead.Email"));
        }
        var created = new Lead(name, email, company, account);
        db.Record("Lead", "Email", email);
        return DomainResult<Lead>.Success(created);
    }
    public DomainResult EnsureUnique(string propertyName, object value)
    {
        if (value == null)
        {
            return DomainResult.Success();
        }
        if (propertyName == "Email" && object.Equals(this.Email, value))
        {
            return DomainResult.Success();
        }
        return DomainResult.Failure(Poly.Runtime.DomainFailure.Constraint("A unique assign needs the storage port.", "Lead"));
    }
    public static System.Boolean ExistsWithEmail(Poly.Runtime.IStoragePort db, System.String email) => db.Exists("Lead", "Email", email);
}