#nullable enable
using System;
using System.Collections.Generic;

public enum LeadStage
{
    New = 0,
    Converted = 1,
    Dead = 2
}

public class Lead
{
    private Lead()
    { }
    private Lead(string company, string email, string name, Account? account = null)
    {
        this.Company = company;
        this.Email = email;
        this.Name = name;
        this.Account = account;
        this.CurrentStage = LeadStage.New;
    }
    public string Company { get; private set; } = default!;
    public string Email { get; private set; } = default!;
    public string Name { get; private set; } = default!;
    public Account? Account { get; private set; }
    public LeadStage CurrentStage { get; private set; }
    private DomainResult<Account> CreateAccount(Industry industry, string name, Site? hq = null, long closedTickets = 0L, long openPipeline = 0L, long wonCount = 0L)
    {
        var accountResult = Account.Create(industry, name, (Account?)null, hq, new List<Contact>(), new List<Opportunity>(), new List<Ticket>(), closedTickets, openPipeline, wonCount);
        if (!accountResult.IsSuccess)
        {
            return DomainResult<Account>.Failure(accountResult.ErrorMessage ?? "");
        }
        var account = accountResult.Value;
        this.Account = account;
        return DomainResult<Account>.Success(account);
    }
    public DomainResult Convert()
    {
        if (this.CurrentStage != LeadStage.New)
        {
            return DomainResult.Failure("'Convert' requires stage 'New' on entity 'Lead'.");
        }
        if (!this.HasAccount())
        {
            return DomainResult.Failure("'Convert' blocked by policy 'HasAccount'.");
        }
        this.CurrentStage = LeadStage.Converted;
        return DomainResult.Success();
    }
    public DomainResult Disqualify()
    {
        if (this.CurrentStage != LeadStage.New)
        {
            return DomainResult.Failure("'Disqualify' requires stage 'New' on entity 'Lead'.");
        }
        this.CurrentStage = LeadStage.Dead;
        return DomainResult.Success();
    }
    public bool HasAccount() => this.Account != null;
    public static DomainResult<Lead> Create(string company, string email, string name, Account? account = null)
    {
        if (string.IsNullOrEmpty(company))
        {
            return DomainResult<Lead>.Failure("'Company' is required.");
        }
        if (string.IsNullOrEmpty(email))
        {
            return DomainResult<Lead>.Failure("'Email' is required.");
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(email, "^[^@]+@[^@]+$"))
        {
            return DomainResult<Lead>.Failure("'Email' does not match the required pattern.");
        }
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Lead>.Failure("'Name' is required.");
        }
        var created = new Lead(company, email, name, account);
        return DomainResult<Lead>.Success(created);
    }
    public DomainResult EnsureUnique(string propertyName, object value) => DomainResult.Success();
}