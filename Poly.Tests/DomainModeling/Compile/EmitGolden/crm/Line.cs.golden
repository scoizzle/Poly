#nullable enable
using System;
using System.Collections.Generic;

public class Line
{
    private Line()
    { }
    private Line(long qty, long unitPrice, Product? product = null, Opportunity? opportunity = null)
    {
        this.Qty = qty;
        this.UnitPrice = unitPrice;
        this.Product = product;
        this.Opportunity = opportunity;
    }
    public long Qty { get; private set; }
    public long UnitPrice { get; private set; }
    public Product? Product { get; private set; }
    public Opportunity? Opportunity { get; private set; }
    private DomainResult<Product> CreateProduct(long listPrice, string name, string sku)
    {
        var productResult = Product.Create(listPrice, name, sku);
        if (!productResult.IsSuccess)
        {
            return DomainResult<Product>.Failure(productResult.ErrorMessage ?? "");
        }
        var product = productResult.Value;
        this.Product = product;
        return DomainResult<Product>.Success(product);
    }
    private DomainResult<Opportunity> CreateOpportunity(long amount, string title, Account? account = null, Contact? contact = null, DateOnly? closeBy = null)
    {
        var opportunityResult = Opportunity.Create(amount, title, account, contact, new List<Activity>(), new List<Line>(), new List<Quote>(), closeBy);
        if (!opportunityResult.IsSuccess)
        {
            return DomainResult<Opportunity>.Failure(opportunityResult.ErrorMessage ?? "");
        }
        var opportunity = opportunityResult.Value;
        this.Opportunity = opportunity;
        return DomainResult<Opportunity>.Success(opportunity);
    }
    public static DomainResult<Line> Create(long qty, long unitPrice, Product? product = null, Opportunity? opportunity = null)
    {
        if (qty < 1L)
        {
            return DomainResult<Line>.Failure("'Qty' must be >= 1.");
        }
        if (qty > 10000L)
        {
            return DomainResult<Line>.Failure("'Qty' must be <= 10000.");
        }
        if (unitPrice < 0L)
        {
            return DomainResult<Line>.Failure("'UnitPrice' must be >= 0.");
        }
        if (unitPrice > 100000000L)
        {
            return DomainResult<Line>.Failure("'UnitPrice' must be <= 100000000.");
        }
        var created = new Line(qty, unitPrice, product, opportunity);
        if (opportunity != null)
        {
            opportunity.AttachLines(created);
        }
        return DomainResult<Line>.Success(created);
    }
}