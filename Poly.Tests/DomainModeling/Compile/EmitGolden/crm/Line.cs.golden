#nullable enable
using Poly.Runtime;

public class Line
{
    private Line() { }
    private Line(long qty, decimal unitPrice, Product? product = null, Opportunity? opportunity = null)
    {
        this.Qty = qty;
        this.UnitPrice = unitPrice;
        this.Product = product;
        this.Opportunity = opportunity;
    }
    public long Qty { get; private set; }
    public decimal UnitPrice { get; private set; }
    public Product? Product { get; private set; }
    public Opportunity? Opportunity { get; private set; }
    public static DomainResult<Line> Create(long qty, decimal unitPrice, Product? product = null, Opportunity? opportunity = null)
    {
        if (qty < 1L)
        {
            return DomainResult<Line>.Failure(Poly.Runtime.DomainFailure.Range("'Qty' must be >= 1.", "Line.Qty"));
        }
        if (qty > 10000L)
        {
            return DomainResult<Line>.Failure(Poly.Runtime.DomainFailure.Range("'Qty' must be <= 10000.", "Line.Qty"));
        }
        if (unitPrice < 0m)
        {
            return DomainResult<Line>.Failure(Poly.Runtime.DomainFailure.Range("'UnitPrice' must be >= 0.", "Line.UnitPrice"));
        }
        if (unitPrice > 100000000m)
        {
            return DomainResult<Line>.Failure(Poly.Runtime.DomainFailure.Range("'UnitPrice' must be <= 100000000.", "Line.UnitPrice"));
        }
        var created = new Line(qty, unitPrice, product, opportunity);
        if (opportunity != null)
        {
            opportunity.AttachLines(created);
        }
        return DomainResult<Line>.Success(created);
    }
}