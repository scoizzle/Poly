    internal void RegisterAccountWonSubscriber(Account subscriber)
    {
        if (this._accountWonSubscribers == null)
        {
            this._accountWonSubscribers = new List<Account>();
        }
        this._accountWonSubscribers.Add(subscriber);
    }
    internal void RegisterAccountProposeSubscriber(Account subscriber)
    {
        if (this._accountProposeSubscribers == null)
        {
            this._accountProposeSubscribers = new List<Account>();
        }
        this._accountProposeSubscribers.Add(subscriber);
    }
    internal void RegisterAccountLostSubscriber(Account subscriber)
    {
        if (this._accountLostSubscribers == null)
        {
            this._accountLostSubscribers = new List<Account>();
        }
        this._accountLostSubscribers.Add(subscriber);
    }
    internal void NotifyWonSubscribers(OpportunityStage previousStage)
    {
        if (this._accountWonSubscribers != null)
        {
            foreach (var sub in this._accountWonSubscribers)
            {
                sub.WhenEachOpportunityWon();
                sub.WhenEachOpportunityWon(this);
            }
        }
    }
    internal void NotifyProposeSubscribers(OpportunityStage previousStage)
    {
        if (this._accountProposeSubscribers != null)
        {
            foreach (var sub in this._accountProposeSubscribers)
            {
                sub.WhenEachOpportunityPropose(this);
            }
        }
    }
    internal void NotifyLostSubscribers(OpportunityStage previousStage)
    {
        if (this._accountLostSubscribers != null)
        {
            foreach (var sub in this._accountLostSubscribers)
            {
                sub.WhenEachOpportunityLost(this);
            }
        }
    }
    public static DomainResult<Opportunity> Create(long amount, string title, Account? account = null, Contact? contact = null, IEnumerable<Activity>? activities = null, IEnumerable<Line>? lines = null, IEnumerable<Quote>? quotes = null, DateOnly? closeBy = null)
    {
        if (amount < 0L)
        {
            return DomainResult<Opportunity>.Failure("'Amount' must be >= 0.");
        }
        if (amount > 100000000L)
        {
            return DomainResult<Opportunity>.Failure("'Amount' must be <= 100000000.");
        }
        if (string.IsNullOrEmpty(title))
        {
            return DomainResult<Opportunity>.Failure("'Title' is required.");
        }
        var created = new Opportunity(amount, title, account, contact, activities, lines, quotes, closeBy);
        if (account != null)
        {
            account.AttachOpportunities(created);
        }
        return DomainResult<Opportunity>.Success(created);
    }
