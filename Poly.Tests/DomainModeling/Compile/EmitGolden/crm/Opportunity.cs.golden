    public static DomainResult<Opportunity> Create(string title, decimal amount, Account? account = null, Contact? contact = null, IEnumerable<Activity>? activities = null, IEnumerable<Line>? lines = null, IEnumerable<Quote>? quotes = null, DateOnly? closeBy = null)
    {
        if (string.IsNullOrEmpty(title))
        {
            return DomainResult<Opportunity>.Failure(Poly.Runtime.DomainFailure.Required("'Title' is required.", "Opportunity.Title"));
        }
        if (amount < 0m)
        {
            return DomainResult<Opportunity>.Failure(Poly.Runtime.DomainFailure.Range("'Amount' must be >= 0.", "Opportunity.Amount"));
        }
        if (amount > 100000000m)
        {
            return DomainResult<Opportunity>.Failure(Poly.Runtime.DomainFailure.Range("'Amount' must be <= 100000000.", "Opportunity.Amount"));
        }
        var created = new Opportunity(title, amount, account, contact, activities, lines, quotes, closeBy);
        if (account != null)
        {
            account.AttachOpportunities(created);
        }
        return DomainResult<Opportunity>.Success(created);
    }
