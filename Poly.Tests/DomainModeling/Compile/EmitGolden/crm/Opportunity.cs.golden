#nullable enable
using System;
using System.Collections.Generic;

public enum OpportunityStage
{
    Qualify = 0,
    Propose = 1,
    Commit = 2,
    Won = 3,
    Lost = 4
}

public class Opportunity
{
    private List<Activity> _activities = new List<Activity>();
    private List<Line> _lines = new List<Line>();
    private List<Quote> _quotes = new List<Quote>();
    private List<Account>? _accountOpportunitiesWonSubscribers;
    private List<Account>? _accountOpportunitiesProposeSubscribers;
    private List<Account>? _accountOpportunitiesLostSubscribers;
    private int _notifyDepth;
    private Opportunity(decimal amount, string title, Account? account = null, Contact? contact = null, IEnumerable<Activity>? activities = null, IEnumerable<Line>? lines = null, IEnumerable<Quote>? quotes = null, DateOnly? closeBy = null)
    {
        this.Amount = amount;
        this.Title = title;
        this.CloseBy = closeBy ?? DateOnly.FromDateTime(DateTime.UtcNow);
        this.Account = account;
        this.Contact = contact;
        this._activities = new List<Activity>(activities ?? new List<Activity>());
        this._lines = new List<Line>(lines ?? new List<Line>());
        this._quotes = new List<Quote>(quotes ?? new List<Quote>());
        this.CurrentStage = OpportunityStage.Qualify;
        this.Probability = 10L;
    }
    public decimal Amount { get; private set; }
    public DateOnly CloseBy { get; private set; }
    public long Probability { get; private set; }
    public string Title { get; private set; } = default!;
    public Account? Account { get; private set; }
    public Contact? Contact { get; private set; }
    public IReadOnlyList<Activity> Activities
    {
        get => this._activities;
    }
    public IReadOnlyList<Line> Lines
    {
        get => this._lines;
    }
    public IReadOnlyList<Quote> Quotes
    {
        get => this._quotes;
    }
    public OpportunityStage CurrentStage { get; private set; }
    public DomainResult<Activity> CreateActivities(string subject, DateOnly? dueOn = null)
    {
        var activityResult = Activity.Create(subject, this, dueOn);
        if (!activityResult.IsSuccess)
        {
            return DomainResult<Activity>.Failure(activityResult.ErrorMessage ?? "");
        }
        var activity = activityResult.Value;
        return DomainResult<Activity>.Success(activity);
    }
    internal void AttachActivities(Activity child)
    {
        this._activities.Add(child);
    }
    public DomainResult<Line> CreateLines(long qty, decimal unitPrice, Product? product = null)
    {
        var lineResult = Line.Create(qty, unitPrice, product, this);
        if (!lineResult.IsSuccess)
        {
            return DomainResult<Line>.Failure(lineResult.ErrorMessage ?? "");
        }
        var line = lineResult.Value;
        return DomainResult<Line>.Success(line);
    }
    internal void AttachLines(Line child)
    {
        this._lines.Add(child);
    }
    public DomainResult<Quote> CreateQuotes(decimal amount, string title)
    {
        var quoteResult = Quote.Create(amount, title, this, new List<QuoteLine>());
        if (!quoteResult.IsSuccess)
        {
            return DomainResult<Quote>.Failure(quoteResult.ErrorMessage ?? "");
        }
        var quote = quoteResult.Value;
        return DomainResult<Quote>.Success(quote);
    }
    internal void AttachQuotes(Quote child)
    {
        this._quotes.Add(child);
    }
    public DomainResult CompleteOpenWork()
    {
        foreach (var target0 in this.Activities)
        {
            if (target0.CurrentStage != ActivityStage.Open)
            {
                continue;
            }
            var result1 = target0.Complete();
            if (!result1.IsSuccess)
            {
                return DomainResult.Failure(result1.ErrorMessage ?? "");
            }
        }
        return DomainResult.Success();
    }
    public DomainResult Propose()
    {
        if (this.CurrentStage != OpportunityStage.Qualify)
        {
            return DomainResult.Failure("'Propose' requires stage 'Qualify' on entity 'Opportunity'.");
        }
        if (!this.HasAccount())
        {
            return DomainResult.Failure("'Propose' blocked by policy 'HasAccount'.");
        }
        this.CurrentStage = OpportunityStage.Propose;
        this.Probability = 40L;
        this.NotifyProposeSubscribers();
        return DomainResult.Success();
    }
    public DomainResult Lose()
    {
        if (this.CurrentStage == OpportunityStage.Qualify || this.CurrentStage == OpportunityStage.Propose || this.CurrentStage == OpportunityStage.Commit)
        {
            this.CurrentStage = OpportunityStage.Lost;
            this.Probability = 0L;
            this.NotifyLostSubscribers();
            return DomainResult.Success();
        }
        return DomainResult.Failure("'Lose' is not valid for the current stage on entity 'Opportunity'.");
    }
    public DomainResult<Activity> Log(string subject)
    {
        if (this.CurrentStage == OpportunityStage.Qualify || this.CurrentStage == OpportunityStage.Propose || this.CurrentStage == OpportunityStage.Commit)
        {
            var create0 = this.CreateActivities(subject);
            if (!create0.IsSuccess)
            {
                return DomainResult<Activity>.Failure(create0.ErrorMessage ?? "");
            }
            var created1 = create0.Value;
            return DomainResult<Activity>.Success(created1);
        }
        return DomainResult<Activity>.Failure("'Log' is not valid for the current stage on entity 'Opportunity'.");
    }
    public DomainResult<Line> AddLine(Product sku, long qty)
    {
        if (this.CurrentStage == OpportunityStage.Qualify || this.CurrentStage == OpportunityStage.Propose || this.CurrentStage == OpportunityStage.Commit)
        {
            var assignValue0 = this.Amount + qty * sku.ListPrice;
            if (assignValue0 < 0m)
            {
                return DomainResult<Line>.Failure("'Amount' must be >= 0.");
            }
            if (assignValue0 > 100000000m)
            {
                return DomainResult<Line>.Failure("'Amount' must be <= 100000000.");
            }
            this.Amount = assignValue0;
            var create1 = this.CreateLines(qty, sku.ListPrice, sku);
            if (!create1.IsSuccess)
            {
                return DomainResult<Line>.Failure(create1.ErrorMessage ?? "");
            }
            var created2 = create1.Value;
            return DomainResult<Line>.Success(created2);
        }
        return DomainResult<Line>.Failure("'AddLine' is not valid for the current stage on entity 'Opportunity'.");
    }
    public DomainResult<Quote> QuoteDeal()
    {
        if (this.CurrentStage != OpportunityStage.Qualify)
        {
            return DomainResult<Quote>.Failure("'QuoteDeal' requires stage 'Qualify' on entity 'Opportunity'.");
        }
        var create0 = this.CreateQuotes(0L, this.Title);
        if (!create0.IsSuccess)
        {
            return DomainResult<Quote>.Failure(create0.ErrorMessage ?? "");
        }
        var created1 = create0.Value;
        return DomainResult<Quote>.Success(created1);
    }
    public DomainResult Commit()
    {
        if (this.CurrentStage != OpportunityStage.Propose)
        {
            return DomainResult.Failure("'Commit' requires stage 'Propose' on entity 'Opportunity'.");
        }
        if (!this.HasLines())
        {
            return DomainResult.Failure("'Commit' blocked by policy 'HasLines'.");
        }
        this.CurrentStage = OpportunityStage.Commit;
        this.Probability = 80L;
        return DomainResult.Success();
    }
    public DomainResult Win()
    {
        if (this.CurrentStage != OpportunityStage.Commit)
        {
            return DomainResult.Failure("'Win' requires stage 'Commit' on entity 'Opportunity'.");
        }
        this.CurrentStage = OpportunityStage.Won;
        this.Probability = 100L;
        this.NotifyWonSubscribers();
        return DomainResult.Success();
    }
    public DomainResult Capture(ChargeRequest request)
    {
        if (this.CurrentStage != OpportunityStage.Commit)
        {
            return DomainResult.Failure("'Capture' requires stage 'Commit' on entity 'Opportunity'.");
        }
        var adapterResult = BillingAdapters.Charge(request);
        if (!adapterResult.IsSuccess)
        {
            return adapterResult;
        }
        var assignValue0 = this.Amount;
        if (assignValue0 < 0m)
        {
            return DomainResult.Failure("'Amount' must be >= 0.");
        }
        if (assignValue0 > 100000000m)
        {
            return DomainResult.Failure("'Amount' must be <= 100000000.");
        }
        this.Amount = assignValue0;
        return DomainResult.Success();
    }
    public bool HasAccount() => this.Account != null;
    public bool HasLines() => this.Lines.Count > 0;
    internal void RegisterAccountOpportunitiesWonSubscriber(Account subscriber)
    {
        if (this._accountOpportunitiesWonSubscribers == null)
        {
            this._accountOpportunitiesWonSubscribers = new List<Account>();
        }
        foreach (var existing in this._accountOpportunitiesWonSubscribers)
        {
            if (object.ReferenceEquals(existing, subscriber))
            {
                return;
            }
        }
        this._accountOpportunitiesWonSubscribers.Add(subscriber);
    }
    internal void RegisterAccountOpportunitiesProposeSubscriber(Account subscriber)
    {
        if (this._accountOpportunitiesProposeSubscribers == null)
        {
            this._accountOpportunitiesProposeSubscribers = new List<Account>();
        }
        foreach (var existing in this._accountOpportunitiesProposeSubscribers)
        {
            if (object.ReferenceEquals(existing, subscriber))
            {
                return;
            }
        }
        this._accountOpportunitiesProposeSubscribers.Add(subscriber);
    }
    internal void RegisterAccountOpportunitiesLostSubscriber(Account subscriber)
    {
        if (this._accountOpportunitiesLostSubscribers == null)
        {
            this._accountOpportunitiesLostSubscribers = new List<Account>();
        }
        foreach (var existing in this._accountOpportunitiesLostSubscribers)
        {
            if (object.ReferenceEquals(existing, subscriber))
            {
                return;
            }
        }
        this._accountOpportunitiesLostSubscribers.Add(subscriber);
    }
    internal void NotifyWonSubscribers()
    {
        this.EnterNotifyCascade("Won");
        try
        {
            if (this._accountOpportunitiesWonSubscribers != null)
            {
                foreach (var sub in this._accountOpportunitiesWonSubscribers)
                {
                    sub.WhenEachOpportunityWon();
                    sub.WhenEachOpportunityWon(this);
                }
            }
        }
        finally
        {
            this.ExitNotifyCascade();
        }
    }
    internal void NotifyProposeSubscribers()
    {
        this.EnterNotifyCascade("Propose");
        try
        {
            if (this._accountOpportunitiesProposeSubscribers != null)
            {
                foreach (var sub in this._accountOpportunitiesProposeSubscribers)
                {
                    sub.WhenEachOpportunityPropose(this);
                }
            }
        }
        finally
        {
            this.ExitNotifyCascade();
        }
    }
    internal void NotifyLostSubscribers()
    {
        this.EnterNotifyCascade("Lost");
        try
        {
            if (this._accountOpportunitiesLostSubscribers != null)
            {
                foreach (var sub in this._accountOpportunitiesLostSubscribers)
                {
                    sub.WhenEachOpportunityLost(this);
                }
            }
        }
        finally
        {
            this.ExitNotifyCascade();
        }
    }
    public static DomainResult<Opportunity> Create(decimal amount, string title, Account? account = null, Contact? contact = null, IEnumerable<Activity>? activities = null, IEnumerable<Line>? lines = null, IEnumerable<Quote>? quotes = null, DateOnly? closeBy = null)
    {
        if (amount < 0m)
        {
            return DomainResult<Opportunity>.Failure("'Amount' must be >= 0.");
        }
        if (amount > 100000000m)
        {
            return DomainResult<Opportunity>.Failure("'Amount' must be <= 100000000.");
        }
        if (string.IsNullOrEmpty(title))
        {
            return DomainResult<Opportunity>.Failure("'Title' is required.");
        }
        var created = new Opportunity(amount, title, account, contact, activities, lines, quotes, closeBy);
        if (account != null)
        {
            account.AttachOpportunities(created);
        }
        return DomainResult<Opportunity>.Success(created);
    }
    private void EnterNotifyCascade(string stageName)
    {
        if (this._notifyDepth >= 16)
        {
            throw new System.InvalidOperationException(string.Concat("Subscription cascade on entity 'Opportunity' exceeded max depth (16) while notifying '", stageName, "'."));
        }
        this._notifyDepth = this._notifyDepth + 1;
    }
    private void ExitNotifyCascade()
    {
        this._notifyDepth = this._notifyDepth - 1;
    }
}