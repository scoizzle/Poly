#nullable enable
public class Product
{
    private Product(decimal listPrice, string name, string sku)
    {
        this.ListPrice = listPrice;
        this.Name = name;
        this.Sku = sku;
    }
    public decimal ListPrice { get; private set; }
    public string Name { get; private set; } = default!;
    public string Sku { get; private set; } = default!;
    public static DomainResult<Product> Create(decimal listPrice, string name, string sku)
    {
        if (listPrice < 0m)
        {
            return DomainResult<Product>.Failure("'ListPrice' must be >= 0.");
        }
        if (listPrice > 100000000m)
        {
            return DomainResult<Product>.Failure("'ListPrice' must be <= 100000000.");
        }
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Product>.Failure("'Name' is required.");
        }
        if (string.IsNullOrEmpty(sku))
        {
            return DomainResult<Product>.Failure("'Sku' is required.");
        }
        if (sku.Length < 3L)
        {
            return DomainResult<Product>.Failure("'Sku' must be at least 3 characters.");
        }
        if (sku.Length > 32L)
        {
            return DomainResult<Product>.Failure("'Sku' must be at most 32 characters.");
        }
        var created = new Product(listPrice, name, sku);
        var uniqueCheck = Product.CheckUnique("Sku", sku);
        if (!uniqueCheck.IsSuccess)
        {
            return DomainResult<Product>.Failure(uniqueCheck.ErrorMessage ?? "");
        }
        Poly.DomainModeling.Runtime.DomainInstanceStore.PrintedRecord("Product", "Sku", sku);
        return DomainResult<Product>.Success(created);
    }
    private static DomainResult CheckUnique(string propertyName, object value)
    {
        if (value == null)
        {
            return DomainResult.Success();
        }
        var message = Poly.DomainModeling.Runtime.DomainInstanceStore.PrintedCollision("Product", propertyName, value.ToString());
        if (message != null)
        {
            return DomainResult.Failure(message);
        }
        return DomainResult.Success();
    }
    public DomainResult EnsureUnique(string propertyName, object value)
    {
        if (value == null)
        {
            return DomainResult.Success();
        }
        if (propertyName == "Sku" && object.Equals(this.Sku, value))
        {
            return DomainResult.Success();
        }
        return Product.CheckUnique(propertyName, value);
    }
}