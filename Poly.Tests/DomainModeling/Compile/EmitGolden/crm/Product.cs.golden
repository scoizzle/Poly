#nullable enable
public class Product
{
    private Product()
    { }
    private Product(long listPrice, string name, string sku)
    {
        this.ListPrice = listPrice;
        this.Name = name;
        this.Sku = sku;
    }
    public long ListPrice { get; private set; }
    public string Name { get; private set; } = default!;
    public string Sku { get; private set; } = default!;
    public static DomainResult<Product> Create(long listPrice, string name, string sku)
    {
        if (listPrice < 0L)
        {
            return DomainResult<Product>.Failure("'ListPrice' must be >= 0.");
        }
        if (listPrice > 100000000L)
        {
            return DomainResult<Product>.Failure("'ListPrice' must be <= 100000000.");
        }
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Product>.Failure("'Name' is required.");
        }
        if (string.IsNullOrEmpty(sku))
        {
            return DomainResult<Product>.Failure("'Sku' is required.");
        }
        if (sku.Length < 3L)
        {
            return DomainResult<Product>.Failure("'Sku' must be at least 3 characters.");
        }
        if (sku.Length > 32L)
        {
            return DomainResult<Product>.Failure("'Sku' must be at most 32 characters.");
        }
        var created = new Product(listPrice, name, sku);
        return DomainResult<Product>.Success(created);
    }
    public DomainResult EnsureUnique(string propertyName, object value) => DomainResult.Success();
}