#nullable enable
using System.Collections.Generic;

using Poly.Runtime;

public enum QuoteStage
{
    Draft = 0,
    Presented = 1,
    Accepted = 2,
    Rejected = 3
}

public class Quote
{
    private List<QuoteLine> _lines = new List<QuoteLine>();
    private Quote() { }
    private Quote(string title, decimal amount, Opportunity? opportunity = null, IEnumerable<QuoteLine>? lines = null)
    {
        this.Title = title;
        this.Amount = amount;
        this.Opportunity = opportunity;
        this._lines = new List<QuoteLine>(lines ?? new List<QuoteLine>());
        this.CurrentStage = QuoteStage.Draft;
    }
    public string Title { get; private set; } = default!;
    public decimal Amount { get; private set; }
    public Opportunity? Opportunity { get; private set; }
    public IReadOnlyList<QuoteLine> Lines
    {
        get => this._lines;
    }
    public QuoteStage CurrentStage { get; private set; }
    public DomainResult<QuoteLine> CreateLines(long qty, decimal unitPrice, Product? product = null)
    {
        var quoteLineResult = QuoteLine.Create(qty, unitPrice, product, this);
        if (!quoteLineResult.IsSuccess)
        {
            return DomainResult<QuoteLine>.Failure(quoteLineResult.ErrorMessage ?? "");
        }
        var quoteLine = quoteLineResult.Value;
        return DomainResult<QuoteLine>.Success(quoteLine);
    }
    internal void AttachLines(QuoteLine child)
    {
        this._lines.Add(child);
    }
    public DomainResult<QuoteLine> AddLine(Product sku, long qty)
    {
        if (this.CurrentStage != QuoteStage.Draft)
        {
            return DomainResult<QuoteLine>.Failure("'AddLine' requires stage 'Draft' on entity 'Quote'.");
        }
        var assignValue0 = this.Amount + qty * sku.ListPrice;
        if (assignValue0 < 0m)
        {
            return DomainResult<QuoteLine>.Failure(Poly.Runtime.DomainFailure.Range("'Amount' must be >= 0.", "Quote.Amount"));
        }
        if (assignValue0 > 100000000m)
        {
            return DomainResult<QuoteLine>.Failure(Poly.Runtime.DomainFailure.Range("'Amount' must be <= 100000000.", "Quote.Amount"));
        }
        this.Amount = assignValue0;
        var create1 = this.CreateLines(qty, sku.ListPrice, sku);
        if (!create1.IsSuccess)
        {
            return DomainResult<QuoteLine>.Failure(create1.ErrorMessage ?? "");
        }
        var created2 = create1.Value;
        return DomainResult<QuoteLine>.Success(created2);
    }
    public DomainResult Present()
    {
        if (this.CurrentStage != QuoteStage.Draft)
        {
            return DomainResult.Failure("'Present' requires stage 'Draft' on entity 'Quote'.");
        }
        this.CurrentStage = QuoteStage.Presented;
        return DomainResult.Success();
    }
    public DomainResult Accept()
    {
        if (this.CurrentStage != QuoteStage.Presented)
        {
            return DomainResult.Failure("'Accept' requires stage 'Presented' on entity 'Quote'.");
        }
        this.CurrentStage = QuoteStage.Accepted;
        return DomainResult.Success();
    }
    public DomainResult Reject()
    {
        if (this.CurrentStage != QuoteStage.Presented)
        {
            return DomainResult.Failure("'Reject' requires stage 'Presented' on entity 'Quote'.");
        }
        this.CurrentStage = QuoteStage.Rejected;
        return DomainResult.Success();
    }
    public static DomainResult<Quote> Create(string title, decimal amount, Opportunity? opportunity = null, IEnumerable<QuoteLine>? lines = null)
    {
        if (string.IsNullOrEmpty(title))
        {
            return DomainResult<Quote>.Failure(Poly.Runtime.DomainFailure.Required("'Title' is required.", "Quote.Title"));
        }
        if (amount < 0m)
        {
            return DomainResult<Quote>.Failure(Poly.Runtime.DomainFailure.Range("'Amount' must be >= 0.", "Quote.Amount"));
        }
        if (amount > 100000000m)
        {
            return DomainResult<Quote>.Failure(Poly.Runtime.DomainFailure.Range("'Amount' must be <= 100000000.", "Quote.Amount"));
        }
        var created = new Quote(title, amount, opportunity, lines);
        if (opportunity != null)
        {
            opportunity.AttachQuotes(created);
        }
        return DomainResult<Quote>.Success(created);
    }
}