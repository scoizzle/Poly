#nullable enable
using System;
using System.Collections.Generic;

public class QuoteLine
{
    private QuoteLine()
    { }
    private QuoteLine(long qty, long unitPrice, Product? product = null, Quote? quote = null)
    {
        this.Qty = qty;
        this.UnitPrice = unitPrice;
        this.Product = product;
        this.Quote = quote;
    }
    public long Qty { get; private set; }
    public long UnitPrice { get; private set; }
    public Product? Product { get; private set; }
    public Quote? Quote { get; private set; }
    public static DomainResult<QuoteLine> Create(long qty, long unitPrice, Product? product = null, Quote? quote = null)
    {
        if (qty < 1L)
        {
            return DomainResult<QuoteLine>.Failure("'Qty' must be >= 1.");
        }
        if (qty > 10000L)
        {
            return DomainResult<QuoteLine>.Failure("'Qty' must be <= 10000.");
        }
        if (unitPrice < 0L)
        {
            return DomainResult<QuoteLine>.Failure("'UnitPrice' must be >= 0.");
        }
        if (unitPrice > 100000000L)
        {
            return DomainResult<QuoteLine>.Failure("'UnitPrice' must be <= 100000000.");
        }
        var created = new QuoteLine(qty, unitPrice, product, quote);
        if (quote != null)
        {
            quote.AttachLines(created);
        }
        return DomainResult<QuoteLine>.Success(created);
    }
}