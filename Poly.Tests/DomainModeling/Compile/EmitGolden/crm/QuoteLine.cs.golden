#nullable enable
using Poly.Runtime;

public class QuoteLine
{
    private QuoteLine() { }
    private QuoteLine(long qty, decimal unitPrice, Product? product = null, Quote? quote = null)
    {
        this.Qty = qty;
        this.UnitPrice = unitPrice;
        this.Product = product;
        this.Quote = quote;
    }
    public long Qty { get; private set; }
    public decimal UnitPrice { get; private set; }
    public Product? Product { get; private set; }
    public Quote? Quote { get; private set; }
    public static DomainResult<QuoteLine> Create(long qty, decimal unitPrice, Product? product = null, Quote? quote = null)
    {
        if (qty < 1L)
        {
            return DomainResult<QuoteLine>.Failure(Poly.Runtime.DomainFailure.Range("'Qty' must be >= 1.", "QuoteLine.Qty"));
        }
        if (qty > 10000L)
        {
            return DomainResult<QuoteLine>.Failure(Poly.Runtime.DomainFailure.Range("'Qty' must be <= 10000.", "QuoteLine.Qty"));
        }
        if (unitPrice < 0m)
        {
            return DomainResult<QuoteLine>.Failure(Poly.Runtime.DomainFailure.Range("'UnitPrice' must be >= 0.", "QuoteLine.UnitPrice"));
        }
        if (unitPrice > 100000000m)
        {
            return DomainResult<QuoteLine>.Failure(Poly.Runtime.DomainFailure.Range("'UnitPrice' must be <= 100000000.", "QuoteLine.UnitPrice"));
        }
        var created = new QuoteLine(qty, unitPrice, product, quote);
        if (quote != null)
        {
            quote.AttachLines(created);
        }
        return DomainResult<QuoteLine>.Success(created);
    }
}