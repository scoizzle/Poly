#nullable enable
using System;
using System.Collections.Generic;

public class Site
{
    private Site()
    { }
    private Site(string city, string region)
    {
        this.City = city;
        this.Region = region;
    }
    public string City { get; private set; } = default!;
    public string Region { get; private set; } = default!;
    public static DomainResult<Site> Create(string city, string region)
    {
        if (string.IsNullOrEmpty(city))
        {
            return DomainResult<Site>.Failure("'City' is required.");
        }
        if (string.IsNullOrEmpty(region))
        {
            return DomainResult<Site>.Failure("'Region' is required.");
        }
        var created = new Site(city, region);
        return DomainResult<Site>.Success(created);
    }
}