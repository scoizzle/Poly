#nullable enable
using Poly.Runtime;

public class Site : Poly.Runtime.IActionScoped
{
    private Site() { }
    private Site(string city, string region)
    {
        this.City = city;
        this.Region = region;
    }
    public string City { get; private set; } = default!;
    public string Region { get; private set; } = default!;
    public static DomainResult<Site> Create(string city, string region)
    {
        if (string.IsNullOrEmpty(city))
        {
            return DomainResult<Site>.Failure(Poly.Runtime.DomainFailure.Required("'City' is required.", "Site.City"));
        }
        if (string.IsNullOrEmpty(region))
        {
            return DomainResult<Site>.Failure(Poly.Runtime.DomainFailure.Required("'Region' is required.", "Site.Region"));
        }
        var created = new Site(city, region);
        return DomainResult<Site>.Success(created);
    }
    public object __Snapshot()
    {
        var __state = new object?[2];
        __state[0] = this.City;
        __state[1] = this.Region;
        return __state;
    }
    public void __Restore(object state)
    {
        var __saved = (object?[])state;
        this.City = (string)__saved[0]!;
        this.Region = (string)__saved[1]!;
    }
}