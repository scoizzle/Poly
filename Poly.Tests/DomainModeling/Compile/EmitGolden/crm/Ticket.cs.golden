        var __state = new object?[5];
        __state[0] = this.Subject;
        __state[1] = this.Account;
        __state[2] = this.CurrentStage;
        __state[3] = (this._accountTicketsClosedSubscribers == null ? null : new List<Account>(this._accountTicketsClosedSubscribers));
        __state[4] = this._notifyDepth;
        return __state;
    }
    public void __Restore(object state)
    {
        var __saved = (object?[])state;
        this.Subject = (string)__saved[0]!;
        this.Account = (Account?)__saved[1]!;
        this.CurrentStage = (TicketStage)__saved[2]!;
        if (__saved[3] == null)
