            this._accountTicketsClosedSubscribers = null;
        }
        else
        {
            if (this._accountTicketsClosedSubscribers == null)
            {
                this._accountTicketsClosedSubscribers = new List<Account>();
            }
            ((System.Collections.IList)this._accountTicketsClosedSubscribers).Clear();
            foreach (var __item3 in(List<Account>)__saved[3]!)
            {
                this._accountTicketsClosedSubscribers.Add(__item3);
            }
