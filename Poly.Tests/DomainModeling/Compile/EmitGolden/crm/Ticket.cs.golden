#nullable enable
using System;
using System.Collections.Generic;

public enum TicketStage
{
    New = 0,
    Working = 1,
    Closed = 2
}

public class Ticket
{
    private int _notifyDepth;
    private List<Account>? _accountTicketsClosedSubscribers;
    private Ticket()
    {
        this._notifyDepth = new int();
    }
    private Ticket(string subject, Account? account = null)
    {
        this.Subject = subject;
        this.Account = account;
        this.CurrentStage = TicketStage.New;
    }
    public string Subject { get; private set; } = default!;
    public Account? Account { get; private set; }
    public TicketStage CurrentStage { get; private set; }
    private DomainResult<Account> CreateAccount(Industry industry, string name, Site? hq, long closedTickets = 0L, long openPipeline = 0L, long wonCount = 0L)
    {
        var accountResult = Account.Create(industry, name, (Account?)null, hq, new List<Contact>(), new List<Opportunity>(), new List<Ticket>(), closedTickets, openPipeline, wonCount);
        if (!accountResult.IsSuccess)
        {
            return DomainResult<Account>.Failure(accountResult.ErrorMessage ?? "");
        }
        var account = accountResult.Value;
        this.Account = account;
        return DomainResult<Account>.Success(account);
    }
    public DomainResult Work()
    {
        if (this.CurrentStage != TicketStage.New)
        {
            return DomainResult.Failure("'Work' requires stage 'New' on entity 'Ticket'.");
        }
        this.CurrentStage = TicketStage.Working;
        return DomainResult.Success();
    }
    public DomainResult Close()
    {
        if (this.CurrentStage == TicketStage.New)
        {
            var previousStage0 = this.CurrentStage;
            this.CurrentStage = TicketStage.Closed;
            this.NotifyClosedSubscribers(previousStage0);
            return DomainResult.Success();
        }
        if (this.CurrentStage == TicketStage.Working)
        {
            var previousStage1 = this.CurrentStage;
            this.CurrentStage = TicketStage.Closed;
            this.NotifyClosedSubscribers(previousStage1);
            return DomainResult.Success();
        }
        return DomainResult.Failure("'Close' is not valid for the current stage on entity 'Ticket'.");
    }
    private void EnterNotifyCascade(string stageName)
    {
        if (this._notifyDepth >= 16)
        {
            throw new System.InvalidOperationException(string.Concat("Subscription cascade on entity 'Ticket' exceeded max depth (16) while notifying '", stageName, "'."));
        }
        this._notifyDepth = this._notifyDepth + 1;
    }
    private void ExitNotifyCascade()
    {
        this._notifyDepth = this._notifyDepth - 1;
    }
    internal void RegisterAccountTicketsClosedSubscriber(Account subscriber)
    {
        if (this._accountTicketsClosedSubscribers == null)
        {
            this._accountTicketsClosedSubscribers = new List<Account>();
        }
        this._accountTicketsClosedSubscribers.Add(subscriber);
    }
    internal void NotifyClosedSubscribers(TicketStage previousStage)
    {
        this.EnterNotifyCascade("Closed");
        try
        {
            if (this._accountTicketsClosedSubscribers != null)
            {
                foreach (var sub in this._accountTicketsClosedSubscribers)
                {
                    sub.WhenEachTicketClosed();
                }
            }
        }
        finally
        {
            this.ExitNotifyCascade();
        }
    }
    public static DomainResult<Ticket> Create(string subject, Account? account = null)
    {
        if (string.IsNullOrEmpty(subject))
        {
            return DomainResult<Ticket>.Failure("'Subject' is required.");
        }
        var created = new Ticket(subject, account);
        if (account != null)
        {
            account.AttachTickets(created);
        }
        return DomainResult<Ticket>.Success(created);
    }
