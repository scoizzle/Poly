#nullable enable
using System;
using System.Collections.Generic;

public enum EventHoldStage
{
    Requested = 0,
    Confirmed = 1,
    InUse = 2,
    Released = 3,
    Cancelled = 4
}

public class EventHold
{
    private List<Guest>? _guestReleasedSubscribers;
    private EventHold()
    { }
    private EventHold(long capacity, long dayRate, DateOnly endDate, long headcount, DateOnly startDate, Guest? guest = null, Hall? hall = null, Section? section = null)
    {
        this.Capacity = capacity;
        this.DayRate = dayRate;
        this.EndDate = endDate;
        this.Headcount = headcount;
        this.StartDate = startDate;
        this.Guest = guest;
        this.Hall = hall;
        this.Section = section;
        this.CurrentStage = EventHoldStage.Requested;
    }
    public long Capacity { get; private set; }
    public long DayRate { get; private set; }
    public DateOnly EndDate { get; private set; }
    public long Headcount { get; private set; }
    public DateOnly StartDate { get; private set; }
    public Guest? Guest { get; private set; }
    public Hall? Hall { get; private set; }
    public Section? Section { get; private set; }
    public EventHoldStage CurrentStage { get; private set; }
    private DomainResult<Guest> CreateGuest(string email, string name, string phone, long eventCount = 0L, long nightCount = 0L, long stayCount = 0L)
    {
        var guestResult = Guest.Create(email, name, phone, new List<EventHold>(), new List<Reservation>(), eventCount, nightCount, stayCount);
        if (!guestResult.IsSuccess)
        {
            return DomainResult<Guest>.Failure(guestResult.ErrorMessage ?? "");
        }
        var guest = guestResult.Value;
        this.Guest = guest;
        return DomainResult<Guest>.Success(guest);
    }
    private DomainResult<Hall> CreateHall(long capacity, long dayRate, string name, Property? property, long busySections = 0L, bool occupied = false, bool offline = false)
    {
        var hallResult = Hall.Create(capacity, dayRate, name, property, new List<Section>(), busySections, occupied, offline);
        if (!hallResult.IsSuccess)
        {
            return DomainResult<Hall>.Failure(hallResult.ErrorMessage ?? "");
        }
        var hall = hallResult.Value;
        this.Hall = hall;
        return DomainResult<Hall>.Success(hall);
    }
    private DomainResult<Section> CreateSection(long capacity, long dayRate, string name, Hall? hall, bool occupied = false)
    {
        var sectionResult = Section.Create(capacity, dayRate, name, hall, occupied);
        if (!sectionResult.IsSuccess)
        {
            return DomainResult<Section>.Failure(sectionResult.ErrorMessage ?? "");
        }
        var section = sectionResult.Value;
        this.Section = section;
        return DomainResult<Section>.Success(section);
    }
    public DomainResult Confirm()
    {
        if (this.CurrentStage != EventHoldStage.Requested)
        {
            return DomainResult.Failure("'Confirm' requires stage 'Requested' on entity 'EventHold'.");
        }
        if (!this.DatesValid())
        {
            return DomainResult.Failure("'Confirm' blocked by policy 'DatesValid'.");
        }
        if (!this.PartyFits())
        {
            return DomainResult.Failure("'Confirm' blocked by policy 'PartyFits'.");
        }
        if (!this.HasSpace())
        {
            return DomainResult.Failure("'Confirm' blocked by policy 'HasSpace'.");
        }
        this.CurrentStage = EventHoldStage.Confirmed;
        return DomainResult.Success();
    }
    public DomainResult Cancel()
    {
        if (this.CurrentStage == EventHoldStage.Requested)
        {
            this.CurrentStage = EventHoldStage.Cancelled;
            return DomainResult.Success();
        }
        if (this.CurrentStage == EventHoldStage.Confirmed)
        {
            this.CurrentStage = EventHoldStage.Cancelled;
            return DomainResult.Success();
        }
        return DomainResult.Failure("'Cancel' is not valid for the current stage on entity 'EventHold'.");
    }
    public DomainResult StartHall()
    {
        if (this.CurrentStage != EventHoldStage.Confirmed)
        {
            return DomainResult.Failure("'StartHall' requires stage 'Confirmed' on entity 'EventHold'.");
        }
        if (!this.HasHall())
        {
            return DomainResult.Failure("'StartHall' blocked by policy 'HasHall'.");
        }
        if (this.HasSection())
        {
            return DomainResult.Failure("'StartHall' blocked by policy 'HasSection'.");
        }
        if (this.Hall == null)
        {
            return DomainResult.Failure("'Occupy' requires a linked 'hall' on entity 'EventHold'.");
        }
        var invoke0 = this.Hall.Occupy();
        if (!invoke0.IsSuccess)
        {
            return DomainResult.Failure(invoke0.ErrorMessage ?? "");
        }
        this.CurrentStage = EventHoldStage.InUse;
        return DomainResult.Success();
    }
    public DomainResult StartSection()
    {
        if (this.CurrentStage != EventHoldStage.Confirmed)
        {
            return DomainResult.Failure("'StartSection' requires stage 'Confirmed' on entity 'EventHold'.");
        }
        if (!this.HasSection())
        {
            return DomainResult.Failure("'StartSection' blocked by policy 'HasSection'.");
        }
        if (this.Section == null)
        {
            return DomainResult.Failure("'Occupy' requires a linked 'section' on entity 'EventHold'.");
        }
        var invoke0 = this.Section.Occupy();
        if (!invoke0.IsSuccess)
        {
            return DomainResult.Failure(invoke0.ErrorMessage ?? "");
        }
        this.CurrentStage = EventHoldStage.InUse;
        return DomainResult.Success();
    }
    public DomainResult ReleaseHall()
    {
        if (this.CurrentStage != EventHoldStage.InUse)
        {
            return DomainResult.Failure("'ReleaseHall' requires stage 'InUse' on entity 'EventHold'.");
        }
        if (!this.HasHall())
        {
            return DomainResult.Failure("'ReleaseHall' blocked by policy 'HasHall'.");
        }
        if (this.HasSection())
        {
            return DomainResult.Failure("'ReleaseHall' blocked by policy 'HasSection'.");
        }
        if (this.Hall == null)
        {
            return DomainResult.Failure("'Vacate' requires a linked 'hall' on entity 'EventHold'.");
        }
        var invoke0 = this.Hall.Vacate();
        if (!invoke0.IsSuccess)
        {
            return DomainResult.Failure(invoke0.ErrorMessage ?? "");
        }
        var previousStage1 = this.CurrentStage;
        this.CurrentStage = EventHoldStage.Released;
        this.NotifyReleasedSubscribers(previousStage1);
        return DomainResult.Success();
    }
    public DomainResult ReleaseSection()
    {
        if (this.CurrentStage != EventHoldStage.InUse)
        {
            return DomainResult.Failure("'ReleaseSection' requires stage 'InUse' on entity 'EventHold'.");
        }
        if (!this.HasSection())
        {
            return DomainResult.Failure("'ReleaseSection' blocked by policy 'HasSection'.");
        }
        if (this.Section == null)
        {
            return DomainResult.Failure("'Vacate' requires a linked 'section' on entity 'EventHold'.");
        }
        var invoke0 = this.Section.Vacate();
        if (!invoke0.IsSuccess)
        {
            return DomainResult.Failure(invoke0.ErrorMessage ?? "");
        }
        var previousStage1 = this.CurrentStage;
        this.CurrentStage = EventHoldStage.Released;
        this.NotifyReleasedSubscribers(previousStage1);
        return DomainResult.Success();
    }
    public bool DatesValid() => this.EndDate > this.StartDate;
    public bool PartyFits() => this.Headcount <= this.Capacity;
    public bool HasHall() => this.Hall != null;
    public bool HasSection() => this.Section != null;
    public bool HasSpace() => this.Hall != null || this.Section != null;
    internal void RegisterGuestReleasedSubscriber(Guest subscriber)
    {
        if (this._guestReleasedSubscribers == null)
        {
            this._guestReleasedSubscribers = new List<Guest>();
        }
        this._guestReleasedSubscribers.Add(subscriber);
    }
    internal void NotifyReleasedSubscribers(EventHoldStage previousStage)
    {
        if (this._guestReleasedSubscribers != null)
        {
            foreach (var sub in this._guestReleasedSubscribers)
            {
                sub.WhenEachEventHoldReleased();
            }
        }
    }
    public static DomainResult<EventHold> Create(long capacity, long dayRate, DateOnly endDate, long headcount, DateOnly startDate, Guest? guest = null, Hall? hall = null, Section? section = null)
    {
        if (capacity < 1L)
        {
            return DomainResult<EventHold>.Failure("'Capacity' must be >= 1.");
        }
        if (capacity > 5000L)
        {
            return DomainResult<EventHold>.Failure("'Capacity' must be <= 5000.");
        }
        if (dayRate < 0L)
        {
            return DomainResult<EventHold>.Failure("'DayRate' must be >= 0.");
        }
        if (dayRate > 100000L)
        {
            return DomainResult<EventHold>.Failure("'DayRate' must be <= 100000.");
        }
        if (headcount < 1L)
        {
            return DomainResult<EventHold>.Failure("'Headcount' must be >= 1.");
        }
        if (headcount > 5000L)
        {
            return DomainResult<EventHold>.Failure("'Headcount' must be <= 5000.");
        }
        var created = new EventHold(capacity, dayRate, endDate, headcount, startDate, guest, hall, section);
        if (guest != null)
        {
            guest.AttachEvents(created);
        }
        return DomainResult<EventHold>.Success(created);
    }
