#nullable enable
using System;
using System.Collections.Generic;

using Poly.Runtime;

public enum EventHoldStage
{
    Requested = 0,
    Confirmed = 1,
    InUse = 2,
    Released = 3,
    Cancelled = 4
}

public class EventHold
{
    private List<Guest>? _guestEventsReleasedSubscribers;
    private int _notifyDepth;
    private EventHold() { }
    private EventHold(long headcount, long capacity, decimal dayRate, DateOnly startDate, DateOnly endDate, Guest? guest = null, Hall? hall = null, Section? section = null)
    {
        this.Headcount = headcount;
        this.Capacity = capacity;
        this.DayRate = dayRate;
        this.StartDate = startDate;
        this.EndDate = endDate;
        this.Guest = guest;
        this.Hall = hall;
        this.Section = section;
        this.CurrentStage = EventHoldStage.Requested;
    }
    public long Headcount { get; private set; }
    public long Capacity { get; private set; }
    public decimal DayRate { get; private set; }
    public DateOnly StartDate { get; private set; }
    public DateOnly EndDate { get; private set; }
    public Guest? Guest { get; private set; }
    public Hall? Hall { get; private set; }
    public Section? Section { get; private set; }
    public EventHoldStage CurrentStage { get; private set; }
    public DomainResult Confirm()
    {
        if (this.CurrentStage != EventHoldStage.Requested)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'Confirm' requires stage 'Requested' on entity 'EventHold'.", "EventHold.Confirm", "Requested"));
        }
        if (!this.DatesValid())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'Confirm' blocked by policy 'DatesValid'.", "EventHold.Confirm", "DatesValid"));
        }
        if (!this.PartyFits())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'Confirm' blocked by policy 'PartyFits'.", "EventHold.Confirm", "PartyFits"));
        }
        if (!this.HasSpace())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'Confirm' blocked by policy 'HasSpace'.", "EventHold.Confirm", "HasSpace"));
        }
        this.CurrentStage = EventHoldStage.Confirmed;
        return DomainResult.Success();
    }
    public DomainResult Cancel()
    {
        if (this.CurrentStage == EventHoldStage.Requested || this.CurrentStage == EventHoldStage.Confirmed)
        {
            this.CurrentStage = EventHoldStage.Cancelled;
            return DomainResult.Success();
        }
        return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'Cancel' is not valid for the current stage on entity 'EventHold'.", "EventHold.Cancel"));
    }
    public DomainResult StartHall()
    {
        if (this.CurrentStage != EventHoldStage.Confirmed)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'StartHall' requires stage 'Confirmed' on entity 'EventHold'.", "EventHold.StartHall", "Confirmed"));
        }
        if (!this.HasHall())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'StartHall' blocked by policy 'HasHall'.", "EventHold.StartHall", "HasHall"));
        }
        if (this.HasSection())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'StartHall' blocked by policy 'HasSection'.", "EventHold.StartHall", "HasSection"));
        }
        if (this.Hall == null)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Required("'StartHall' requires a linked 'hall' on entity 'EventHold'.", "EventHold.hall"));
        }
        var invoke0 = this.Hall.Occupy();
        if (!invoke0.IsSuccess)
        {
            return DomainResult.Failure(invoke0.Error!.At("EventHold.StartHall"));
        }
        this.CurrentStage = EventHoldStage.InUse;
        return DomainResult.Success();
    }
    public DomainResult StartSection()
    {
        if (this.CurrentStage != EventHoldStage.Confirmed)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'StartSection' requires stage 'Confirmed' on entity 'EventHold'.", "EventHold.StartSection", "Confirmed"));
        }
        if (!this.HasSection())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'StartSection' blocked by policy 'HasSection'.", "EventHold.StartSection", "HasSection"));
        }
        if (this.Section == null)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Required("'StartSection' requires a linked 'section' on entity 'EventHold'.", "EventHold.section"));
        }
        var invoke0 = this.Section.Occupy();
        if (!invoke0.IsSuccess)
        {
            return DomainResult.Failure(invoke0.Error!.At("EventHold.StartSection"));
        }
        this.CurrentStage = EventHoldStage.InUse;
        return DomainResult.Success();
    }
    public DomainResult ReleaseHall()
    {
        if (this.CurrentStage != EventHoldStage.InUse)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'ReleaseHall' requires stage 'InUse' on entity 'EventHold'.", "EventHold.ReleaseHall", "InUse"));
        }
        if (!this.HasHall())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'ReleaseHall' blocked by policy 'HasHall'.", "EventHold.ReleaseHall", "HasHall"));
        }
        if (this.HasSection())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'ReleaseHall' blocked by policy 'HasSection'.", "EventHold.ReleaseHall", "HasSection"));
        }
        if (this.Hall == null)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Required("'ReleaseHall' requires a linked 'hall' on entity 'EventHold'.", "EventHold.hall"));
        }
        var invoke0 = this.Hall.Vacate();
        if (!invoke0.IsSuccess)
        {
            return DomainResult.Failure(invoke0.Error!.At("EventHold.ReleaseHall"));
        }
        this.CurrentStage = EventHoldStage.Released;
        this.NotifyReleasedSubscribers();
        return DomainResult.Success();
    }
    public DomainResult ReleaseSection()
    {
        if (this.CurrentStage != EventHoldStage.InUse)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'ReleaseSection' requires stage 'InUse' on entity 'EventHold'.", "EventHold.ReleaseSection", "InUse"));
        }
        if (!this.HasSection())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'ReleaseSection' blocked by policy 'HasSection'.", "EventHold.ReleaseSection", "HasSection"));
        }
        if (this.Section == null)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Required("'ReleaseSection' requires a linked 'section' on entity 'EventHold'.", "EventHold.section"));
        }
        var invoke0 = this.Section.Vacate();
        if (!invoke0.IsSuccess)
        {
            return DomainResult.Failure(invoke0.Error!.At("EventHold.ReleaseSection"));
        }
        this.CurrentStage = EventHoldStage.Released;
        this.NotifyReleasedSubscribers();
        return DomainResult.Success();
    }
    public bool DatesValid() => this.EndDate > this.StartDate;
    public bool PartyFits() => this.Headcount <= this.Capacity;
    public bool HasHall() => this.Hall != null;
    public bool HasSection() => this.Section != null;
    public bool HasSpace() => this.Hall != null || this.Section != null;
    internal void RegisterGuestEventsReleasedSubscriber(Guest subscriber)
    {
        if (this._guestEventsReleasedSubscribers == null)
        {
            this._guestEventsReleasedSubscribers = new List<Guest>();
        }
        foreach (var existing in this._guestEventsReleasedSubscribers)
        {
            if (object.ReferenceEquals(existing, subscriber))
            {
                return;
            }
        }
        this._guestEventsReleasedSubscribers.Add(subscriber);
    }
    internal void NotifyReleasedSubscribers()
    {
        this.EnterNotifyCascade("Released");
        try
        {
            if (this._guestEventsReleasedSubscribers != null)
            {
                foreach (var sub in this._guestEventsReleasedSubscribers)
                {
                    sub.WhenEachEventHoldReleased();
                }
            }
        }
        finally
        {
            this.ExitNotifyCascade();
        }
    }
    public static DomainResult<EventHold> Create(long headcount, long capacity, decimal dayRate, DateOnly startDate, DateOnly endDate, Guest? guest = null, Hall? hall = null, Section? section = null)
    {
        if (headcount < 1L)
        {
            return DomainResult<EventHold>.Failure(Poly.Runtime.DomainFailure.Range("'Headcount' must be >= 1.", "EventHold.Headcount"));
        }
        if (headcount > 5000L)
        {
            return DomainResult<EventHold>.Failure(Poly.Runtime.DomainFailure.Range("'Headcount' must be <= 5000.", "EventHold.Headcount"));
        }
        if (capacity < 1L)
        {
            return DomainResult<EventHold>.Failure(Poly.Runtime.DomainFailure.Range("'Capacity' must be >= 1.", "EventHold.Capacity"));
        }
        if (capacity > 5000L)
        {
            return DomainResult<EventHold>.Failure(Poly.Runtime.DomainFailure.Range("'Capacity' must be <= 5000.", "EventHold.Capacity"));
        }
        if (dayRate < 0m)
        {
            return DomainResult<EventHold>.Failure(Poly.Runtime.DomainFailure.Range("'DayRate' must be >= 0.", "EventHold.DayRate"));
        }
        if (dayRate > 100000m)
        {
            return DomainResult<EventHold>.Failure(Poly.Runtime.DomainFailure.Range("'DayRate' must be <= 100000.", "EventHold.DayRate"));
        }
        var created = new EventHold(headcount, capacity, dayRate, startDate, endDate, guest, hall, section);
        if (guest != null)
        {
            guest.AttachEvents(created);
        }
        return DomainResult<EventHold>.Success(created);
    }
    private void EnterNotifyCascade(string stageName)
    {
        if (this._notifyDepth >= 16)
        {
            throw new System.InvalidOperationException(string.Concat("Subscription cascade on entity 'EventHold' exceeded max depth (16) while notifying '", stageName, "'."));
        }
        this._notifyDepth = this._notifyDepth + 1;
    }
    private void ExitNotifyCascade()
    {
        this._notifyDepth = this._notifyDepth - 1;
    }
}