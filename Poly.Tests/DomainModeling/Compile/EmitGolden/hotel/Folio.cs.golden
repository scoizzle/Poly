#nullable enable
using Poly.Runtime;

public enum FolioStage
{
    Open = 0,
    Settled = 1
}

public class Folio
{
    private Folio() { }
    private Folio(Reservation? reservation = null, decimal balance = 0m)
    {
        this.Balance = balance;
        this.Reservation = reservation;
        this.CurrentStage = FolioStage.Open;
    }
    public decimal Balance { get; private set; }
    public Reservation? Reservation { get; private set; }
    public FolioStage CurrentStage { get; private set; }
    public DomainResult PostRoomNight(decimal amount)
    {
        if (this.CurrentStage != FolioStage.Open)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'PostRoomNight' requires stage 'Open' on entity 'Folio'.", "Folio.PostRoomNight", "Open"));
        }
        var assignValue0 = this.Balance + amount;
        if (assignValue0 < 0m)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Range("'Balance' must be >= 0.", "Folio.Balance"));
        }
        if (assignValue0 > 1000000m)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Range("'Balance' must be <= 1000000.", "Folio.Balance"));
        }
        this.Balance = assignValue0;
        return DomainResult.Success();
    }
    public DomainResult PostCharge(long amount)
    {
        if (this.CurrentStage != FolioStage.Open)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'PostCharge' requires stage 'Open' on entity 'Folio'.", "Folio.PostCharge", "Open"));
        }
        var assignValue0 = this.Balance + amount;
        if (assignValue0 < 0m)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Range("'Balance' must be >= 0.", "Folio.Balance"));
        }
        if (assignValue0 > 1000000m)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Range("'Balance' must be <= 1000000.", "Folio.Balance"));
        }
        this.Balance = assignValue0;
        return DomainResult.Success();
    }
    public DomainResult Settle()
    {
        if (this.CurrentStage != FolioStage.Open)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'Settle' requires stage 'Open' on entity 'Folio'.", "Folio.Settle", "Open"));
        }
        if (!this.HasBalance())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'Settle' blocked by policy 'HasBalance'.", "Folio.Settle", "HasBalance"));
        }
        this.Balance = 0L;
        this.CurrentStage = FolioStage.Settled;
        return DomainResult.Success();
    }
    public DomainResult CloseEmpty()
    {
        if (this.CurrentStage != FolioStage.Open)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'CloseEmpty' requires stage 'Open' on entity 'Folio'.", "Folio.CloseEmpty", "Open"));
        }
        if (!this.IsSettled())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'CloseEmpty' blocked by policy 'IsSettled'.", "Folio.CloseEmpty", "IsSettled"));
        }
        this.CurrentStage = FolioStage.Settled;
        return DomainResult.Success();
    }
    public bool HasBalance() => this.Balance > 0L;
    public bool IsSettled() => this.Balance == 0L;
    public static DomainResult<Folio> Create(Reservation? reservation = null, decimal balance = 0m)
    {
        if (balance < 0m)
        {
            return DomainResult<Folio>.Failure(Poly.Runtime.DomainFailure.Range("'Balance' must be >= 0.", "Folio.Balance"));
        }
        if (balance > 1000000m)
        {
            return DomainResult<Folio>.Failure(Poly.Runtime.DomainFailure.Range("'Balance' must be <= 1000000.", "Folio.Balance"));
        }
        var created = new Folio(reservation, balance);
        return DomainResult<Folio>.Success(created);
    }
}