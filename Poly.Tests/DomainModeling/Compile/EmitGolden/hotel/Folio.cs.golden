#nullable enable
using System;
using System.Collections.Generic;

public enum FolioStage
{
    Open = 0,
    Settled = 1
}

public class Folio
{
    private Folio()
    { }
    private Folio(Reservation? reservation = null, long balance = 0L)
    {
        this.Balance = balance;
        this.Reservation = reservation;
        this.CurrentStage = FolioStage.Open;
    }
    public long Balance { get; private set; }
    public Reservation? Reservation { get; private set; }
    public FolioStage CurrentStage { get; private set; }
    private DomainResult<Reservation> CreateReservation(DateOnly checkInDate, DateOnly checkOutDate, long maxOccupancy, long nightlyRate, long nights, long partySize, Guest? guest, Room? room)
    {
        var reservationResult = Reservation.Create(checkInDate, checkOutDate, maxOccupancy, nightlyRate, nights, partySize, this, guest, room);
        if (!reservationResult.IsSuccess)
        {
            return DomainResult<Reservation>.Failure(reservationResult.ErrorMessage ?? "");
        }
        var reservation = reservationResult.Value;
        this.Reservation = reservation;
        return DomainResult<Reservation>.Success(reservation);
    }
    public DomainResult PostRoomNight(long amount)
    {
        if (this.CurrentStage != FolioStage.Open)
        {
            return DomainResult.Failure("'PostRoomNight' requires stage 'Open' on entity 'Folio'.");
        }
        var assignValue0 = this.Balance + amount;
        if (assignValue0 < 0L)
        {
            return DomainResult.Failure("'Balance' must be >= 0.");
        }
        if (assignValue0 > 1000000L)
        {
            return DomainResult.Failure("'Balance' must be <= 1000000.");
        }
        this.Balance = assignValue0;
        return DomainResult.Success();
    }
    public DomainResult PostCharge(long amount)
    {
        if (this.CurrentStage != FolioStage.Open)
        {
            return DomainResult.Failure("'PostCharge' requires stage 'Open' on entity 'Folio'.");
        }
        var assignValue0 = this.Balance + amount;
        if (assignValue0 < 0L)
        {
            return DomainResult.Failure("'Balance' must be >= 0.");
        }
        if (assignValue0 > 1000000L)
        {
            return DomainResult.Failure("'Balance' must be <= 1000000.");
        }
        this.Balance = assignValue0;
        return DomainResult.Success();
    }
    public DomainResult Settle()
    {
        if (this.CurrentStage != FolioStage.Open)
        {
            return DomainResult.Failure("'Settle' requires stage 'Open' on entity 'Folio'.");
        }
        if (!this.HasBalance())
        {
            return DomainResult.Failure("'Settle' blocked by policy 'HasBalance'.");
        }
        var assignValue0 = 0L;
        if (assignValue0 < 0L)
        {
            return DomainResult.Failure("'Balance' must be >= 0.");
        }
        if (assignValue0 > 1000000L)
        {
            return DomainResult.Failure("'Balance' must be <= 1000000.");
        }
        this.Balance = assignValue0;
        this.CurrentStage = FolioStage.Settled;
        return DomainResult.Success();
    }
    public DomainResult CloseEmpty()
    {
        if (this.CurrentStage != FolioStage.Open)
        {
            return DomainResult.Failure("'CloseEmpty' requires stage 'Open' on entity 'Folio'.");
        }
        if (!this.IsSettled())
        {
            return DomainResult.Failure("'CloseEmpty' blocked by policy 'IsSettled'.");
        }
        this.CurrentStage = FolioStage.Settled;
        return DomainResult.Success();
    }
    public bool HasBalance() => this.Balance > 0L;
    public bool IsSettled() => this.Balance == 0L;
    public static DomainResult<Folio> Create(Reservation? reservation = null, long balance = 0L)
    {
        if (balance < 0L)
        {
            return DomainResult<Folio>.Failure("'Balance' must be >= 0.");
        }
        if (balance > 1000000L)
        {
            return DomainResult<Folio>.Failure("'Balance' must be <= 1000000.");
        }
        var created = new Folio(reservation, balance);
        return DomainResult<Folio>.Success(created);
    }
