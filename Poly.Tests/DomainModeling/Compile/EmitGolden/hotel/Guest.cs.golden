        if (!reservationResult.IsSuccess)
        {
            return DomainResult<Reservation>.Failure(reservationResult.ErrorMessage ?? "");
        }
        var reservation = reservationResult.Value;
        return DomainResult<Reservation>.Success(reservation);
    }
    internal void AttachReservations(Reservation child)
    {
        this._reservations.Add(child);
        child.RegisterGuestDepartedSubscriber(this);
    }
    public DomainResult<Reservation> BookStay(Room room, long party, long nights, DateOnly arrive, DateOnly depart)
    {
        if (this.CurrentStage != GuestStage.Active)
        {
            return DomainResult<Reservation>.Failure("'BookStay' requires stage 'Active' on entity 'Guest'.");
        }
        var create0 = this.ProbeCreate("Reservation", "room", (object)room, "PartySize", party, "Nights", nights, "NightlyRate", room.NightlyRate, "MaxOccupancy", room.MaxOccupancy, "CheckInDate", arrive, "CheckOutDate", depart);
