    private DomainResult<EventHold> CreateEvents(long capacity, long dayRate, DateOnly endDate, long headcount, DateOnly startDate, Hall? hall, Section? section)
    {
        var eventHoldResult = EventHold.Create(capacity, dayRate, endDate, headcount, startDate, this, hall, section);
        if (!eventHoldResult.IsSuccess)
        {
            return DomainResult<EventHold>.Failure(eventHoldResult.ErrorMessage ?? "");
        }
        var eventHold = eventHoldResult.Value;
        return DomainResult<EventHold>.Success(eventHold);
    }
    internal void AttachEvents(EventHold child)
    {
        this._events.Add(child);
        child.RegisterGuestReleasedSubscriber(this);
    }
    private DomainResult<Reservation> CreateReservations(DateOnly checkInDate, DateOnly checkOutDate, long maxOccupancy, long nightlyRate, long nights, long partySize, Folio? folio, Room? room)
