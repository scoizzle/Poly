    public DomainResult Block()
    {
        if (this.CurrentStage != GuestStage.Active)
        {
            return DomainResult.Failure("'Block' requires stage 'Active' on entity 'Guest'.");
        }
        this.CurrentStage = GuestStage.Blocked;
        return DomainResult.Success();
    }
    public DomainResult Reinstate()
    {
        if (this.CurrentStage != GuestStage.Blocked)
        {
            return DomainResult.Failure("'Reinstate' requires stage 'Blocked' on entity 'Guest'.");
        }
        this.CurrentStage = GuestStage.Active;
        return DomainResult.Success();
