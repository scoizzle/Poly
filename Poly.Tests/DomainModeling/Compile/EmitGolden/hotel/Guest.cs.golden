    public bool HasStays() => this.Reservations.Count > 0L;
    public bool HasEvents() => this.Events.Count > 0L;
    internal void WhenEachReservationDeparted(Reservation stay)
    {
        this.StayCount = this.StayCount + 1L;
        this.NightCount = this.NightCount + stay.Nights;
    }
    internal void WhenEachEventHoldReleased()
    {
        this.EventCount = this.EventCount + 1L;
    }
    public static DomainResult<Guest> Create(string email, string name, string phone, IEnumerable<EventHold>? events = null, IEnumerable<Reservation>? reservations = null, long eventCount = 0L, long nightCount = 0L, long stayCount = 0L)
    {
        if (string.IsNullOrEmpty(email))
        {
            return DomainResult<Guest>.Failure("'Email' is required.");
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(email, "^[^@]+@[^@]+$"))
        {
            return DomainResult<Guest>.Failure("'Email' does not match the required pattern.");
        }
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Guest>.Failure("'Name' is required.");
        }
        if (phone.Length < 7L)
        {
            return DomainResult<Guest>.Failure("'Phone' must be at least 7 characters.");
        }
        if (phone.Length > 20L)
        {
            return DomainResult<Guest>.Failure("'Phone' must be at most 20 characters.");
        }
        var created = new Guest(email, name, phone, events, reservations, eventCount, nightCount, stayCount);
        var uniqueCheck = created.EnsureUnique("Email", email);
        if (!uniqueCheck.IsSuccess)
        {
            return DomainResult<Guest>.Failure(uniqueCheck.ErrorMessage ?? "");
        }
        return DomainResult<Guest>.Success(created);
    }
    private void InitializeSubscriptions()
    {
        foreach (var target in this.Reservations)
        {
            target.RegisterGuestDepartedSubscriber(this);
        }
        foreach (var target in this.Events)
        {
            target.RegisterGuestReleasedSubscriber(this);
        }
    }
