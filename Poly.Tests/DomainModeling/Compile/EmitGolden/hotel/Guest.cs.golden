#nullable enable
using System;
using System.Collections.Generic;

using Poly.Runtime;

public enum GuestStage
{
    Active = 0,
    Blocked = 1
}

public class Guest
{
    private List<EventHold> _events = new List<EventHold>();
    private List<Reservation> _reservations = new List<Reservation>();
    private Guest() { }
    private Guest(string name, string email, string phone, IEnumerable<EventHold>? events = null, IEnumerable<Reservation>? reservations = null, long stayCount = 0L, long nightCount = 0L, long eventCount = 0L)
    {
        this.Name = name;
        this.Email = email;
        this.Phone = phone;
        this.StayCount = stayCount;
        this.NightCount = nightCount;
        this.EventCount = eventCount;
        this._events = new List<EventHold>(events ?? new List<EventHold>());
        this._reservations = new List<Reservation>(reservations ?? new List<Reservation>());
        this.CurrentStage = GuestStage.Active;
        this.InitializeSubscriptions();
    }
    public string Name { get; private set; } = default!;
    public string Email { get; private set; } = default!;
    public string Phone { get; private set; } = default!;
    public long StayCount { get; private set; }
    public long NightCount { get; private set; }
    public long EventCount { get; private set; }
    public IReadOnlyList<EventHold> Events
    {
        get => this._events;
    }
    public IReadOnlyList<Reservation> Reservations
    {
        get => this._reservations;
    }
    public GuestStage CurrentStage { get; private set; }
    public DomainResult<EventHold> CreateEvents(long headcount, long capacity, decimal dayRate, DateOnly startDate, DateOnly endDate, Hall? hall = null, Section? section = null)
    {
        var eventHoldResult = EventHold.Create(headcount, capacity, dayRate, startDate, endDate, this, hall, section);
        if (!eventHoldResult.IsSuccess)
        {
            return DomainResult<EventHold>.Failure(eventHoldResult.ErrorMessage ?? "");
        }
        var eventHold = eventHoldResult.Value;
        return DomainResult<EventHold>.Success(eventHold);
    }
    internal void AttachEvents(EventHold child)
    {
        this._events.Add(child);
        child.RegisterGuestEventsReleasedSubscriber(this);
    }
    public DomainResult<Reservation> CreateReservations(long partySize, long nights, decimal nightlyRate, long maxOccupancy, DateOnly checkInDate, DateOnly checkOutDate, Folio? folio = null, Room? room = null)
    {
        var reservationResult = Reservation.Create(partySize, nights, nightlyRate, maxOccupancy, checkInDate, checkOutDate, folio, this, room);
        if (!reservationResult.IsSuccess)
        {
            return DomainResult<Reservation>.Failure(reservationResult.ErrorMessage ?? "");
        }
        var reservation = reservationResult.Value;
        return DomainResult<Reservation>.Success(reservation);
    }
    internal void AttachReservations(Reservation child)
    {
        this._reservations.Add(child);
        child.RegisterGuestReservationsDepartedSubscriber(this);
    }
    public DomainResult<Reservation> BookStay(Room room, long party, long nights, DateOnly arrive, DateOnly depart)
    {
        if (this.CurrentStage != GuestStage.Active)
        {
            return DomainResult<Reservation>.Failure("'BookStay' requires stage 'Active' on entity 'Guest'.");
        }
        var create0 = this.CreateReservations(party, nights, room.NightlyRate, room.MaxOccupancy, arrive, depart, (Folio?)null, room);
        if (!create0.IsSuccess)
        {
            return DomainResult<Reservation>.Failure(create0.ErrorMessage ?? "");
        }
        var created1 = create0.Value;
        return DomainResult<Reservation>.Success(created1);
    }
    public DomainResult<EventHold> BookHall(Hall hall, long party, DateOnly arrive, DateOnly depart)
    {
        if (this.CurrentStage != GuestStage.Active)
        {
            return DomainResult<EventHold>.Failure("'BookHall' requires stage 'Active' on entity 'Guest'.");
        }
        var create0 = this.CreateEvents(party, hall.Capacity, hall.DayRate, arrive, depart, hall);
        if (!create0.IsSuccess)
        {
            return DomainResult<EventHold>.Failure(create0.ErrorMessage ?? "");
        }
        var created1 = create0.Value;
        return DomainResult<EventHold>.Success(created1);
    }
    public DomainResult<EventHold> BookSection(Section section, Hall hall, long party, DateOnly arrive, DateOnly depart)
    {
        if (this.CurrentStage != GuestStage.Active)
        {
            return DomainResult<EventHold>.Failure("'BookSection' requires stage 'Active' on entity 'Guest'.");
        }
        var create0 = this.CreateEvents(party, section.Capacity, section.DayRate, arrive, depart, hall, section);
        if (!create0.IsSuccess)
        {
            return DomainResult<EventHold>.Failure(create0.ErrorMessage ?? "");
        }
        var created1 = create0.Value;
        return DomainResult<EventHold>.Success(created1);
    }
    public DomainResult Block()
    {
        if (this.CurrentStage != GuestStage.Active)
        {
            return DomainResult.Failure("'Block' requires stage 'Active' on entity 'Guest'.");
        }
        this.CurrentStage = GuestStage.Blocked;
        return DomainResult.Success();
    }
    public DomainResult Reinstate()
    {
        if (this.CurrentStage != GuestStage.Blocked)
        {
            return DomainResult.Failure("'Reinstate' requires stage 'Blocked' on entity 'Guest'.");
        }
        this.CurrentStage = GuestStage.Active;
        return DomainResult.Success();
    }
    public bool HasStays() => this.Reservations.Count > 0;
    public bool HasEvents() => this.Events.Count > 0;
    internal void WhenEachReservationDeparted(Reservation stay)
    {
        this.StayCount = this.StayCount + 1L;
        this.NightCount = this.NightCount + stay.Nights;
    }
    internal void WhenEachEventHoldReleased()
    {
        this.EventCount = this.EventCount + 1L;
    }
    public static DomainResult<Guest> Create(string name, string email, string phone, Poly.Runtime.IStoragePort db, IEnumerable<EventHold>? events = null, IEnumerable<Reservation>? reservations = null, long stayCount = 0L, long nightCount = 0L, long eventCount = 0L)
    {
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Guest>.Failure("'Name' is required.");
        }
        if (string.IsNullOrEmpty(email))
        {
            return DomainResult<Guest>.Failure("'Email' is required.");
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(email, "^[^@]+@[^@]+\\z"))
        {
            return DomainResult<Guest>.Failure("'Email' does not match the required pattern.");
        }
        if (string.IsNullOrEmpty(phone))
        {
            return DomainResult<Guest>.Failure("'Phone' is required.");
        }
        if (phone.Length < 7L)
        {
            return DomainResult<Guest>.Failure("'Phone' must be at least 7 characters.");
        }
        if (phone.Length > 20L)
        {
            return DomainResult<Guest>.Failure("'Phone' must be at most 20 characters.");
        }
        if (Guest.ExistsWithEmail(db, email))
        {
            return DomainResult<Guest>.Failure("Unique constraint violated: 'Email' value is already used on another 'Guest'.");
        }
        var created = new Guest(name, email, phone, events, reservations, stayCount, nightCount, eventCount);
        db.Record("Guest", "Email", email);
        return DomainResult<Guest>.Success(created);
    }
    private void InitializeSubscriptions()
    {
        foreach (var target in this.Reservations)
        {
            target.RegisterGuestReservationsDepartedSubscriber(this);
        }
        foreach (var target in this.Events)
        {
            target.RegisterGuestEventsReleasedSubscriber(this);
        }
    }
    public DomainResult EnsureUnique(string propertyName, object value)
    {
        if (value == null)
        {
            return DomainResult.Success();
        }
        if (propertyName == "Email" && object.Equals(this.Email, value))
        {
            return DomainResult.Success();
        }
        return DomainResult.Failure("A unique assign needs the storage port.");
    }
    public static System.Boolean ExistsWithEmail(Poly.Runtime.IStoragePort db, System.String email) => db.Exists("Guest", "Email", email);
}