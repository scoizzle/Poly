    internal static DomainResult<Hall> Create(string name, long capacity, decimal dayRate, Property? property = null, IEnumerable<Section>? sections = null, bool occupied = false, bool offline = false, long busySections = 0L)
    {
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Hall>.Failure(Poly.Runtime.DomainFailure.Required("'Name' is required.", "Hall.Name"));
        }
        if (name.Length < 1L)
        {
            return DomainResult<Hall>.Failure(Poly.Runtime.DomainFailure.Length("'Name' must be at least 1 characters.", "Hall.Name"));
        }
        if (name.Length > 80L)
        {
            return DomainResult<Hall>.Failure(Poly.Runtime.DomainFailure.Length("'Name' must be at most 80 characters.", "Hall.Name"));
        }
        if (capacity < 1L)
        {
            return DomainResult<Hall>.Failure(Poly.Runtime.DomainFailure.Range("'Capacity' must be >= 1.", "Hall.Capacity"));
        }
        if (capacity > 5000L)
        {
            return DomainResult<Hall>.Failure(Poly.Runtime.DomainFailure.Range("'Capacity' must be <= 5000.", "Hall.Capacity"));
        }
        if (dayRate < 0m)
        {
            return DomainResult<Hall>.Failure(Poly.Runtime.DomainFailure.Range("'DayRate' must be >= 0.", "Hall.DayRate"));
        }
        if (dayRate > 100000m)
        {
            return DomainResult<Hall>.Failure(Poly.Runtime.DomainFailure.Range("'DayRate' must be <= 100000.", "Hall.DayRate"));
        }
        var created = new Hall(name, capacity, dayRate, property, sections, occupied, offline, busySections);
        if (property != null)
        {
            property.AttachHalls(created);
        }
        return DomainResult<Hall>.Success(created);
