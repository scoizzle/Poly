#nullable enable
using System.Collections.Generic;

using Poly.Runtime;

public enum HallStage
{
    InService = 0,
    OutOfService = 1
}

public class Hall
{
    private List<Section> _sections = new List<Section>();
    private Hall() { }
    private Hall(string name, long capacity, decimal dayRate, Property? property = null, IEnumerable<Section>? sections = null, bool occupied = false, bool offline = false, long busySections = 0L)
    {
        this.Name = name;
        this.Capacity = capacity;
        this.DayRate = dayRate;
        this.Occupied = occupied;
        this.Offline = offline;
        this.BusySections = busySections;
        this.Property = property;
        this._sections = new List<Section>(sections ?? new List<Section>());
        this.CurrentStage = HallStage.InService;
    }
    public string Name { get; private set; } = default!;
    public long Capacity { get; private set; }
    public decimal DayRate { get; private set; }
    public bool Occupied { get; private set; }
    public bool Offline { get; private set; }
    public long BusySections { get; private set; }
    public Property? Property { get; private set; }
    public IReadOnlyList<Section> Sections
    {
        get => this._sections;
    }
    public HallStage CurrentStage { get; private set; }
    internal void AttachSections(Section child)
    {
        this._sections.Add(child);
    }
    public DomainResult Occupy()
    {
        if (this.CurrentStage != HallStage.InService)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'Occupy' requires stage 'InService' on entity 'Hall'.", "Hall.Occupy", "InService"));
        }
        if (!this.CanBook())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'Occupy' blocked by policy 'CanBook'.", "Hall.Occupy", "CanBook"));
        }
        this.Occupied = true;
        return DomainResult.Success();
    }
    public DomainResult Vacate()
    {
        if (this.CurrentStage != HallStage.InService)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'Vacate' requires stage 'InService' on entity 'Hall'.", "Hall.Vacate", "InService"));
        }
        if (!this.IsOccupied())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'Vacate' blocked by policy 'IsOccupied'.", "Hall.Vacate", "IsOccupied"));
        }
        this.Occupied = false;
        return DomainResult.Success();
    }
    public DomainResult MarkChildBusy()
    {
        if (this.CurrentStage != HallStage.InService)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'MarkChildBusy' requires stage 'InService' on entity 'Hall'.", "Hall.MarkChildBusy", "InService"));
        }
        this.BusySections = this.BusySections + 1L;
        return DomainResult.Success();
    }
    public DomainResult ClearChildBusy()
    {
        if (this.CurrentStage != HallStage.InService)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'ClearChildBusy' requires stage 'InService' on entity 'Hall'.", "Hall.ClearChildBusy", "InService"));
        }
        this.BusySections = this.BusySections - 1L;
        return DomainResult.Success();
    }
    public DomainResult TakeOffline()
    {
        if (this.CurrentStage != HallStage.InService)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'TakeOffline' requires stage 'InService' on entity 'Hall'.", "Hall.TakeOffline", "InService"));
        }
        if (!this.IsVacant())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'TakeOffline' blocked by policy 'IsVacant'.", "Hall.TakeOffline", "IsVacant"));
        }
        if (!this.ChildrenFree())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'TakeOffline' blocked by policy 'ChildrenFree'.", "Hall.TakeOffline", "ChildrenFree"));
        }
        this.Offline = true;
        this.CurrentStage = HallStage.OutOfService;
        return DomainResult.Success();
    }
    public DomainResult ReturnToService()
    {
        if (this.CurrentStage != HallStage.OutOfService)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'ReturnToService' requires stage 'OutOfService' on entity 'Hall'.", "Hall.ReturnToService", "OutOfService"));
        }
        this.Offline = false;
        this.CurrentStage = HallStage.InService;
        return DomainResult.Success();
    }
    public bool IsVacant() => !this.Occupied;
    public bool ChildrenFree() => this.BusySections == 0L;
    public bool CanBook() => !this.Occupied && !this.Offline && this.BusySections == 0L;
    public bool IsOccupied() => this.Occupied;
    public static DomainResult<Hall> Create(string name, long capacity, decimal dayRate, Property? property = null, IEnumerable<Section>? sections = null, bool occupied = false, bool offline = false, long busySections = 0L)
    {
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Hall>.Failure(Poly.Runtime.DomainFailure.Required("'Name' is required.", "Hall.Name"));
        }
        if (name.Length < 1L)
        {
            return DomainResult<Hall>.Failure(Poly.Runtime.DomainFailure.Length("'Name' must be at least 1 characters.", "Hall.Name"));
        }
        if (name.Length > 80L)
        {
            return DomainResult<Hall>.Failure(Poly.Runtime.DomainFailure.Length("'Name' must be at most 80 characters.", "Hall.Name"));
        }
        if (capacity < 1L)
        {
            return DomainResult<Hall>.Failure(Poly.Runtime.DomainFailure.Range("'Capacity' must be >= 1.", "Hall.Capacity"));
        }
        if (capacity > 5000L)
        {
            return DomainResult<Hall>.Failure(Poly.Runtime.DomainFailure.Range("'Capacity' must be <= 5000.", "Hall.Capacity"));
        }
        if (dayRate < 0m)
        {
            return DomainResult<Hall>.Failure(Poly.Runtime.DomainFailure.Range("'DayRate' must be >= 0.", "Hall.DayRate"));
        }
        if (dayRate > 100000m)
        {
            return DomainResult<Hall>.Failure(Poly.Runtime.DomainFailure.Range("'DayRate' must be <= 100000.", "Hall.DayRate"));
        }
        var created = new Hall(name, capacity, dayRate, property, sections, occupied, offline, busySections);
        if (property != null)
        {
            property.AttachHalls(created);
        }
        return DomainResult<Hall>.Success(created);
    }
}