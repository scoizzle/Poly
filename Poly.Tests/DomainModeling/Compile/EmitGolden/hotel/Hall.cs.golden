#nullable enable
using System;
using System.Collections.Generic;

public enum HallStage
{
    InService = 0,
    OutOfService = 1
}

public class Hall
{
    private List<Section> _sections;
    private Hall()
    {
        this._sections = new List<Section>();
    }
    private Hall(long capacity, decimal dayRate, string name, Property? property = null, IEnumerable<Section>? sections = null, long busySections = 0L, bool occupied = false, bool offline = false)
    {
        this.BusySections = busySections;
        this.Capacity = capacity;
        this.DayRate = dayRate;
        this.Name = name;
        this.Occupied = occupied;
        this.Offline = offline;
        this.Property = property;
        this._sections = new List<Section>(sections ?? new List<Section>());
        this.CurrentStage = HallStage.InService;
    }
    public long BusySections { get; private set; }
    public long Capacity { get; private set; }
    public decimal DayRate { get; private set; }
    public string Name { get; private set; } = default!;
    public bool Occupied { get; private set; }
    public bool Offline { get; private set; }
    public Property? Property { get; private set; }
    public IReadOnlyList<Section> Sections
    {
        get => this._sections;
    }
    public HallStage CurrentStage { get; private set; }
    internal void AttachSections(Section child)
    {
        this._sections.Add(child);
    }
    public DomainResult Occupy()
    {
        if (this.CurrentStage != HallStage.InService)
        {
            return DomainResult.Failure("'Occupy' requires stage 'InService' on entity 'Hall'.");
        }
        if (!this.CanBook())
        {
            return DomainResult.Failure("'Occupy' blocked by policy 'CanBook'.");
        }
        this.Occupied = true;
        return DomainResult.Success();
    }
    public DomainResult Vacate()
    {
        if (this.CurrentStage != HallStage.InService)
        {
            return DomainResult.Failure("'Vacate' requires stage 'InService' on entity 'Hall'.");
        }
        if (!this.IsOccupied())
        {
            return DomainResult.Failure("'Vacate' blocked by policy 'IsOccupied'.");
        }
        this.Occupied = false;
        return DomainResult.Success();
    }
    public DomainResult MarkChildBusy()
    {
        if (this.CurrentStage != HallStage.InService)
        {
            return DomainResult.Failure("'MarkChildBusy' requires stage 'InService' on entity 'Hall'.");
        }
        this.BusySections = this.BusySections + 1L;
        return DomainResult.Success();
    }
    public DomainResult ClearChildBusy()
    {
        if (this.CurrentStage != HallStage.InService)
        {
            return DomainResult.Failure("'ClearChildBusy' requires stage 'InService' on entity 'Hall'.");
        }
        this.BusySections = this.BusySections - 1L;
        return DomainResult.Success();
    }
    public DomainResult TakeOffline()
    {
        if (this.CurrentStage != HallStage.InService)
        {
            return DomainResult.Failure("'TakeOffline' requires stage 'InService' on entity 'Hall'.");
        }
        if (!this.IsVacant())
        {
            return DomainResult.Failure("'TakeOffline' blocked by policy 'IsVacant'.");
        }
        if (!this.ChildrenFree())
        {
            return DomainResult.Failure("'TakeOffline' blocked by policy 'ChildrenFree'.");
        }
        this.Offline = true;
        this.CurrentStage = HallStage.OutOfService;
        return DomainResult.Success();
    }
    public DomainResult ReturnToService()
    {
        if (this.CurrentStage != HallStage.OutOfService)
        {
            return DomainResult.Failure("'ReturnToService' requires stage 'OutOfService' on entity 'Hall'.");
        }
        this.Offline = false;
        this.CurrentStage = HallStage.InService;
        return DomainResult.Success();
    }
    public bool IsVacant() => !this.Occupied;
    public bool ChildrenFree() => this.BusySections == 0L;
    public bool CanBook() => !this.Occupied && !this.Offline && this.BusySections == 0L;
    public bool IsOccupied() => this.Occupied;
    public static DomainResult<Hall> Create(long capacity, decimal dayRate, string name, Property? property = null, IEnumerable<Section>? sections = null, long busySections = 0L, bool occupied = false, bool offline = false)
    {
        if (capacity < 1L)
        {
            return DomainResult<Hall>.Failure("'Capacity' must be >= 1.");
        }
        if (capacity > 5000L)
        {
            return DomainResult<Hall>.Failure("'Capacity' must be <= 5000.");
        }
        if (dayRate < 0m)
        {
            return DomainResult<Hall>.Failure("'DayRate' must be >= 0.");
        }
        if (dayRate > 100000m)
        {
            return DomainResult<Hall>.Failure("'DayRate' must be <= 100000.");
        }
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Hall>.Failure("'Name' is required.");
        }
        if (name.Length < 1L)
        {
            return DomainResult<Hall>.Failure("'Name' must be at least 1 characters.");
        }
        if (name.Length > 80L)
        {
            return DomainResult<Hall>.Failure("'Name' must be at most 80 characters.");
        }
        var created = new Hall(capacity, dayRate, name, property, sections, busySections, occupied, offline);
        if (property != null)
        {
            property.AttachHalls(created);
        }
        return DomainResult<Hall>.Success(created);
    }
}