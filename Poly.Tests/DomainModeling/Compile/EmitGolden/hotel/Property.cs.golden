    {
        var hallResult = Hall.Create(name, capacity, dayRate, this, new List<Section>(), occupied, offline, busySections);
        if (!hallResult.IsSuccess)
        {
            return DomainResult<Hall>.Failure(hallResult.Error!);
        }
        var hall = hallResult.Value;
        return DomainResult<Hall>.Success(hall);
    }
