#nullable enable
using System;
using System.Collections.Generic;

public enum PropertyStage
{
    Open = 0,
    Closed = 1
}

public class Property
{
    private List<Hall> _halls;
    private List<Room> _rooms;
    private Property()
    {
        this._halls = new List<Hall>();
        this._rooms = new List<Room>();
    }
    private Property(string city, string name, IEnumerable<Hall>? halls = null, IEnumerable<Room>? rooms = null)
    {
        this.City = city;
        this.Name = name;
        this._halls = new List<Hall>(halls ?? new List<Hall>());
        this._rooms = new List<Room>(rooms ?? new List<Room>());
        this.CurrentStage = PropertyStage.Open;
    }
    public string City { get; private set; } = default!;
    public string Name { get; private set; } = default!;
    public IReadOnlyList<Hall> Halls
    {
        get => this._halls;
    }
    public IReadOnlyList<Room> Rooms
    {
        get => this._rooms;
    }
    public PropertyStage CurrentStage { get; private set; }
    private DomainResult<Hall> CreateHalls(long capacity, long dayRate, string name, long busySections = 0L, bool occupied = false, bool offline = false)
    {
        var hallResult = Hall.Create(capacity, dayRate, name, this, new List<Section>(), busySections, occupied, offline);
        if (!hallResult.IsSuccess)
        {
            return DomainResult<Hall>.Failure(hallResult.ErrorMessage ?? "");
        }
        var hall = hallResult.Value;
        return DomainResult<Hall>.Success(hall);
    }
    internal void AttachHalls(Hall child)
    {
        this._halls.Add(child);
    }
    internal void AttachRooms(Room child)
    {
        this._rooms.Add(child);
    }
    public DomainResult<Hall> AddHall(string name, long seats, long rate)
    {
        if (this.CurrentStage != PropertyStage.Open)
        {
            return DomainResult<Hall>.Failure("'AddHall' requires stage 'Open' on entity 'Property'.");
        }
        var create0 = this.CreateHalls(seats, rate, name);
        if (!create0.IsSuccess)
        {
            return DomainResult<Hall>.Failure(create0.ErrorMessage ?? "");
        }
        var created1 = create0.Value;
        return DomainResult<Hall>.Success(created1);
    }
    public DomainResult Close()
    {
        if (this.CurrentStage != PropertyStage.Open)
        {
            return DomainResult.Failure("'Close' requires stage 'Open' on entity 'Property'.");
        }
        this.CurrentStage = PropertyStage.Closed;
        return DomainResult.Success();
    }
    public DomainResult Reopen()
    {
        if (this.CurrentStage != PropertyStage.Closed)
        {
            return DomainResult.Failure("'Reopen' requires stage 'Closed' on entity 'Property'.");
        }
        this.CurrentStage = PropertyStage.Open;
        return DomainResult.Success();
    }
    public bool HasHalls() => this.Halls.Count > 0L;
    public static DomainResult<Property> Create(string city, string name, IEnumerable<Hall>? halls = null, IEnumerable<Room>? rooms = null)
    {
        if (string.IsNullOrEmpty(city))
        {
            return DomainResult<Property>.Failure("'City' is required.");
        }
        if (city.Length < 1L)
        {
            return DomainResult<Property>.Failure("'City' must be at least 1 characters.");
        }
        if (city.Length > 60L)
        {
            return DomainResult<Property>.Failure("'City' must be at most 60 characters.");
        }
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Property>.Failure("'Name' is required.");
        }
        if (name.Length < 1L)
        {
            return DomainResult<Property>.Failure("'Name' must be at least 1 characters.");
        }
        if (name.Length > 80L)
        {
            return DomainResult<Property>.Failure("'Name' must be at most 80 characters.");
        }
        var created = new Property(city, name, halls, rooms);
        return DomainResult<Property>.Success(created);
    }
}