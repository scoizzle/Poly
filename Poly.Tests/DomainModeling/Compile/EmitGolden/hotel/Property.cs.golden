    {
        this._rooms.Add(child);
    }
    public DomainResult<Hall> AddHall(string name, long seats, long rate)
    {
        if (this.CurrentStage != PropertyStage.Open)
        {
            return DomainResult<Hall>.Failure("'AddHall' requires stage 'Open' on entity 'Property'.");
        }
        var create0 = this.ProbeCreate("Hall", "Name", name, "Capacity", seats, "DayRate", rate);
        if (!create0.IsSuccess)
        {
            return DomainResult<Hall>.Failure(create0.ErrorMessage ?? "");
        }
        var create1 = this.CreateIn("halls", "Name", name, "Capacity", seats, "DayRate", rate);
        if (!create1.IsSuccess)
        {
            return DomainResult<Hall>.Failure(create1.ErrorMessage ?? "");
        }
        var created2 = create1.Value;
        return DomainResult<Hall>.Success((Hall)created2);
    }
    public DomainResult Close()
    {
        if (this.CurrentStage != PropertyStage.Open)
        {
            return DomainResult.Failure("'Close' requires stage 'Open' on entity 'Property'.");
        }
        this.CurrentStage = PropertyStage.Closed;
        return DomainResult.Success();
    }
    public DomainResult Reopen()
    {
        if (this.CurrentStage != PropertyStage.Closed)
        {
            return DomainResult.Failure("'Reopen' requires stage 'Closed' on entity 'Property'.");
        }
        this.CurrentStage = PropertyStage.Open;
        return DomainResult.Success();
    }
    public bool HasHalls() => this.Halls.Count > 0L;
    public static DomainResult<Property> Create(string city, string name, IEnumerable<Hall>? halls = null, IEnumerable<Room>? rooms = null)
    {
        if (string.IsNullOrEmpty(city))
        {
            return DomainResult<Property>.Failure("'City' is required.");
        }
        if (city.Length < 1L)
        {
            return DomainResult<Property>.Failure("'City' must be at least 1 characters.");
        }
        if (city.Length > 60L)
        {
            return DomainResult<Property>.Failure("'City' must be at most 60 characters.");
        }
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Property>.Failure("'Name' is required.");
        }
        if (name.Length < 1L)
        {
            return DomainResult<Property>.Failure("'Name' must be at least 1 characters.");
        }
        if (name.Length > 80L)
        {
            return DomainResult<Property>.Failure("'Name' must be at most 80 characters.");
        }
        var created = new Property(city, name, halls, rooms);
        return DomainResult<Property>.Success(created);
    }
