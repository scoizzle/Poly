    private DomainResult<Hall> CreateHalls(long capacity, long dayRate, string name, long busySections = 0L, bool occupied = false, bool offline = false)
    {
        var hallResult = Hall.Create(capacity, dayRate, name, this, new List<Section>(), busySections, occupied, offline);
        if (!hallResult.IsSuccess)
        {
            return DomainResult<Hall>.Failure(hallResult.ErrorMessage ?? "");
        }
        var hall = hallResult.Value;
        return DomainResult<Hall>.Success(hall);
    }
    internal void AttachHalls(Hall child)
    {
        this._halls.Add(child);
    }
    private DomainResult<Room> CreateRooms(long floor, long maxOccupancy, long nightlyRate, string number, RoomType? roomType, bool dirty = false, bool occupied = false, bool offline = false)
    {
        var roomResult = Room.Create(floor, maxOccupancy, nightlyRate, number, this, roomType, new List<Reservation>(), dirty, occupied, offline);
        if (!roomResult.IsSuccess)
        {
            return DomainResult<Room>.Failure(roomResult.ErrorMessage ?? "");
        }
        var room = roomResult.Value;
        return DomainResult<Room>.Success(room);
    }
