    private Property(string name, string city, IEnumerable<Hall>? halls = null, IEnumerable<Room>? rooms = null)
    {
        this.Name = name;
        this.City = city;
        this._halls = new List<Hall>(halls ?? new List<Hall>());
        this._rooms = new List<Room>(rooms ?? new List<Room>());
        this.CurrentStage = PropertyStage.Open;
