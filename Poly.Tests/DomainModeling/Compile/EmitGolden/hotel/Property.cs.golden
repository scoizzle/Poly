    public DomainResult<Hall> AddHall(string name, long seats, long rate)
    {
        if (this.CurrentStage != PropertyStage.Open)
        {
            return DomainResult<Hall>.Failure(Poly.Runtime.DomainFailure.Stage("'AddHall' requires stage 'Open' on entity 'Property'.", "Property.AddHall", "Open"));
        }
        var create0 = this.CreateHalls(name, seats, rate);
        if (!create0.IsSuccess)
        {
            return DomainResult<Hall>.Failure(create0.Error!.At("Property.AddHall"));
        }
        var created1 = create0.Value;
        return DomainResult<Hall>.Success(created1);
