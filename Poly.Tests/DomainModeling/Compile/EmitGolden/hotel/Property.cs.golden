        if (this.CurrentStage != PropertyStage.Open)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'Close' requires stage 'Open' on entity 'Property'.", "Property.Close", "Open"));
        }
        this.CurrentStage = PropertyStage.Closed;
        return DomainResult.Success();
