#nullable enable
using System;
using System.Collections.Generic;

using Poly.Runtime;

public enum ReservationStage
{
    Requested = 0,
    Confirmed = 1,
    InHouse = 2,
    Departed = 3,
    Cancelled = 4,
    NoShow = 5
}

public class Reservation
{
    private List<Room>? _roomStaysInHouseSubscribers;
    private List<Room>? _roomStaysDepartedSubscribers;
    private List<Room>? _roomStaysCancelledSubscribers;
    private List<Room>? _roomStaysNoShowSubscribers;
    private List<Guest>? _guestReservationsDepartedSubscribers;
    private int _notifyDepth;
    private Reservation() { }
    private Reservation(long partySize, long nights, decimal nightlyRate, long maxOccupancy, DateOnly checkInDate, DateOnly checkOutDate, Folio? folio = null, Guest? guest = null, Room? room = null)
    {
        this.PartySize = partySize;
        this.Nights = nights;
        this.NightlyRate = nightlyRate;
        this.MaxOccupancy = maxOccupancy;
        this.CheckInDate = checkInDate;
        this.CheckOutDate = checkOutDate;
        this.Folio = folio;
        this.Guest = guest;
        this.Room = room;
        this.CurrentStage = ReservationStage.Requested;
    }
    public long PartySize { get; private set; }
    public long Nights { get; private set; }
    public decimal NightlyRate { get; private set; }
    public long MaxOccupancy { get; private set; }
    public DateOnly CheckInDate { get; private set; }
    public DateOnly CheckOutDate { get; private set; }
    public Folio? Folio { get; private set; }
    public Guest? Guest { get; private set; }
    public Room? Room { get; private set; }
    public ReservationStage CurrentStage { get; private set; }
    public DomainResult<Folio> CreateFolio(decimal balance = 0m)
    {
        var folioResult = Folio.Create(this, balance);
        if (!folioResult.IsSuccess)
        {
            return DomainResult<Folio>.Failure(folioResult.Error!);
        }
        var folio = folioResult.Value;
        this.Folio = folio;
        return DomainResult<Folio>.Success(folio);
    }
    public DomainResult Confirm()
    {
        if (this.CurrentStage != ReservationStage.Requested)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'Confirm' requires stage 'Requested' on entity 'Reservation'.", "Reservation.Confirm", "Requested"));
        }
        if (!this.DatesValid())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'Confirm' blocked by policy 'DatesValid'.", "Reservation.Confirm", "DatesValid"));
        }
        if (!this.PartyFits())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'Confirm' blocked by policy 'PartyFits'.", "Reservation.Confirm", "PartyFits"));
        }
        if (!this.HasRoom())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'Confirm' blocked by policy 'HasRoom'.", "Reservation.Confirm", "HasRoom"));
        }
        this.CurrentStage = ReservationStage.Confirmed;
        return DomainResult.Success();
    }
    public DomainResult Cancel()
    {
        if (this.CurrentStage == ReservationStage.Requested || this.CurrentStage == ReservationStage.Confirmed)
        {
            this.CurrentStage = ReservationStage.Cancelled;
            this.NotifyCancelledSubscribers();
            return DomainResult.Success();
        }
        return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'Cancel' is not valid for the current stage on entity 'Reservation'.", "Reservation.Cancel"));
    }
    public DomainResult CheckIn()
    {
        if (this.CurrentStage != ReservationStage.Confirmed)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'CheckIn' requires stage 'Confirmed' on entity 'Reservation'.", "Reservation.CheckIn", "Confirmed"));
        }
        if (this.Room == null)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Required("'CheckIn' requires a linked 'room' on entity 'Reservation'.", "Reservation.room"));
        }
        if (!this.RoomReady())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'CheckIn' blocked by policy 'RoomReady'.", "Reservation.CheckIn", "RoomReady"));
        }
        if (!this.HasRoom())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'CheckIn' blocked by policy 'HasRoom'.", "Reservation.CheckIn", "HasRoom"));
        }
        if (this.Folio != null)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Link("Cannot add a second link on 'folio': the source already has a target.", "Reservation.folio"));
        }
        var create0 = this.CreateFolio(0L);
        if (!create0.IsSuccess)
        {
            return DomainResult.Failure(create0.Error!.At("Reservation.CheckIn"));
        }
        this.CurrentStage = ReservationStage.InHouse;
        this.NotifyInHouseSubscribers();
        return DomainResult.Success();
    }
    public DomainResult MarkNoShow()
    {
        if (this.CurrentStage != ReservationStage.Confirmed)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'MarkNoShow' requires stage 'Confirmed' on entity 'Reservation'.", "Reservation.MarkNoShow", "Confirmed"));
        }
        this.CurrentStage = ReservationStage.NoShow;
        this.NotifyNoShowSubscribers();
        return DomainResult.Success();
    }
    public DomainResult PostStayCharge()
    {
        if (this.CurrentStage != ReservationStage.InHouse)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'PostStayCharge' requires stage 'InHouse' on entity 'Reservation'.", "Reservation.PostStayCharge", "InHouse"));
        }
        if (!this.HasFolio())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'PostStayCharge' blocked by policy 'HasFolio'.", "Reservation.PostStayCharge", "HasFolio"));
        }
        if (this.Folio == null)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Required("'PostStayCharge' requires a linked 'folio' on entity 'Reservation'.", "Reservation.folio"));
        }
        var invoke0 = this.Folio.PostRoomNight(this.NightlyRate);
        if (!invoke0.IsSuccess)
        {
            return DomainResult.Failure(invoke0.Error!.At("Reservation.PostStayCharge"));
        }
        return DomainResult.Success();
    }
    public DomainResult CheckOut()
    {
        if (this.CurrentStage != ReservationStage.InHouse)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'CheckOut' requires stage 'InHouse' on entity 'Reservation'.", "Reservation.CheckOut", "InHouse"));
        }
        if (!this.HasFolio())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'CheckOut' blocked by policy 'HasFolio'.", "Reservation.CheckOut", "HasFolio"));
        }
        if (this.Folio == null)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Required("'CheckOut' requires a linked 'folio' on entity 'Reservation'.", "Reservation.folio"));
        }
        if (!this.BillSettled())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'CheckOut' blocked by policy 'BillSettled'.", "Reservation.CheckOut", "BillSettled"));
        }
        this.CurrentStage = ReservationStage.Departed;
        this.NotifyDepartedSubscribers();
        return DomainResult.Success();
    }
    public bool DatesValid() => this.CheckOutDate > this.CheckInDate;
    public bool PartyFits() => this.PartySize <= this.MaxOccupancy;
    public bool RoomReady() => this.Room != null && (!this.Room!.Occupied && !this.Room!.Dirty && !this.Room!.Offline);
    public bool HasRoom() => this.Room != null;
    public bool HasGuest() => this.Guest != null;
    public bool BillSettled() => this.Folio != null && this.Folio!.Balance == 0L;
    public bool HasFolio() => this.Folio != null;
    internal void RegisterRoomStaysInHouseSubscriber(Room subscriber)
    {
        if (this._roomStaysInHouseSubscribers == null)
        {
            this._roomStaysInHouseSubscribers = new List<Room>();
        }
        foreach (var existing in this._roomStaysInHouseSubscribers)
        {
            if (object.ReferenceEquals(existing, subscriber))
            {
                return;
            }
        }
        this._roomStaysInHouseSubscribers.Add(subscriber);
    }
    internal void RegisterRoomStaysDepartedSubscriber(Room subscriber)
    {
        if (this._roomStaysDepartedSubscribers == null)
        {
            this._roomStaysDepartedSubscribers = new List<Room>();
        }
        foreach (var existing in this._roomStaysDepartedSubscribers)
        {
            if (object.ReferenceEquals(existing, subscriber))
            {
                return;
            }
        }
        this._roomStaysDepartedSubscribers.Add(subscriber);
    }
    internal void RegisterRoomStaysCancelledSubscriber(Room subscriber)
    {
        if (this._roomStaysCancelledSubscribers == null)
        {
            this._roomStaysCancelledSubscribers = new List<Room>();
        }
        foreach (var existing in this._roomStaysCancelledSubscribers)
        {
            if (object.ReferenceEquals(existing, subscriber))
            {
                return;
            }
        }
        this._roomStaysCancelledSubscribers.Add(subscriber);
    }
    internal void RegisterRoomStaysNoShowSubscriber(Room subscriber)
    {
        if (this._roomStaysNoShowSubscribers == null)
        {
            this._roomStaysNoShowSubscribers = new List<Room>();
        }
        foreach (var existing in this._roomStaysNoShowSubscribers)
        {
            if (object.ReferenceEquals(existing, subscriber))
            {
                return;
            }
        }
        this._roomStaysNoShowSubscribers.Add(subscriber);
    }
    internal void RegisterGuestReservationsDepartedSubscriber(Guest subscriber)
    {
        if (this._guestReservationsDepartedSubscribers == null)
        {
            this._guestReservationsDepartedSubscribers = new List<Guest>();
        }
        foreach (var existing in this._guestReservationsDepartedSubscribers)
        {
            if (object.ReferenceEquals(existing, subscriber))
            {
                return;
            }
        }
        this._guestReservationsDepartedSubscribers.Add(subscriber);
    }
    internal void NotifyInHouseSubscribers()
    {
        this.EnterNotifyCascade("InHouse");
        try
        {
            if (this._roomStaysInHouseSubscribers != null)
            {
                foreach (var sub in this._roomStaysInHouseSubscribers)
                {
                    sub.WhenEachReservationInHouse();
                }
            }
        }
        finally
        {
            this.ExitNotifyCascade();
        }
    }
    internal void NotifyDepartedSubscribers()
    {
        this.EnterNotifyCascade("Departed");
        try
        {
            if (this._roomStaysDepartedSubscribers != null)
            {
                foreach (var sub in this._roomStaysDepartedSubscribers)
                {
                    sub.WhenEachReservationDeparted_SetOccupied();
                    sub.WhenEachReservationDeparted_SetDirty();
                }
            }
            if (this._guestReservationsDepartedSubscribers != null)
            {
                foreach (var sub in this._guestReservationsDepartedSubscribers)
                {
                    sub.WhenEachReservationDeparted(this);
                }
            }
        }
        finally
        {
            this.ExitNotifyCascade();
        }
    }
    internal void NotifyCancelledSubscribers()
    {
        this.EnterNotifyCascade("Cancelled");
        try
        {
            if (this._roomStaysCancelledSubscribers != null)
            {
                foreach (var sub in this._roomStaysCancelledSubscribers)
                {
                    sub.WhenEachReservationCancelled();
                }
            }
        }
        finally
        {
            this.ExitNotifyCascade();
        }
    }
    internal void NotifyNoShowSubscribers()
    {
        this.EnterNotifyCascade("NoShow");
        try
        {
            if (this._roomStaysNoShowSubscribers != null)
            {
                foreach (var sub in this._roomStaysNoShowSubscribers)
                {
                    sub.WhenEachReservationNoShow();
                }
            }
        }
        finally
        {
            this.ExitNotifyCascade();
        }
    }
    public static DomainResult<Reservation> Create(long partySize, long nights, decimal nightlyRate, long maxOccupancy, DateOnly checkInDate, DateOnly checkOutDate, Folio? folio = null, Guest? guest = null, Room? room = null)
    {
        if (partySize < 1L)
        {
            return DomainResult<Reservation>.Failure(Poly.Runtime.DomainFailure.Range("'PartySize' must be >= 1.", "Reservation.PartySize"));
        }
        if (partySize > 8L)
        {
            return DomainResult<Reservation>.Failure(Poly.Runtime.DomainFailure.Range("'PartySize' must be <= 8.", "Reservation.PartySize"));
        }
        if (nights < 1L)
        {
            return DomainResult<Reservation>.Failure(Poly.Runtime.DomainFailure.Range("'Nights' must be >= 1.", "Reservation.Nights"));
        }
        if (nights > 60L)
        {
            return DomainResult<Reservation>.Failure(Poly.Runtime.DomainFailure.Range("'Nights' must be <= 60.", "Reservation.Nights"));
        }
        if (nightlyRate < 0m)
        {
            return DomainResult<Reservation>.Failure(Poly.Runtime.DomainFailure.Range("'NightlyRate' must be >= 0.", "Reservation.NightlyRate"));
        }
        if (nightlyRate > 10000m)
        {
            return DomainResult<Reservation>.Failure(Poly.Runtime.DomainFailure.Range("'NightlyRate' must be <= 10000.", "Reservation.NightlyRate"));
        }
        if (maxOccupancy < 1L)
        {
            return DomainResult<Reservation>.Failure(Poly.Runtime.DomainFailure.Range("'MaxOccupancy' must be >= 1.", "Reservation.MaxOccupancy"));
        }
        if (maxOccupancy > 8L)
        {
            return DomainResult<Reservation>.Failure(Poly.Runtime.DomainFailure.Range("'MaxOccupancy' must be <= 8.", "Reservation.MaxOccupancy"));
        }
        var created = new Reservation(partySize, nights, nightlyRate, maxOccupancy, checkInDate, checkOutDate, folio, guest, room);
        if (guest != null)
        {
            guest.AttachReservations(created);
        }
        if (room != null)
        {
            room.AttachStays(created);
        }
        return DomainResult<Reservation>.Success(created);
    }
    private void EnterNotifyCascade(string stageName)
    {
        if (this._notifyDepth >= 16)
        {
            throw new System.InvalidOperationException(string.Concat("Subscription cascade on entity 'Reservation' exceeded max depth (16) while notifying '", stageName, "'."));
        }
        this._notifyDepth = this._notifyDepth + 1;
    }
    private void ExitNotifyCascade()
    {
        this._notifyDepth = this._notifyDepth - 1;
    }
}