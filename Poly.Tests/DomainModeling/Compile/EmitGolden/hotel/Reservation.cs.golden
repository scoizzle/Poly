#nullable enable
using System;
using System.Collections.Generic;

public enum ReservationStage
{
    Requested = 0,
    Confirmed = 1,
    InHouse = 2,
    Departed = 3,
    Cancelled = 4,
    NoShow = 5
}

public class Reservation
{
    private List<Room>? _roomInHouseSubscribers;
    private List<Room>? _roomDepartedSubscribers;
    private List<Room>? _roomCancelledSubscribers;
    private List<Room>? _roomNoShowSubscribers;
    private List<Guest>? _guestDepartedSubscribers;
    private Reservation()
    { }
    private Reservation(DateOnly checkInDate, DateOnly checkOutDate, long maxOccupancy, long nightlyRate, long nights, long partySize, Folio? folio = null, Guest? guest = null, Room? room = null)
    {
        this.CheckInDate = checkInDate;
        this.CheckOutDate = checkOutDate;
        this.MaxOccupancy = maxOccupancy;
        this.NightlyRate = nightlyRate;
        this.Nights = nights;
        this.PartySize = partySize;
        this.Folio = folio;
        this.Guest = guest;
        this.Room = room;
        this.CurrentStage = ReservationStage.Requested;
    }
    public DateOnly CheckInDate { get; private set; }
    public DateOnly CheckOutDate { get; private set; }
    public long MaxOccupancy { get; private set; }
    public long NightlyRate { get; private set; }
    public long Nights { get; private set; }
    public long PartySize { get; private set; }
    public Folio? Folio { get; private set; }
    public Guest? Guest { get; private set; }
    public Room? Room { get; private set; }
    public ReservationStage CurrentStage { get; private set; }
    private DomainResult<Folio> CreateFolio(long balance = 0L)
    {
        var folioResult = Folio.Create(this, balance);
        if (!folioResult.IsSuccess)
        {
            return DomainResult<Folio>.Failure(folioResult.ErrorMessage ?? "");
        }
        var folio = folioResult.Value;
        this.Folio = folio;
        return DomainResult<Folio>.Success(folio);
    }
    private DomainResult<Guest> CreateGuest(string email, string name, string phone, long eventCount = 0L, long nightCount = 0L, long stayCount = 0L)
    {
        var guestResult = Guest.Create(email, name, phone, new List<EventHold>(), new List<Reservation>(), eventCount, nightCount, stayCount);
        if (!guestResult.IsSuccess)
        {
            return DomainResult<Guest>.Failure(guestResult.ErrorMessage ?? "");
        }
        var guest = guestResult.Value;
        this.Guest = guest;
        return DomainResult<Guest>.Success(guest);
    }
    private DomainResult<Room> CreateRoom(long floor, long maxOccupancy, long nightlyRate, string number, Property? property, RoomType? roomType, bool dirty = false, bool occupied = false, bool offline = false)
    {
        var roomResult = Room.Create(floor, maxOccupancy, nightlyRate, number, property, roomType, new List<Reservation>(), dirty, occupied, offline);
        if (!roomResult.IsSuccess)
        {
            return DomainResult<Room>.Failure(roomResult.ErrorMessage ?? "");
        }
        var room = roomResult.Value;
        this.Room = room;
        return DomainResult<Room>.Success(room);
    }
    public DomainResult Confirm()
    {
        if (this.CurrentStage != ReservationStage.Requested)
        {
            return DomainResult.Failure("'Confirm' requires stage 'Requested' on entity 'Reservation'.");
        }
        if (!this.DatesValid())
        {
            return DomainResult.Failure("'Confirm' blocked by policy 'DatesValid'.");
        }
        if (!this.PartyFits())
        {
            return DomainResult.Failure("'Confirm' blocked by policy 'PartyFits'.");
        }
        if (!this.HasRoom())
        {
            return DomainResult.Failure("'Confirm' blocked by policy 'HasRoom'.");
        }
        this.CurrentStage = ReservationStage.Confirmed;
        return DomainResult.Success();
    }
    public DomainResult Cancel()
    {
        if (this.CurrentStage == ReservationStage.Requested)
        {
            var previousStage0 = this.CurrentStage;
            this.CurrentStage = ReservationStage.Cancelled;
            this.NotifyCancelledSubscribers(previousStage0);
            return DomainResult.Success();
        }
        if (this.CurrentStage == ReservationStage.Confirmed)
        {
            var previousStage1 = this.CurrentStage;
            this.CurrentStage = ReservationStage.Cancelled;
            this.NotifyCancelledSubscribers(previousStage1);
            return DomainResult.Success();
        }
        return DomainResult.Failure("'Cancel' is not valid for the current stage on entity 'Reservation'.");
    }
    public DomainResult CheckIn()
    {
        if (this.CurrentStage != ReservationStage.Confirmed)
        {
            return DomainResult.Failure("'CheckIn' requires stage 'Confirmed' on entity 'Reservation'.");
        }
        if (this.Room == null)
        {
            return DomainResult.Failure("'CheckIn' requires a linked 'room' on entity 'Reservation'.");
        }
        if (!this.RoomReady())
        {
            return DomainResult.Failure("'CheckIn' blocked by policy 'RoomReady'.");
        }
        if (!this.HasRoom())
        {
            return DomainResult.Failure("'CheckIn' blocked by policy 'HasRoom'.");
        }
        var create0 = this.ProbeCreate("Folio", "Balance", 0L);
        if (!create0.IsSuccess)
        {
            return DomainResult.Failure(create0.ErrorMessage ?? "");
        }
        var create1 = this.CreateIn("folio", "Balance", 0L);
        if (!create1.IsSuccess)
        {
            return DomainResult.Failure(create1.ErrorMessage ?? "");
        }
        var created2 = create1.Value;
        var previousStage3 = this.CurrentStage;
        this.CurrentStage = ReservationStage.InHouse;
        this.NotifyInHouseSubscribers(previousStage3);
        return DomainResult.Success();
    }
    public DomainResult MarkNoShow()
    {
        if (this.CurrentStage != ReservationStage.Confirmed)
        {
            return DomainResult.Failure("'MarkNoShow' requires stage 'Confirmed' on entity 'Reservation'.");
        }
        var previousStage0 = this.CurrentStage;
        this.CurrentStage = ReservationStage.NoShow;
        this.NotifyNoShowSubscribers(previousStage0);
        return DomainResult.Success();
    }
    public DomainResult PostStayCharge()
    {
        if (this.CurrentStage != ReservationStage.InHouse)
        {
            return DomainResult.Failure("'PostStayCharge' requires stage 'InHouse' on entity 'Reservation'.");
        }
        if (!this.HasFolio())
        {
            return DomainResult.Failure("'PostStayCharge' blocked by policy 'HasFolio'.");
        }
        if (this.Folio == null)
        {
            return DomainResult.Failure("'PostRoomNight' requires a linked 'folio' on entity 'Reservation'.");
        }
        var invoke0 = this.Folio.PostRoomNight(this.NightlyRate);
        if (!invoke0.IsSuccess)
        {
            return DomainResult.Failure(invoke0.ErrorMessage ?? "");
        }
        return DomainResult.Success();
    }
    public DomainResult CheckOut()
    {
        if (this.CurrentStage != ReservationStage.InHouse)
        {
            return DomainResult.Failure("'CheckOut' requires stage 'InHouse' on entity 'Reservation'.");
        }
        if (!this.HasFolio())
        {
            return DomainResult.Failure("'CheckOut' blocked by policy 'HasFolio'.");
        }
        if (this.Folio == null)
        {
            return DomainResult.Failure("'CheckOut' requires a linked 'folio' on entity 'Reservation'.");
        }
        if (!this.BillSettled())
        {
            return DomainResult.Failure("'CheckOut' blocked by policy 'BillSettled'.");
        }
        var previousStage0 = this.CurrentStage;
        this.CurrentStage = ReservationStage.Departed;
        this.NotifyDepartedSubscribers(previousStage0);
        return DomainResult.Success();
    }
    public bool DatesValid() => this.CheckOutDate > this.CheckInDate;
    public bool PartyFits() => this.PartySize <= this.MaxOccupancy;
    public bool RoomReady() => this.Room != null && (!this.Room!.Occupied && !this.Room!.Dirty && !this.Room!.Offline);
    public bool HasRoom() => this.Room != null;
    public bool HasGuest() => this.Guest != null;
    public bool BillSettled() => this.Folio != null && this.Folio!.Balance == 0L;
    public bool HasFolio() => this.Folio != null;
    internal void RegisterRoomInHouseSubscriber(Room subscriber)
    {
        if (this._roomInHouseSubscribers == null)
        {
            this._roomInHouseSubscribers = new List<Room>();
        }
        this._roomInHouseSubscribers.Add(subscriber);
    }
    internal void RegisterRoomDepartedSubscriber(Room subscriber)
    {
        if (this._roomDepartedSubscribers == null)
        {
            this._roomDepartedSubscribers = new List<Room>();
        }
        this._roomDepartedSubscribers.Add(subscriber);
    }
    internal void RegisterRoomCancelledSubscriber(Room subscriber)
    {
        if (this._roomCancelledSubscribers == null)
        {
            this._roomCancelledSubscribers = new List<Room>();
        }
        this._roomCancelledSubscribers.Add(subscriber);
    }
    internal void RegisterRoomNoShowSubscriber(Room subscriber)
    {
        if (this._roomNoShowSubscribers == null)
        {
            this._roomNoShowSubscribers = new List<Room>();
        }
        this._roomNoShowSubscribers.Add(subscriber);
    }
    internal void RegisterGuestDepartedSubscriber(Guest subscriber)
    {
        if (this._guestDepartedSubscribers == null)
        {
            this._guestDepartedSubscribers = new List<Guest>();
        }
        this._guestDepartedSubscribers.Add(subscriber);
    }
    internal void NotifyInHouseSubscribers(ReservationStage previousStage)
    {
        if (this._roomInHouseSubscribers != null)
        {
            foreach (var sub in this._roomInHouseSubscribers)
            {
                sub.WhenEachReservationInHouse();
            }
        }
    }
    internal void NotifyDepartedSubscribers(ReservationStage previousStage)
    {
        if (this._roomDepartedSubscribers != null)
        {
            foreach (var sub in this._roomDepartedSubscribers)
            {
                sub.WhenEachReservationDeparted();
                sub.WhenEachReservationDeparted_2();
            }
        }
        if (this._guestDepartedSubscribers != null)
        {
            foreach (var sub in this._guestDepartedSubscribers)
            {
                sub.WhenEachReservationDeparted(this);
            }
        }
    }
    internal void NotifyCancelledSubscribers(ReservationStage previousStage)
    {
        if (this._roomCancelledSubscribers != null)
        {
            foreach (var sub in this._roomCancelledSubscribers)
            {
                sub.WhenEachReservationCancelled();
            }
        }
    }
    internal void NotifyNoShowSubscribers(ReservationStage previousStage)
    {
        if (this._roomNoShowSubscribers != null)
        {
            foreach (var sub in this._roomNoShowSubscribers)
            {
                sub.WhenEachReservationNoShow();
            }
        }
    }
    public static DomainResult<Reservation> Create(DateOnly checkInDate, DateOnly checkOutDate, long maxOccupancy, long nightlyRate, long nights, long partySize, Folio? folio = null, Guest? guest = null, Room? room = null)
    {
        if (maxOccupancy < 1L)
        {
            return DomainResult<Reservation>.Failure("'MaxOccupancy' must be >= 1.");
        }
        if (maxOccupancy > 8L)
        {
            return DomainResult<Reservation>.Failure("'MaxOccupancy' must be <= 8.");
        }
        if (nightlyRate < 0L)
        {
            return DomainResult<Reservation>.Failure("'NightlyRate' must be >= 0.");
        }
        if (nightlyRate > 10000L)
        {
            return DomainResult<Reservation>.Failure("'NightlyRate' must be <= 10000.");
        }
        if (nights < 1L)
        {
            return DomainResult<Reservation>.Failure("'Nights' must be >= 1.");
        }
        if (nights > 60L)
        {
            return DomainResult<Reservation>.Failure("'Nights' must be <= 60.");
        }
        if (partySize < 1L)
        {
            return DomainResult<Reservation>.Failure("'PartySize' must be >= 1.");
        }
        if (partySize > 8L)
        {
            return DomainResult<Reservation>.Failure("'PartySize' must be <= 8.");
        }
        var created = new Reservation(checkInDate, checkOutDate, maxOccupancy, nightlyRate, nights, partySize, folio, guest, room);
        if (guest != null)
        {
            guest.AttachReservations(created);
        }
        if (room != null)
        {
            room.AttachStays(created);
        }
        return DomainResult<Reservation>.Success(created);
    }
