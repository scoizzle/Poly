#nullable enable
using System;
using System.Collections.Generic;

public enum RoomStage
{
    InService = 0,
    OutOfService = 1
}

public class Room
{
    private List<Reservation> _stays;
    private Room()
    {
        this._stays = new List<Reservation>();
    }
    private Room(long floor, long maxOccupancy, long nightlyRate, string number, Property? property = null, RoomType? roomType = null, IEnumerable<Reservation>? stays = null, bool dirty = false, bool occupied = false, bool offline = false)
    {
        this.Dirty = dirty;
        this.Floor = floor;
        this.MaxOccupancy = maxOccupancy;
        this.NightlyRate = nightlyRate;
        this.Number = number;
        this.Occupied = occupied;
        this.Offline = offline;
        this.Property = property;
        this.RoomType = roomType;
        this._stays = new List<Reservation>(stays ?? new List<Reservation>());
        this.CurrentStage = RoomStage.InService;
        this.InitializeSubscriptions();
    }
    public bool Dirty { get; private set; }
    public long Floor { get; private set; }
    public long MaxOccupancy { get; private set; }
    public long NightlyRate { get; private set; }
    public string Number { get; private set; } = default!;
    public bool Occupied { get; private set; }
    public bool Offline { get; private set; }
    public Property? Property { get; private set; }
    public RoomType? RoomType { get; private set; }
    public IReadOnlyList<Reservation> Stays
    {
        get => this._stays;
    }
    public RoomStage CurrentStage { get; private set; }
    private DomainResult<Property> CreateProperty(string city, string name)
    {
        var propertyResult = Property.Create(city, name, new List<Hall>(), new List<Room>());
        if (!propertyResult.IsSuccess)
        {
            return DomainResult<Property>.Failure(propertyResult.ErrorMessage ?? "");
        }
        var property = propertyResult.Value;
        this.Property = property;
        return DomainResult<Property>.Success(property);
    }
    private DomainResult<RoomType> CreateRoomType(long maxOccupancy, string name, long nightlyRate)
    {
        var roomTypeResult = RoomType.Create(maxOccupancy, name, nightlyRate);
        if (!roomTypeResult.IsSuccess)
        {
            return DomainResult<RoomType>.Failure(roomTypeResult.ErrorMessage ?? "");
        }
        var roomType = roomTypeResult.Value;
        this.RoomType = roomType;
        return DomainResult<RoomType>.Success(roomType);
    }
    private DomainResult<Reservation> CreateStays(DateOnly checkInDate, DateOnly checkOutDate, long maxOccupancy, long nightlyRate, long nights, long partySize, Folio? folio, Guest? guest)
    {
        var reservationResult = Reservation.Create(checkInDate, checkOutDate, maxOccupancy, nightlyRate, nights, partySize, folio, guest, this);
        if (!reservationResult.IsSuccess)
        {
            return DomainResult<Reservation>.Failure(reservationResult.ErrorMessage ?? "");
        }
        var reservation = reservationResult.Value;
        return DomainResult<Reservation>.Success(reservation);
    }
    internal void AttachStays(Reservation child)
    {
        this._stays.Add(child);
        child.RegisterRoomInHouseSubscriber(this);
        child.RegisterRoomDepartedSubscriber(this);
        child.RegisterRoomCancelledSubscriber(this);
        child.RegisterRoomNoShowSubscriber(this);
    }
    public DomainResult TakeOutOfService()
    {
        if (this.CurrentStage != RoomStage.InService)
        {
            return DomainResult.Failure("'TakeOutOfService' requires stage 'InService' on entity 'Room'.");
        }
        if (!this.IsVacant())
        {
            return DomainResult.Failure("'TakeOutOfService' blocked by policy 'IsVacant'.");
        }
        this.Offline = true;
        this.CurrentStage = RoomStage.OutOfService;
        return DomainResult.Success();
    }
    public DomainResult Inspect()
    {
        if (this.CurrentStage != RoomStage.InService)
        {
            return DomainResult.Failure("'Inspect' requires stage 'InService' on entity 'Room'.");
        }
        this.Dirty = false;
        return DomainResult.Success();
    }
    public DomainResult ReturnToService()
    {
        if (this.CurrentStage != RoomStage.OutOfService)
        {
            return DomainResult.Failure("'ReturnToService' requires stage 'OutOfService' on entity 'Room'.");
        }
        this.Offline = false;
        this.CurrentStage = RoomStage.InService;
        return DomainResult.Success();
    }
    public bool IsVacant() => !this.Occupied;
    public bool IsReady() => !this.Occupied && !this.Dirty && !this.Offline;
    public bool HasType() => this.RoomType != null;
    internal void WhenEachReservationInHouse()
    {
        this.Occupied = true;
    }
    internal void WhenEachReservationDeparted()
    {
        this.Occupied = false;
    }
    internal void WhenEachReservationCancelled()
    {
        this.Occupied = false;
    }
    internal void WhenEachReservationNoShow()
    {
        this.Occupied = false;
    }
    internal void WhenEachReservationDeparted_2()
    {
        this.Dirty = true;
    }
    public static DomainResult<Room> Create(long floor, long maxOccupancy, long nightlyRate, string number, Property? property = null, RoomType? roomType = null, IEnumerable<Reservation>? stays = null, bool dirty = false, bool occupied = false, bool offline = false)
    {
        if (floor < 0L)
        {
            return DomainResult<Room>.Failure("'Floor' must be >= 0.");
        }
        if (floor > 50L)
        {
            return DomainResult<Room>.Failure("'Floor' must be <= 50.");
        }
        if (maxOccupancy < 1L)
        {
            return DomainResult<Room>.Failure("'MaxOccupancy' must be >= 1.");
        }
        if (maxOccupancy > 8L)
        {
            return DomainResult<Room>.Failure("'MaxOccupancy' must be <= 8.");
        }
        if (nightlyRate < 0L)
        {
            return DomainResult<Room>.Failure("'NightlyRate' must be >= 0.");
        }
        if (nightlyRate > 10000L)
        {
            return DomainResult<Room>.Failure("'NightlyRate' must be <= 10000.");
        }
        if (string.IsNullOrEmpty(number))
        {
            return DomainResult<Room>.Failure("'Number' is required.");
        }
        if (number.Length < 1L)
        {
            return DomainResult<Room>.Failure("'Number' must be at least 1 characters.");
        }
        if (number.Length > 8L)
        {
            return DomainResult<Room>.Failure("'Number' must be at most 8 characters.");
        }
        var created = new Room(floor, maxOccupancy, nightlyRate, number, property, roomType, stays, dirty, occupied, offline);
        var uniqueCheck = created.EnsureUnique("Number", number);
        if (!uniqueCheck.IsSuccess)
        {
            return DomainResult<Room>.Failure(uniqueCheck.ErrorMessage ?? "");
        }
        if (property != null)
        {
            property.AttachRooms(created);
        }
        return DomainResult<Room>.Success(created);
    }
    private void InitializeSubscriptions()
    {
        foreach (var target in this.Stays)
        {
            target.RegisterRoomInHouseSubscriber(this);
        }
        foreach (var target in this.Stays)
        {
            target.RegisterRoomDepartedSubscriber(this);
        }
        foreach (var target in this.Stays)
        {
            target.RegisterRoomCancelledSubscriber(this);
        }
        foreach (var target in this.Stays)
        {
            target.RegisterRoomNoShowSubscriber(this);
        }
    }
    public DomainResult EnsureUnique(string propertyName, object value) => DomainResult.Success();
