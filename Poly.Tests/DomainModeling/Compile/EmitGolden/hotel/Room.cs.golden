#nullable enable
using System.Collections.Generic;

using Poly.Runtime;

public enum RoomStage
{
    InService = 0,
    OutOfService = 1
}

public class Room
{
    private List<Reservation> _stays = new List<Reservation>();
    private Room() { }
    private Room(string number, long floor, decimal nightlyRate, long maxOccupancy, Property? property = null, RoomType? roomType = null, IEnumerable<Reservation>? stays = null, bool occupied = false, bool dirty = false, bool offline = false)
    {
        this.Number = number;
        this.Floor = floor;
        this.NightlyRate = nightlyRate;
        this.MaxOccupancy = maxOccupancy;
        this.Occupied = occupied;
        this.Dirty = dirty;
        this.Offline = offline;
        this.Property = property;
        this.RoomType = roomType;
        this._stays = new List<Reservation>(stays ?? new List<Reservation>());
        this.CurrentStage = RoomStage.InService;
        this.InitializeSubscriptions();
    }
    public string Number { get; private set; } = default!;
    public long Floor { get; private set; }
    public decimal NightlyRate { get; private set; }
    public long MaxOccupancy { get; private set; }
    public bool Occupied { get; private set; }
    public bool Dirty { get; private set; }
    public bool Offline { get; private set; }
    public Property? Property { get; private set; }
    public RoomType? RoomType { get; private set; }
    public IReadOnlyList<Reservation> Stays
    {
        get => this._stays;
    }
    public RoomStage CurrentStage { get; private set; }
    internal void AttachStays(Reservation child)
    {
        this._stays.Add(child);
        child.RegisterRoomStaysInHouseSubscriber(this);
        child.RegisterRoomStaysDepartedSubscriber(this);
        child.RegisterRoomStaysCancelledSubscriber(this);
        child.RegisterRoomStaysNoShowSubscriber(this);
    }
    public DomainResult TakeOutOfService()
    {
        if (this.CurrentStage != RoomStage.InService)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'TakeOutOfService' requires stage 'InService' on entity 'Room'.", "Room.TakeOutOfService", "InService"));
        }
        if (!this.IsVacant())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'TakeOutOfService' blocked by policy 'IsVacant'.", "Room.TakeOutOfService", "IsVacant"));
        }
        this.Offline = true;
        this.CurrentStage = RoomStage.OutOfService;
        return DomainResult.Success();
    }
    public DomainResult Inspect()
    {
        if (this.CurrentStage != RoomStage.InService)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'Inspect' requires stage 'InService' on entity 'Room'.", "Room.Inspect", "InService"));
        }
        this.Dirty = false;
        return DomainResult.Success();
    }
    public DomainResult ReturnToService()
    {
        if (this.CurrentStage != RoomStage.OutOfService)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'ReturnToService' requires stage 'OutOfService' on entity 'Room'.", "Room.ReturnToService", "OutOfService"));
        }
        this.Offline = false;
        this.CurrentStage = RoomStage.InService;
        return DomainResult.Success();
    }
    public bool IsVacant() => !this.Occupied;
    public bool IsReady() => !this.Occupied && !this.Dirty && !this.Offline;
    public bool HasType() => this.RoomType != null;
    internal void WhenEachReservationInHouse()
    {
        this.Occupied = true;
    }
    internal void WhenEachReservationDeparted_SetOccupied()
    {
        this.Occupied = false;
    }
    internal void WhenEachReservationCancelled()
    {
        this.Occupied = false;
    }
    internal void WhenEachReservationNoShow()
    {
        this.Occupied = false;
    }
    internal void WhenEachReservationDeparted_SetDirty()
    {
        this.Dirty = true;
    }
    public static DomainResult<Room> Create(string number, long floor, decimal nightlyRate, long maxOccupancy, Poly.Runtime.IStoragePort db, Property? property = null, RoomType? roomType = null, IEnumerable<Reservation>? stays = null, bool occupied = false, bool dirty = false, bool offline = false)
    {
        if (string.IsNullOrEmpty(number))
        {
            return DomainResult<Room>.Failure(Poly.Runtime.DomainFailure.Required("'Number' is required.", "Room.Number"));
        }
        if (number.Length < 1L)
        {
            return DomainResult<Room>.Failure(Poly.Runtime.DomainFailure.Length("'Number' must be at least 1 characters.", "Room.Number"));
        }
        if (number.Length > 8L)
        {
            return DomainResult<Room>.Failure(Poly.Runtime.DomainFailure.Length("'Number' must be at most 8 characters.", "Room.Number"));
        }
        if (floor < 0L)
        {
            return DomainResult<Room>.Failure(Poly.Runtime.DomainFailure.Range("'Floor' must be >= 0.", "Room.Floor"));
        }
        if (floor > 50L)
        {
            return DomainResult<Room>.Failure(Poly.Runtime.DomainFailure.Range("'Floor' must be <= 50.", "Room.Floor"));
        }
        if (nightlyRate < 0m)
        {
            return DomainResult<Room>.Failure(Poly.Runtime.DomainFailure.Range("'NightlyRate' must be >= 0.", "Room.NightlyRate"));
        }
        if (nightlyRate > 10000m)
        {
            return DomainResult<Room>.Failure(Poly.Runtime.DomainFailure.Range("'NightlyRate' must be <= 10000.", "Room.NightlyRate"));
        }
        if (maxOccupancy < 1L)
        {
            return DomainResult<Room>.Failure(Poly.Runtime.DomainFailure.Range("'MaxOccupancy' must be >= 1.", "Room.MaxOccupancy"));
        }
        if (maxOccupancy > 8L)
        {
            return DomainResult<Room>.Failure(Poly.Runtime.DomainFailure.Range("'MaxOccupancy' must be <= 8.", "Room.MaxOccupancy"));
        }
        if (Room.ExistsWithNumber(db, number))
        {
            return DomainResult<Room>.Failure(Poly.Runtime.DomainFailure.Unique("Unique constraint violated: 'Number' value is already used on another 'Room'.", "Room.Number"));
        }
        var created = new Room(number, floor, nightlyRate, maxOccupancy, property, roomType, stays, occupied, dirty, offline);
        if (property != null)
        {
            property.AttachRooms(created);
        }
        db.Record("Room", "Number", number);
        return DomainResult<Room>.Success(created);
    }
    private void InitializeSubscriptions()
    {
        foreach (var target in this.Stays)
        {
            target.RegisterRoomStaysInHouseSubscriber(this);
        }
        foreach (var target in this.Stays)
        {
            target.RegisterRoomStaysDepartedSubscriber(this);
        }
        foreach (var target in this.Stays)
        {
            target.RegisterRoomStaysCancelledSubscriber(this);
        }
        foreach (var target in this.Stays)
        {
            target.RegisterRoomStaysNoShowSubscriber(this);
        }
    }
    public DomainResult EnsureUnique(string propertyName, object value)
    {
        if (value == null)
        {
            return DomainResult.Success();
        }
        if (propertyName == "Number" && object.Equals(this.Number, value))
        {
            return DomainResult.Success();
        }
        return DomainResult.Failure(Poly.Runtime.DomainFailure.Constraint("A unique assign needs the storage port.", "Room"));
    }
    public static System.Boolean ExistsWithNumber(Poly.Runtime.IStoragePort db, System.String number) => db.Exists("Room", "Number", number);
}