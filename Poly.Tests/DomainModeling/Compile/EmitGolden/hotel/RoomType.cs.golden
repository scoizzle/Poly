#nullable enable
public class RoomType
{
    private RoomType(string name, decimal nightlyRate, long maxOccupancy)
    {
        this.Name = name;
        this.NightlyRate = nightlyRate;
        this.MaxOccupancy = maxOccupancy;
    }
    public string Name { get; private set; } = default!;
    public decimal NightlyRate { get; private set; }
    public long MaxOccupancy { get; private set; }
    public static DomainResult<RoomType> Create(string name, decimal nightlyRate, long maxOccupancy)
    {
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<RoomType>.Failure("'Name' is required.");
        }
        if (name.Length < 1L)
        {
            return DomainResult<RoomType>.Failure("'Name' must be at least 1 characters.");
        }
        if (name.Length > 40L)
        {
            return DomainResult<RoomType>.Failure("'Name' must be at most 40 characters.");
        }
        if (nightlyRate < 0m)
        {
            return DomainResult<RoomType>.Failure("'NightlyRate' must be >= 0.");
        }
        if (nightlyRate > 10000m)
        {
            return DomainResult<RoomType>.Failure("'NightlyRate' must be <= 10000.");
        }
        if (maxOccupancy < 1L)
        {
            return DomainResult<RoomType>.Failure("'MaxOccupancy' must be >= 1.");
        }
        if (maxOccupancy > 8L)
        {
            return DomainResult<RoomType>.Failure("'MaxOccupancy' must be <= 8.");
        }
        var created = new RoomType(name, nightlyRate, maxOccupancy);
        return DomainResult<RoomType>.Success(created);
    }
}