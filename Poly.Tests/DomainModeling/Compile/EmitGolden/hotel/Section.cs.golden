#nullable enable
using Poly.Runtime;

public class Section
{
    private Section() { }
    private Section(string name, long capacity, decimal dayRate, Hall? hall = null, bool occupied = false)
    {
        this.Name = name;
        this.Capacity = capacity;
        this.DayRate = dayRate;
        this.Occupied = occupied;
        this.Hall = hall;
    }
    public string Name { get; private set; } = default!;
    public long Capacity { get; private set; }
    public decimal DayRate { get; private set; }
    public bool Occupied { get; private set; }
    public Hall? Hall { get; private set; }
    public DomainResult Occupy()
    {
        if (!this.CanBook())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'Occupy' blocked by policy 'CanBook'.", "Section.Occupy", "CanBook"));
        }
        if (this.Hall == null)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Required("'Occupy' requires a linked 'hall' on entity 'Section'.", "Section.hall"));
        }
        if (!this.ParentFree())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'Occupy' blocked by policy 'ParentFree'.", "Section.Occupy", "ParentFree"));
        }
        this.Occupied = true;
        if (this.Hall == null)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Required("'Occupy' requires a linked 'hall' on entity 'Section'.", "Section.hall"));
        }
        var invoke0 = this.Hall.MarkChildBusy();
        if (!invoke0.IsSuccess)
        {
            return DomainResult.Failure(invoke0.Error!.At("Section.Occupy"));
        }
        return DomainResult.Success();
    }
    public DomainResult Vacate()
    {
        if (!this.IsOccupied())
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Policy("'Vacate' blocked by policy 'IsOccupied'.", "Section.Vacate", "IsOccupied"));
        }
        this.Occupied = false;
        if (this.Hall == null)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Required("'Vacate' requires a linked 'hall' on entity 'Section'.", "Section.hall"));
        }
        var invoke0 = this.Hall.ClearChildBusy();
        if (!invoke0.IsSuccess)
        {
            return DomainResult.Failure(invoke0.Error!.At("Section.Vacate"));
        }
        return DomainResult.Success();
    }
    public bool IsVacant() => !this.Occupied;
    public bool IsOccupied() => this.Occupied;
    public bool ParentFree() => this.Hall != null && (!this.Hall!.Occupied && !this.Hall!.Offline);
    public bool CanBook() => !this.Occupied;
    public static DomainResult<Section> Create(string name, long capacity, decimal dayRate, Hall? hall = null, bool occupied = false)
    {
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Section>.Failure(Poly.Runtime.DomainFailure.Required("'Name' is required.", "Section.Name"));
        }
        if (name.Length < 1L)
        {
            return DomainResult<Section>.Failure(Poly.Runtime.DomainFailure.Length("'Name' must be at least 1 characters.", "Section.Name"));
        }
        if (name.Length > 80L)
        {
            return DomainResult<Section>.Failure(Poly.Runtime.DomainFailure.Length("'Name' must be at most 80 characters.", "Section.Name"));
        }
        if (capacity < 1L)
        {
            return DomainResult<Section>.Failure(Poly.Runtime.DomainFailure.Range("'Capacity' must be >= 1.", "Section.Capacity"));
        }
        if (capacity > 2000L)
        {
            return DomainResult<Section>.Failure(Poly.Runtime.DomainFailure.Range("'Capacity' must be <= 2000.", "Section.Capacity"));
        }
        if (dayRate < 0m)
        {
            return DomainResult<Section>.Failure(Poly.Runtime.DomainFailure.Range("'DayRate' must be >= 0.", "Section.DayRate"));
        }
        if (dayRate > 100000m)
        {
            return DomainResult<Section>.Failure(Poly.Runtime.DomainFailure.Range("'DayRate' must be <= 100000.", "Section.DayRate"));
        }
        var created = new Section(name, capacity, dayRate, hall, occupied);
        if (hall != null)
        {
            hall.AttachSections(created);
        }
        return DomainResult<Section>.Success(created);
    }
}