#nullable enable
using System;
using System.Collections.Generic;

public enum SectionStage
{
    InService = 0
}

public class Section
{
    private Section()
    { }
    private Section(long capacity, long dayRate, string name, Hall? hall = null, bool occupied = false)
    {
        this.Capacity = capacity;
        this.DayRate = dayRate;
        this.Name = name;
        this.Occupied = occupied;
        this.Hall = hall;
        this.CurrentStage = SectionStage.InService;
    }
    public long Capacity { get; private set; }
    public long DayRate { get; private set; }
    public string Name { get; private set; } = default!;
    public bool Occupied { get; private set; }
    public Hall? Hall { get; private set; }
    public SectionStage CurrentStage { get; private set; }
    private DomainResult<Hall> CreateHall(long capacity, long dayRate, string name, Property? property, long busySections = 0L, bool occupied = false, bool offline = false)
    {
        var hallResult = Hall.Create(capacity, dayRate, name, property, new List<Section>(), busySections, occupied, offline);
        if (!hallResult.IsSuccess)
        {
            return DomainResult<Hall>.Failure(hallResult.ErrorMessage ?? "");
        }
        var hall = hallResult.Value;
        this.Hall = hall;
        return DomainResult<Hall>.Success(hall);
    }
    public DomainResult Occupy()
    {
        if (this.CurrentStage != SectionStage.InService)
        {
            return DomainResult.Failure("'Occupy' requires stage 'InService' on entity 'Section'.");
        }
        if (!this.CanBook())
        {
            return DomainResult.Failure("'Occupy' blocked by policy 'CanBook'.");
        }
        if (this.Hall == null)
        {
            return DomainResult.Failure("'Occupy' requires a linked 'hall' on entity 'Section'.");
        }
        if (!this.ParentFree())
        {
            return DomainResult.Failure("'Occupy' blocked by policy 'ParentFree'.");
        }
        this.Occupied = true;
        if (this.Hall == null)
        {
            return DomainResult.Failure("'MarkChildBusy' requires a linked 'hall' on entity 'Section'.");
        }
        var invoke0 = this.Hall.MarkChildBusy();
        if (!invoke0.IsSuccess)
        {
            return DomainResult.Failure(invoke0.ErrorMessage ?? "");
        }
        return DomainResult.Success();
    }
    public DomainResult Vacate()
    {
        if (this.CurrentStage != SectionStage.InService)
        {
            return DomainResult.Failure("'Vacate' requires stage 'InService' on entity 'Section'.");
        }
        if (!this.IsOccupied())
        {
            return DomainResult.Failure("'Vacate' blocked by policy 'IsOccupied'.");
        }
        this.Occupied = false;
        if (this.Hall == null)
        {
            return DomainResult.Failure("'ClearChildBusy' requires a linked 'hall' on entity 'Section'.");
        }
        var invoke0 = this.Hall.ClearChildBusy();
        if (!invoke0.IsSuccess)
        {
            return DomainResult.Failure(invoke0.ErrorMessage ?? "");
        }
        return DomainResult.Success();
    }
    public bool IsVacant() => !this.Occupied;
    public bool IsOccupied() => this.Occupied;
    public bool ParentFree() => this.Hall != null && (!this.Hall!.Occupied && !this.Hall!.Offline);
    public bool CanBook() => !this.Occupied;
    public static DomainResult<Section> Create(long capacity, long dayRate, string name, Hall? hall = null, bool occupied = false)
    {
        if (capacity < 1L)
        {
            return DomainResult<Section>.Failure("'Capacity' must be >= 1.");
        }
        if (capacity > 2000L)
        {
            return DomainResult<Section>.Failure("'Capacity' must be <= 2000.");
        }
        if (dayRate < 0L)
        {
            return DomainResult<Section>.Failure("'DayRate' must be >= 0.");
        }
        if (dayRate > 100000L)
        {
            return DomainResult<Section>.Failure("'DayRate' must be <= 100000.");
        }
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Section>.Failure("'Name' is required.");
        }
        if (name.Length < 1L)
        {
            return DomainResult<Section>.Failure("'Name' must be at least 1 characters.");
        }
        if (name.Length > 80L)
        {
            return DomainResult<Section>.Failure("'Name' must be at most 80 characters.");
        }
        var created = new Section(capacity, dayRate, name, hall, occupied);
        if (hall != null)
        {
            hall.AttachSections(created);
        }
        return DomainResult<Section>.Success(created);
    }
