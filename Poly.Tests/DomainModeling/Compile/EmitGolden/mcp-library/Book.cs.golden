#nullable enable
using Poly.Runtime;

public class Book
{
    private Book() { }
    private Book(string title, string isbn, long copies = 1L)
    {
        this.Title = title;
        this.Isbn = isbn;
        this.Copies = copies;
    }
    public string Title { get; private set; } = default!;
    public string Isbn { get; private set; } = default!;
    public long Copies { get; private set; }
    public static DomainResult<Book> Create(string title, string isbn, Poly.Runtime.IStoragePort db, long copies = 1L)
    {
        if (string.IsNullOrEmpty(title))
        {
            return DomainResult<Book>.Failure(Poly.Runtime.DomainFailure.Required("'Title' is required.", "Book.Title"));
        }
        if (string.IsNullOrEmpty(isbn))
        {
            return DomainResult<Book>.Failure(Poly.Runtime.DomainFailure.Required("'Isbn' is required.", "Book.Isbn"));
        }
        if (copies < 0L)
        {
            return DomainResult<Book>.Failure(Poly.Runtime.DomainFailure.Range("'Copies' must be >= 0.", "Book.Copies"));
        }
        if (copies > 1000L)
        {
            return DomainResult<Book>.Failure(Poly.Runtime.DomainFailure.Range("'Copies' must be <= 1000.", "Book.Copies"));
        }
        if (Book.ExistsWithIsbn(db, isbn))
        {
            return DomainResult<Book>.Failure(Poly.Runtime.DomainFailure.Unique("Unique constraint violated: 'Isbn' value is already used on another 'Book'.", "Book.Isbn"));
        }
        var created = new Book(title, isbn, copies);
        db.Record("Book", "Isbn", isbn);
        return DomainResult<Book>.Success(created);
    }
    public DomainResult EnsureUnique(string propertyName, object value)
    {
        if (value == null)
        {
            return DomainResult.Success();
        }
        if (propertyName == "Isbn" && object.Equals(this.Isbn, value))
        {
            return DomainResult.Success();
        }
        return DomainResult.Failure("A unique assign needs the storage port.");
    }
    public static System.Boolean ExistsWithIsbn(Poly.Runtime.IStoragePort db, System.String isbn) => db.Exists("Book", "Isbn", isbn);
}