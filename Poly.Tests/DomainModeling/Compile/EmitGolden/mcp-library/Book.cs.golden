#nullable enable
public class Book
{
    private Book() { }
    private Book(string isbn, string title, long copies = 1L)
    {
        this.Isbn = isbn;
        this.Title = title;
        this.Copies = copies;
    }
    public long Copies { get; private set; }
    public string Isbn { get; private set; } = default!;
    public string Title { get; private set; } = default!;
    public static DomainResult<Book> Create(string isbn, string title, Poly.DomainModeling.Runtime.IStoragePort db, long copies = 1L)
    {
        if (copies < 0L)
        {
            return DomainResult<Book>.Failure("'Copies' must be >= 0.");
        }
        if (copies > 1000L)
        {
            return DomainResult<Book>.Failure("'Copies' must be <= 1000.");
        }
        if (string.IsNullOrEmpty(isbn))
        {
            return DomainResult<Book>.Failure("'Isbn' is required.");
        }
        if (string.IsNullOrEmpty(title))
        {
            return DomainResult<Book>.Failure("'Title' is required.");
        }
        if (Book.ExistsWithIsbn(db, isbn))
        {
            return DomainResult<Book>.Failure("Unique constraint violated: 'Isbn' value is already used on another 'Book'.");
        }
        var created = new Book(isbn, title, copies);
        var uniqueCheck = Book.CheckUnique("Isbn", isbn);
        if (!uniqueCheck.IsSuccess)
        {
            return DomainResult<Book>.Failure(uniqueCheck.ErrorMessage ?? "");
        }
        Poly.DomainModeling.Runtime.DomainInstanceStore.PrintedRecord("Book", "Isbn", isbn);
        db.Record("Book", "Isbn", isbn);
        return DomainResult<Book>.Success(created);
    }
    private static DomainResult CheckUnique(string propertyName, object value)
    {
        if (value == null)
        {
            return DomainResult.Success();
        }
        var message = Poly.DomainModeling.Runtime.DomainInstanceStore.PrintedCollision("Book", propertyName, value.ToString());
        if (message != null)
        {
            return DomainResult.Failure(message);
        }
        return DomainResult.Success();
    }
    public DomainResult EnsureUnique(string propertyName, object value)
    {
        if (value == null)
        {
            return DomainResult.Success();
        }
        if (propertyName == "Isbn" && object.Equals(this.Isbn, value))
        {
            return DomainResult.Success();
        }
        return Book.CheckUnique(propertyName, value);
    }
    public static System.Boolean ExistsWithIsbn(Poly.DomainModeling.Runtime.IStoragePort db, System.String isbn) => db.Exists("Book", "Isbn", isbn);
}