public enum FineStage
{
    Resolved = 0,
    Paid = 1
}

public class Fine
{
    private Fine()
    { }
    private Fine(string reason, long amount = 0L)
    {
        this.Amount = amount;
        this.Reason = reason;
        this.CurrentStage = FineStage.Resolved;
    }
    public long Amount { get; private set; }
    public string Reason { get; private set; } = default!;
    public FineStage CurrentStage { get; private set; }
    public DomainResult Resolve()
    {
        if (this.CurrentStage != FineStage.Resolved)
        {
            return DomainResult.Failure("'Resolve' requires stage 'Resolved' on entity 'Fine'.");
        }
        this.CurrentStage = FineStage.Paid;
        return DomainResult.Success();
    }
    public static DomainResult<Fine> Create(string reason, long amount = 0L)
    {
        if (amount < 0L)
        {
            return DomainResult<Fine>.Failure("'Amount' must be >= 0.");
        }
        if (amount > 500L)
        {
            return DomainResult<Fine>.Failure("'Amount' must be <= 500.");
        }
        var created = new Fine(reason, amount);
        return DomainResult<Fine>.Success(created);
    }
