#nullable enable
using System;
using System.Collections.Generic;

public enum LoanStage
{
    Active = 0,
    Overdue = 1,
    Returned = 2
}

public class Loan
{
    private List<Patron>? _patronOverdueSubscribers;
    private Loan()
    { }
    private Loan(Book? book = null, long amount = 0L)
    {
        this.Amount = amount;
        this.Book = book;
        this.CurrentStage = LoanStage.Active;
    }
    public long Amount { get; private set; }
    public Book? Book { get; private set; }
    public LoanStage CurrentStage { get; private set; }
    private DomainResult<Book> CreateBook(string isbn, string title, long copies = 1L)
    {
        var bookResult = Book.Create(isbn, title, copies);
        if (!bookResult.IsSuccess)
        {
            return DomainResult<Book>.Failure(bookResult.ErrorMessage ?? "");
        }
        var book = bookResult.Value;
        this.Book = book;
        return DomainResult<Book>.Success(book);
    }
    public DomainResult MarkOverdue()
    {
        if (this.CurrentStage != LoanStage.Active)
        {
            return DomainResult.Failure("'MarkOverdue' requires stage 'Active' on entity 'Loan'.");
        }
        var previousStage0 = this.CurrentStage;
        this.CurrentStage = LoanStage.Overdue;
        this.NotifyOverdueSubscribers(previousStage0);
        return DomainResult.Success();
    }
    public DomainResult Return()
    {
        if (this.CurrentStage != LoanStage.Overdue)
        {
            return DomainResult.Failure("'Return' requires stage 'Overdue' on entity 'Loan'.");
        }
        var assignValue0 = 0L;
        if (assignValue0 < 0L)
        {
            return DomainResult.Failure("'Amount' must be >= 0.");
        }
        if (assignValue0 > 500L)
        {
            return DomainResult.Failure("'Amount' must be <= 500.");
        }
        this.Amount = assignValue0;
        this.CurrentStage = LoanStage.Returned;
        return DomainResult.Success();
    }
    internal void RegisterPatronOverdueSubscriber(Patron subscriber)
    {
        if (this._patronOverdueSubscribers == null)
        {
            this._patronOverdueSubscribers = new List<Patron>();
        }
        this._patronOverdueSubscribers.Add(subscriber);
    }
    internal void NotifyOverdueSubscribers(LoanStage previousStage)
    {
        if (this._patronOverdueSubscribers != null)
        {
            foreach (var sub in this._patronOverdueSubscribers)
            {
                sub.WhenEachLoanOverdue(this);
            }
        }
    }
    public static DomainResult<Loan> Create(Book? book = null, long amount = 0L)
    {
        if (amount < 0L)
        {
            return DomainResult<Loan>.Failure("'Amount' must be >= 0.");
        }
        if (amount > 500L)
        {
            return DomainResult<Loan>.Failure("'Amount' must be <= 500.");
        }
        var created = new Loan(book, amount);
        return DomainResult<Loan>.Success(created);
    }
