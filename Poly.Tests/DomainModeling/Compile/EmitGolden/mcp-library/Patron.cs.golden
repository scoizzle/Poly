            var typed = Book.Create((values.ContainsKey("Isbn") ? (string?)values["Isbn"] ?? "" : ""), (values.ContainsKey("Title") ? (string?)values["Title"] ?? "" : ""), (values.ContainsKey("Copies") ? (long?)values["Copies"] ?? 0L : 0L));
