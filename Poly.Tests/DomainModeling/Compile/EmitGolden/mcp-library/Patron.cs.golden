#nullable enable
using System.Collections.Generic;

using Poly.DomainModeling.Runtime;
using Poly.Runtime;

public class Patron : Poly.Runtime.IActionScoped
{
    private List<Loan> _loans = new List<Loan>();
    private List<Fine> _fines = new List<Fine>();
    private Patron() { }
    private Patron(string name, IEnumerable<Loan>? loans = null, IEnumerable<Fine>? fines = null, string status = "Active")
    {
        this.Name = name;
        this.Status = status;
        this._loans = new List<Loan>(loans ?? new List<Loan>());
        this._fines = new List<Fine>(fines ?? new List<Fine>());
        this.InitializeSubscriptions();
    }
    public string Name { get; private set; } = default!;
    public string Status { get; private set; } = default!;
    public IReadOnlyList<Loan> Loans
    {
        get => this._loans;
    }
    public IReadOnlyList<Fine> Fines
    {
        get => this._fines;
    }
    public DomainResult<Loan> CreateLoans(Book? book = null, long amount = 0L)
    {
        var loanResult = Loan.Create(book, amount);
        if (!loanResult.IsSuccess)
        {
            return DomainResult<Loan>.Failure(loanResult.Error!);
        }
        var loan = loanResult.Value;
        this._loans.Add(loan);
        loan.RegisterPatronLoansOverdueSubscriber(this);
        return DomainResult<Loan>.Success(loan);
    }
    internal void AttachLoans(Loan child)
    {
        this._loans.Add(child);
        child.RegisterPatronLoansOverdueSubscriber(this);
    }
    public DomainResult<Fine> CreateFines(string reason, long amount = 0L)
    {
        var fineResult = Fine.Create(reason, amount);
        if (!fineResult.IsSuccess)
        {
            return DomainResult<Fine>.Failure(fineResult.Error!);
        }
        var fine = fineResult.Value;
        this._fines.Add(fine);
        return DomainResult<Fine>.Success(fine);
    }
    internal void AttachFines(Fine child)
    {
        this._fines.Add(child);
    }
    public DomainResult<Loan> CheckOut(Book book)
    {
        var __scope = (Poly.Runtime.ActionScopeToken)Poly.Runtime.ActionScope.Begin(null);
        var __done = false;
        try
        {
            var __result = this.__BodyOfCheckOut(book);
            if (!__result.IsSuccess)
            {
                return __result;
            }
            Poly.Runtime.ActionScope.Commit(__scope);
            __done = true;
            return __result;
        }
        finally
        {
            if (!__done)
            {
                Poly.Runtime.ActionScope.Rollback(__scope);
            }
        }
    }
    private DomainResult<Loan> __BodyOfCheckOut(Book book)
    {
        if (!this.GoodStanding())
        {
            return DomainResult<Loan>.Failure(Poly.Runtime.DomainFailure.Policy("'CheckOut' blocked by policy 'GoodStanding'.", "Patron.CheckOut", "GoodStanding"));
        }
        var create0 = this.CreateLoans(book);
        if (!create0.IsSuccess)
        {
            return DomainResult<Loan>.Failure(create0.Error!.At("Patron.CheckOut"));
        }
        var created1 = create0.Value;
        return DomainResult<Loan>.Success(created1);
    }
    public bool GoodStanding() => this.Status == "Active";
    internal void WhenEachLoanOverdue(Loan loan)
    {
        var create0 = this.CreateFines("Overdue", loan.Amount);
        if (!create0.IsSuccess)
        {
            throw new ConstraintFailureException(create0.ErrorMessage ?? "");
        }
    }
    public static DomainResult<Patron> Create(string name, IEnumerable<Loan>? loans = null, IEnumerable<Fine>? fines = null, string status = "Active")
    {
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Patron>.Failure(Poly.Runtime.DomainFailure.Required("'Name' is required.", "Patron.Name"));
        }
        var created = new Patron(name, loans, fines, status);
        return DomainResult<Patron>.Success(created);
    }
    private void InitializeSubscriptions()
    {
        foreach (var target in this.Loans)
        {
            target.RegisterPatronLoansOverdueSubscriber(this);
        }
    }
    public object __Snapshot()
    {
        var __state = new object?[4];
        __state[0] = this.Name;
        __state[1] = this.Status;
        __state[2] = new List<Loan>(this._loans);
        __state[3] = new List<Fine>(this._fines);
        return __state;
    }
    public void __Restore(object state)
    {
        var __saved = (object?[])state;
        this.Name = (string)__saved[0]!;
        this.Status = (string)__saved[1]!;
        ((System.Collections.IList)this._loans).Clear();
        foreach (var __item2 in(List<Loan>)__saved[2]!)
        {
            this._loans.Add(__item2);
        }
        ((System.Collections.IList)this._fines).Clear();
        foreach (var __item3 in(List<Fine>)__saved[3]!)
        {
            this._fines.Add(__item3);
        }
    }
}