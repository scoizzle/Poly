    private DomainResult<object> BindCreate(string typeName, Dictionary<string, object> values)
    {
        if (typeName == "Customer")
        {
            var typed = Customer.Create((values.ContainsKey("Email") ? (string?)values["Email"] ?? "" : ""), (values.ContainsKey("Name") ? (string?)values["Name"] ?? "" : ""), new List<Order>(), (values.ContainsKey("Tier") ? (string?)values["Tier"] ?? "" : ""));
            if (!typed.IsSuccess)
            {
                return DomainResult<object>.Failure(typed.ErrorMessage ?? "");
            }
            else
            {
                return DomainResult<object>.Success(typed.Value);
            }
        }
        if (typeName == "Order")
        {
            var typed = Order.Create((values.ContainsKey("CancelReason") ? (string?)values["CancelReason"] ?? "" : ""), (values.ContainsKey("Discount") ? (long?)values["Discount"] ?? 0L : 0L), (values.ContainsKey("Total") ? (long?)values["Total"] ?? 0L : 0L), (values.ContainsKey("customer") ? (Customer?)values["customer"] ?? null : null), new List<OrderItem>(), (values.ContainsKey("State") ? (OrderState?)values["State"] ?? OrderState.Pending : OrderState.Pending));
            if (!typed.IsSuccess)
            {
                return DomainResult<object>.Failure(typed.ErrorMessage ?? "");
            }
            else
            {
                return DomainResult<object>.Success(typed.Value);
            }
        }
        if (typeName == "OrderItem")
        {
            var typed = OrderItem.Create((values.ContainsKey("Qty") ? (long?)values["Qty"] ?? 0L : 0L), (values.ContainsKey("Sku") ? (string?)values["Sku"] ?? "" : ""), (values.ContainsKey("order") ? (Order?)values["order"] ?? null : null));
            if (!typed.IsSuccess)
            {
                return DomainResult<object>.Failure(typed.ErrorMessage ?? "");
            }
            else
            {
                return DomainResult<object>.Success(typed.Value);
            }
        }
        return DomainResult<object>.Failure("Unknown type '" + typeName + "'.");
    }
    private DomainResult<object> BindCreateIn(string relationshipName, Dictionary<string, object> values)
    {
        if (relationshipName == "orders")
        {
            var typed = this.CreateOrders((values.ContainsKey("CancelReason") ? (string?)values["CancelReason"] ?? "" : ""), (values.ContainsKey("Discount") ? (long?)values["Discount"] ?? 0L : 0L), (values.ContainsKey("Total") ? (long?)values["Total"] ?? 0L : 0L), (values.ContainsKey("State") ? (OrderState?)values["State"] ?? OrderState.Pending : OrderState.Pending));
            if (!typed.IsSuccess)
