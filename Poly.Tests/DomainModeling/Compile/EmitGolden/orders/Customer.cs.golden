#nullable enable
using System;
using System.Collections.Generic;

public class Customer
{
    private List<Order> _orders;
    private Customer()
    {
        this._orders = new List<Order>();
    }
    private Customer(string email, string name, IEnumerable<Order>? orders = null, string tier = "standard")
    {
        this.Email = email;
        this.Name = name;
        this.Tier = tier;
        this._orders = new List<Order>(orders ?? new List<Order>());
    }
    public string Email { get; private set; } = default!;
    public string Name { get; private set; } = default!;
    public string Tier { get; private set; } = default!;
    public IReadOnlyList<Order> Orders
    {
        get => this._orders;
    }
    internal void AttachOrders(Order child)
    {
        this._orders.Add(child);
    }
    public DomainResult ShipAll()
    {
        var matched1 = false;
        foreach (var target0 in this.Orders)
        {
            if (!target0.IsPaid())
            {
                continue;
            }
            matched1 = true;
            var result2 = target0.Ship();
            if (!result2.IsSuccess)
            {
                return DomainResult.Failure(result2.ErrorMessage ?? "");
            }
        }
        if (!matched1)
        {
            return DomainResult.Failure("for orders.Ship matched zero targets.");
        }
        return DomainResult.Success();
    }
    public DomainResult CancelPending()
    {
        var matched1 = false;
        foreach (var target0 in this.Orders)
        {
            if (!(target0.CurrentStage == OrderStage.Pending))
            {
                continue;
            }
            matched1 = true;
            var result2 = target0.Cancel("customer request");
            if (!result2.IsSuccess)
            {
                return DomainResult.Failure(result2.ErrorMessage ?? "");
            }
        }
        if (!matched1)
        {
            return DomainResult.Failure("for orders.Cancel matched zero targets.");
        }
        return DomainResult.Success();
    }
    public static DomainResult<Customer> Create(string email, string name, IEnumerable<Order>? orders = null, string tier = "standard")
    {
        if (string.IsNullOrEmpty(email))
        {
            return DomainResult<Customer>.Failure("'Email' is required.");
        }
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Customer>.Failure("'Name' is required.");
        }
        if (name.Length < 2L)
        {
            return DomainResult<Customer>.Failure("'Name' must be at least 2 characters.");
        }
        if (name.Length > 100L)
        {
            return DomainResult<Customer>.Failure("'Name' must be at most 100 characters.");
        }
        var created = new Customer(email, name, orders, tier);
        return DomainResult<Customer>.Success(created);
    }
    public DomainResult EnsureUnique(string propertyName, object @value) => DomainResult.Success();
}