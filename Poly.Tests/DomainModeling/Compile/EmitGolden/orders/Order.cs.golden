#nullable enable
using System;
using System.Collections.Generic;

public enum OrderStage
{
    Pending = 0,
    Paid = 1,
    Shipped = 2,
    Delivered = 3,
    Cancelled = 4
}

public class Order
{
    private List<OrderItem> _items;
    private Order()
    {
        this._items = new List<OrderItem>();
    }
    private Order(string cancelReason, long discount, long total, Customer? customer = null, IEnumerable<OrderItem>? items = null, OrderState state = OrderState.Pending)
    {
        this.CancelReason = cancelReason;
        this.Discount = discount;
        this.State = state;
        this.Total = total;
        this.Customer = customer;
        this._items = new List<OrderItem>(items ?? new List<OrderItem>());
        this.CurrentStage = OrderStage.Pending;
    }
    public string CancelReason { get; private set; } = default!;
    public long Discount { get; private set; }
    public OrderState State { get; private set; }
    public long Total { get; private set; }
    public Customer? Customer { get; private set; }
    public IReadOnlyList<OrderItem> Items
    {
        get => this._items;
    }
    public OrderStage CurrentStage { get; private set; }
    private DomainResult<Customer> CreateCustomer(string email, string name, string tier = "standard")
    {
        var customerResult = Customer.Create(email, name, new List<Order>(), tier);
        if (!customerResult.IsSuccess)
        {
            return DomainResult<Customer>.Failure(customerResult.ErrorMessage ?? "");
        }
        var customer = customerResult.Value;
        this.Customer = customer;
        return DomainResult<Customer>.Success(customer);
    }
    private DomainResult<OrderItem> CreateItems(long qty, string sku)
    {
        var orderItemResult = OrderItem.Create(qty, sku, this);
        if (!orderItemResult.IsSuccess)
        {
            return DomainResult<OrderItem>.Failure(orderItemResult.ErrorMessage ?? "");
        }
        var orderItem = orderItemResult.Value;
        return DomainResult<OrderItem>.Success(orderItem);
    }
    internal void AttachItems(OrderItem child)
    {
        this._items.Add(child);
    }
    public DomainResult Ship()
    {
        this.CurrentStage = OrderStage.Shipped;
        return DomainResult.Success();
    }
    public DomainResult Cancel(string reason)
    {
        var assignValue0 = reason;
        if (!System.String.IsNullOrEmpty(assignValue0))
        {
            if (assignValue0.Length > 200L)
            {
                return DomainResult.Failure("'CancelReason' must be at most 200 characters.");
            }
        }
        this.CancelReason = assignValue0;
        this.CurrentStage = OrderStage.Cancelled;
        return DomainResult.Success();
    }
    public DomainResult ApplyDiscount(long amount)
    {
        var assignValue0 = amount;
        if (assignValue0 < 0L)
        {
            return DomainResult.Failure("'Discount' must be >= 0.");
        }
        if (assignValue0 > 100L)
        {
            return DomainResult.Failure("'Discount' must be <= 100.");
        }
        this.Discount = assignValue0;
        return DomainResult.Success();
    }
    public DomainResult Pay()
    {
        if (this.CurrentStage != OrderStage.Pending)
        {
            return DomainResult.Failure("'Pay' requires stage 'Pending' on entity 'Order'.");
        }
        this.CurrentStage = OrderStage.Paid;
        return DomainResult.Success();
    }
    public bool IsPaid() => this.State == OrderState.Paid;
    public static DomainResult<Order> Create(string cancelReason, long discount, long total, Customer? customer = null, IEnumerable<OrderItem>? items = null, OrderState state = OrderState.Pending)
    {
        if (cancelReason.Length > 200L)
        {
            return DomainResult<Order>.Failure("'CancelReason' must be at most 200 characters.");
        }
        if (discount < 0L)
        {
            return DomainResult<Order>.Failure("'Discount' must be >= 0.");
        }
        if (discount > 100L)
        {
            return DomainResult<Order>.Failure("'Discount' must be <= 100.");
        }
        if (state != OrderState.Pending && state != OrderState.Paid && state != OrderState.Shipped && state != OrderState.Delivered && state != OrderState.Cancelled)
        {
            return DomainResult<Order>.Failure("'State' is not a valid member of OrderState.");
        }
        if (total < 0L)
        {
            return DomainResult<Order>.Failure("'Total' must be >= 0.");
        }
        if (total > 100000L)
        {
            return DomainResult<Order>.Failure("'Total' must be <= 100000.");
        }
        var created = new Order(cancelReason, discount, total, customer, items, state);
        if (customer != null)
        {
            customer.AttachOrders(created);
        }
        return DomainResult<Order>.Success(created);
    }
    public DomainResult EnsureUnique(string propertyName, object value) => DomainResult.Success();
