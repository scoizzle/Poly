#nullable enable
using System.Collections.Generic;

using Poly.Runtime;

public enum OrderStage
{
    Pending = 0,
    Paid = 1,
    Shipped = 2,
    Delivered = 3,
    Cancelled = 4
}

public class Order
{
    private List<OrderItem> _items = new List<OrderItem>();
    private Order() { }
    private Order(decimal total, decimal discount, string cancelReason = "", Customer? customer = null, IEnumerable<OrderItem>? items = null, OrderState state = OrderState.Pending)
    {
        this.Total = total;
        this.Discount = discount;
        this.CancelReason = cancelReason;
        this.State = state;
        this.Customer = customer;
        this._items = new List<OrderItem>(items ?? new List<OrderItem>());
        this.CurrentStage = OrderStage.Pending;
    }
    public decimal Total { get; private set; }
    public decimal Discount { get; private set; }
    public OrderState State { get; private set; }
    public string CancelReason { get; private set; } = default!;
    public Customer? Customer { get; private set; }
    public IReadOnlyList<OrderItem> Items
    {
        get => this._items;
    }
    public OrderStage CurrentStage { get; private set; }
    internal void AttachItems(OrderItem child)
    {
        this._items.Add(child);
    }
    public DomainResult Cancel(string reason)
    {
        var assignValue0 = reason;
        if (System.String.IsNullOrEmpty(assignValue0))
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Required("'CancelReason' is required.", "Order.CancelReason"));
        }
        if (assignValue0.Length > 200L)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Length("'CancelReason' must be at most 200 characters.", "Order.CancelReason"));
        }
        this.CancelReason = assignValue0;
        this.CurrentStage = OrderStage.Cancelled;
        this.State = OrderState.Cancelled;
        return DomainResult.Success();
    }
    public DomainResult ApplyDiscount(long amount)
    {
        var assignValue0 = amount;
        if (assignValue0 < 0m)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Range("'Discount' must be >= 0.", "Order.Discount"));
        }
        if (assignValue0 > 100m)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Range("'Discount' must be <= 100.", "Order.Discount"));
        }
        this.Discount = assignValue0;
        return DomainResult.Success();
    }
    public DomainResult Pay()
    {
        if (this.CurrentStage != OrderStage.Pending)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'Pay' requires stage 'Pending' on entity 'Order'.", "Order.Pay", "Pending"));
        }
        this.CurrentStage = OrderStage.Paid;
        this.State = OrderState.Paid;
        return DomainResult.Success();
    }
    public DomainResult Ship()
    {
        if (this.CurrentStage != OrderStage.Paid)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'Ship' requires stage 'Paid' on entity 'Order'.", "Order.Ship", "Paid"));
        }
        this.CurrentStage = OrderStage.Shipped;
        this.State = OrderState.Shipped;
        return DomainResult.Success();
    }
    public bool IsPaid() => this.State == OrderState.Paid;
    public static DomainResult<Order> Create(decimal total, decimal discount, string cancelReason = "", Customer? customer = null, IEnumerable<OrderItem>? items = null, OrderState state = OrderState.Pending)
    {
        if (total < 0m)
        {
            return DomainResult<Order>.Failure(Poly.Runtime.DomainFailure.Range("'Total' must be >= 0.", "Order.Total"));
        }
        if (total > 100000m)
        {
            return DomainResult<Order>.Failure(Poly.Runtime.DomainFailure.Range("'Total' must be <= 100000.", "Order.Total"));
        }
        if (discount < 0m)
        {
            return DomainResult<Order>.Failure(Poly.Runtime.DomainFailure.Range("'Discount' must be >= 0.", "Order.Discount"));
        }
        if (discount > 100m)
        {
            return DomainResult<Order>.Failure(Poly.Runtime.DomainFailure.Range("'Discount' must be <= 100.", "Order.Discount"));
        }
        if (state != OrderState.Pending && state != OrderState.Paid && state != OrderState.Shipped && state != OrderState.Delivered && state != OrderState.Cancelled)
        {
            return DomainResult<Order>.Failure(Poly.Runtime.DomainFailure.Enum(string.Concat("'", state, "' is not a valid member of OrderState for property 'State'."), "Order.State"));
        }
        if (string.IsNullOrEmpty(cancelReason))
        {
            return DomainResult<Order>.Failure(Poly.Runtime.DomainFailure.Required("'CancelReason' is required.", "Order.CancelReason"));
        }
        if (cancelReason.Length > 200L)
        {
            return DomainResult<Order>.Failure(Poly.Runtime.DomainFailure.Length("'CancelReason' must be at most 200 characters.", "Order.CancelReason"));
        }
        var created = new Order(total, discount, cancelReason, customer, items, state);
        if (customer != null)
        {
            customer.AttachOrders(created);
        }
        return DomainResult<Order>.Success(created);
    }
}