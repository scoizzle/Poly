#nullable enable
using Poly.Runtime;

public class OrderItem
{
    private OrderItem() { }
    private OrderItem(string sku, long qty, Order? order = null)
    {
        this.Sku = sku;
        this.Qty = qty;
        this.Order = order;
    }
    public string Sku { get; private set; } = default!;
    public long Qty { get; private set; }
    public Order? Order { get; private set; }
    public static DomainResult<OrderItem> Create(string sku, long qty, Order? order = null)
    {
        if (string.IsNullOrEmpty(sku))
        {
            return DomainResult<OrderItem>.Failure("'Sku' is required.");
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(sku, "^[A-Z]{3}-[0-9]{4}\\z"))
        {
            return DomainResult<OrderItem>.Failure("'Sku' does not match the required pattern.");
        }
        if (qty < 1L)
        {
            return DomainResult<OrderItem>.Failure("'Qty' must be >= 1.");
        }
        if (qty > 1000L)
        {
            return DomainResult<OrderItem>.Failure("'Qty' must be <= 1000.");
        }
        var created = new OrderItem(sku, qty, order);
        if (order != null)
        {
            order.AttachItems(created);
        }
        return DomainResult<OrderItem>.Success(created);
    }
}