#nullable enable
using System;
using System.Collections.Generic;

public class OrderItem
{
    private OrderItem()
    { }
    private OrderItem(long qty, string sku, Order? order = null)
    {
        this.Qty = qty;
        this.Sku = sku;
        this.Order = order;
    }
    public long Qty { get; private set; }
    public string Sku { get; private set; } = default!;
    public Order? Order { get; private set; }
    private DomainResult<Order> CreateOrder(string cancelReason, long discount, long total, Customer? customer, OrderState state = OrderState.Pending)
    {
        var orderResult = Order.Create(cancelReason, discount, total, customer, new List<OrderItem>(), state);
        if (!orderResult.IsSuccess)
        {
            return DomainResult<Order>.Failure(orderResult.ErrorMessage ?? "");
        }
        var order = orderResult.Value;
        this.Order = order;
        return DomainResult<Order>.Success(order);
    }
    public static DomainResult<OrderItem> Create(long qty, string sku, Order? order = null)
    {
        if (qty < 1L)
        {
            return DomainResult<OrderItem>.Failure("'Qty' must be >= 1.");
        }
        if (qty > 1000L)
        {
            return DomainResult<OrderItem>.Failure("'Qty' must be <= 1000.");
        }
        if (string.IsNullOrEmpty(sku))
        {
            return DomainResult<OrderItem>.Failure("'Sku' is required.");
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(sku, "^[A-Z]{3}-[0-9]{4}$"))
        {
            return DomainResult<OrderItem>.Failure("'Sku' does not match the required pattern.");
        }
        var created = new OrderItem(qty, sku, order);
        if (order != null)
        {
            order.AttachItems(created);
        }
        return DomainResult<OrderItem>.Success(created);
    }
