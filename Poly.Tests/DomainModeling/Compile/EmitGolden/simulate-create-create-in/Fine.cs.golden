#nullable enable
using Poly.Runtime;

public class Fine
{
    private Fine(long amount, string reason, Patron? patron = null)
    {
        this.Amount = amount;
        this.Reason = reason;
        this.Patron = patron;
    }
    public long Amount { get; private set; }
    public string Reason { get; private set; } = default!;
    public Patron? Patron { get; private set; }
    public static DomainResult<Fine> Create(long amount, string reason, Patron? patron = null)
    {
        if (amount < 0L)
        {
            return DomainResult<Fine>.Failure(Poly.Runtime.DomainFailure.Range("'Amount' must be >= 0.", "Fine.Amount"));
        }
        if (amount > 500L)
        {
            return DomainResult<Fine>.Failure(Poly.Runtime.DomainFailure.Range("'Amount' must be <= 500.", "Fine.Amount"));
        }
        if (string.IsNullOrEmpty(reason))
        {
            return DomainResult<Fine>.Failure(Poly.Runtime.DomainFailure.Required("'Reason' is required.", "Fine.Reason"));
        }
        var created = new Fine(amount, reason, patron);
        if (patron != null)
        {
            patron.AttachFines(created);
        }
        return DomainResult<Fine>.Success(created);
    }
}