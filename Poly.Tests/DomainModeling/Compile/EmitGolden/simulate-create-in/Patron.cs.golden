#nullable enable
using System.Collections.Generic;

public class Patron
{
    private List<Fine> _fines = new List<Fine>();
    private Patron(string name, IEnumerable<Fine>? fines = null)
    {
        this.Name = name;
        this._fines = new List<Fine>(fines ?? new List<Fine>());
    }
    public string Name { get; private set; } = default!;
    public IReadOnlyList<Fine> Fines
    {
        get => this._fines;
    }
    public DomainResult<Fine> CreateFines(long amount, string reason)
    {
        var fineResult = Fine.Create(amount, reason, this);
        if (!fineResult.IsSuccess)
        {
            return DomainResult<Fine>.Failure(fineResult.ErrorMessage ?? "");
        }
        var fine = fineResult.Value;
        return DomainResult<Fine>.Success(fine);
    }
    internal void AttachFines(Fine child)
    {
        this._fines.Add(child);
    }
    public DomainResult<Fine> AssessByRel()
    {
        var create0 = this.CreateFines(5L, "CreateIn");
        if (!create0.IsSuccess)
        {
            return DomainResult<Fine>.Failure(create0.ErrorMessage ?? "");
        }
        var created1 = create0.Value;
        return DomainResult<Fine>.Success(created1);
    }
    public bool HasFines() => this.Fines.Count != 0;
    public bool HasFineCount() => this.Fines.Count > 0;
    public bool NoFines() => this.Fines.Count == 0;
    public static DomainResult<Patron> Create(string name, IEnumerable<Fine>? fines = null)
    {
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Patron>.Failure("'Name' is required.");
        }
        var created = new Patron(name, fines);
        return DomainResult<Patron>.Success(created);
    }
}