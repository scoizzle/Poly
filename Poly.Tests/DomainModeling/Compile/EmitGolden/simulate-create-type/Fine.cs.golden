public class Fine
{
    private Fine()
    { }
    private Fine(long amount, string reason, Patron? patron = null)
    {
        this.Amount = amount;
        this.Reason = reason;
        this.Patron = patron;
    }
    public long Amount { get; private set; }
    public string Reason { get; private set; } = default!;
    public Patron? Patron { get; private set; }
    private DomainResult<Patron> CreatePatron(string name)
    {
        var patronResult = Patron.Create(name, new List<Fine>());
        if (!patronResult.IsSuccess)
        {
            return DomainResult<Patron>.Failure(patronResult.ErrorMessage ?? "");
        }
        var patron = patronResult.Value;
        this.Patron = patron;
        return DomainResult<Patron>.Success(patron);
    }
    public static DomainResult<Fine> Create(long amount, string reason, Patron? patron = null)
    {
        if (amount < 0L)
        {
            return DomainResult<Fine>.Failure("'Amount' must be >= 0.");
        }
        if (amount > 500L)
        {
            return DomainResult<Fine>.Failure("'Amount' must be <= 500.");
        }
        if (string.IsNullOrEmpty(reason))
        {
            return DomainResult<Fine>.Failure("'Reason' is required.");
        }
        var created = new Fine(amount, reason, patron);
        if (patron != null)
        {
            patron.AttachFines(created);
        }
        return DomainResult<Fine>.Success(created);
    }
    public DomainResult EnsureUnique(string propertyName, object value) => DomainResult.Success();
