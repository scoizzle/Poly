#nullable enable
public class Course
{
    private Course(string code, string title)
    {
        this.Code = code;
        this.Title = title;
    }
    public string Code { get; private set; } = default!;
    public string Title { get; private set; } = default!;
    public static DomainResult<Course> Create(string code, string title)
    {
        if (string.IsNullOrEmpty(code))
        {
            return DomainResult<Course>.Failure("'Code' is required.");
        }
        if (code.Length < 3L)
        {
            return DomainResult<Course>.Failure("'Code' must be at least 3 characters.");
        }
        if (code.Length > 12L)
        {
            return DomainResult<Course>.Failure("'Code' must be at most 12 characters.");
        }
        if (string.IsNullOrEmpty(title))
        {
            return DomainResult<Course>.Failure("'Title' is required.");
        }
        var created = new Course(code, title);
        var uniqueCheck = Course.CheckUnique("Code", code);
        if (!uniqueCheck.IsSuccess)
        {
            return DomainResult<Course>.Failure(uniqueCheck.ErrorMessage ?? "");
        }
        Poly.DomainModeling.Runtime.DomainInstanceStore.PrintedRecord("Course", "Code", code);
        return DomainResult<Course>.Success(created);
    }
    private static DomainResult CheckUnique(string propertyName, object value)
    {
        if (value == null)
        {
            return DomainResult.Success();
        }
        var message = Poly.DomainModeling.Runtime.DomainInstanceStore.PrintedCollision("Course", propertyName, value.ToString());
        if (message != null)
        {
            return DomainResult.Failure(message);
        }
        return DomainResult.Success();
    }
    public DomainResult EnsureUnique(string propertyName, object value)
    {
        if (value == null)
        {
            return DomainResult.Success();
        }
        if (propertyName == "Code" && object.Equals(this.Code, value))
        {
            return DomainResult.Success();
        }
        return Course.CheckUnique(propertyName, value);
    }
}