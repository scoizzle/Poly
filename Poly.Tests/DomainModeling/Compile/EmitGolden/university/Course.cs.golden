    private DomainResult<object> BindCreate(string typeName, Dictionary<string, object> values)
    {
        if (typeName == "Instructor")
        {
            var typed = Instructor.Create((values.ContainsKey("Email") ? (string?)values["Email"] ?? "" : ""), (values.ContainsKey("Name") ? (string?)values["Name"] ?? "" : ""));
            if (!typed.IsSuccess)
            {
                return DomainResult<object>.Failure(typed.ErrorMessage ?? "");
            }
            else
            {
                return DomainResult<object>.Success(typed.Value);
            }
        }
        if (typeName == "Course")
        {
            var typed = Course.Create((values.ContainsKey("Code") ? (string?)values["Code"] ?? "" : ""), (values.ContainsKey("Title") ? (string?)values["Title"] ?? "" : ""));
            if (!typed.IsSuccess)
            {
                return DomainResult<object>.Failure(typed.ErrorMessage ?? "");
            }
            else
            {
                return DomainResult<object>.Success(typed.Value);
            }
        }
        if (typeName == "Student")
        {
            var typed = Student.Create((values.ContainsKey("Email") ? (string?)values["Email"] ?? "" : ""), (values.ContainsKey("Name") ? (string?)values["Name"] ?? "" : ""), new List<Enrollment>(), (values.ContainsKey("Completions") ? (long?)values["Completions"] ?? 0L : 0L), (values.ContainsKey("Holds") ? (long?)values["Holds"] ?? 0L : 0L), (values.ContainsKey("LastGrade") ? (long?)values["LastGrade"] ?? 0L : 0L), (values.ContainsKey("MaxCredits") ? (long?)values["MaxCredits"] ?? 0L : 0L), (values.ContainsKey("OpenCredits") ? (long?)values["OpenCredits"] ?? 0L : 0L));
            if (!typed.IsSuccess)
            {
                return DomainResult<object>.Failure(typed.ErrorMessage ?? "");
            }
            else
            {
                return DomainResult<object>.Success(typed.Value);
            }
        }
        if (typeName == "Section")
        {
            var typed = Section.Create((values.ContainsKey("Cap") ? (long?)values["Cap"] ?? 0L : 0L), (values.ContainsKey("OfferingTerm") ? (Term?)values["OfferingTerm"] ?? Term.Fall : Term.Fall), (values.ContainsKey("course") ? (Course?)values["course"] ?? null : null), (values.ContainsKey("instructor") ? (Instructor?)values["instructor"] ?? null : null), new List<Enrollment>(), new List<WaitOffer>(), (values.ContainsKey("OfferedSeats") ? (long?)values["OfferedSeats"] ?? 0L : 0L), (values.ContainsKey("SeatsTaken") ? (long?)values["SeatsTaken"] ?? 0L : 0L), (values.ContainsKey("WaitCleared") ? (long?)values["WaitCleared"] ?? 0L : 0L));
            if (!typed.IsSuccess)
            {
                return DomainResult<object>.Failure(typed.ErrorMessage ?? "");
            }
            else
            {
                return DomainResult<object>.Success(typed.Value);
            }
        }
        if (typeName == "WaitOffer")
        {
            var typed = WaitOffer.Create((values.ContainsKey("student") ? (Student?)values["student"] ?? null : null), (values.ContainsKey("section") ? (Section?)values["section"] ?? null : null));
            if (!typed.IsSuccess)
            {
                return DomainResult<object>.Failure(typed.ErrorMessage ?? "");
            }
            else
            {
                return DomainResult<object>.Success(typed.Value);
            }
        }
        if (typeName == "Enrollment")
        {
            var typed = Enrollment.Create((values.ContainsKey("section") ? (Section?)values["section"] ?? null : null), (values.ContainsKey("student") ? (Student?)values["student"] ?? null : null), (values.ContainsKey("DueDate") ? (DateOnly?)values["DueDate"] ?? DateOnly.MinValue : DateOnly.MinValue), (values.ContainsKey("EnrolledOn") ? (DateOnly?)values["EnrolledOn"] ?? DateOnly.MinValue : DateOnly.MinValue), (values.ContainsKey("Grade") ? (long?)values["Grade"] ?? 0L : 0L));
            if (!typed.IsSuccess)
            {
