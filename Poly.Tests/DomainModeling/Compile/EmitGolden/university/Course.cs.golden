#nullable enable
using Poly.Runtime;

public class Course : Poly.Runtime.IActionScoped
{
    private Course() { }
    private Course(string code, string title)
    {
        this.Code = code;
        this.Title = title;
    }
    public string Code { get; private set; } = default!;
    public string Title { get; private set; } = default!;
    public static DomainResult<Course> Create(string code, string title, Poly.Runtime.IStoragePort db)
    {
        if (string.IsNullOrEmpty(code))
        {
            return DomainResult<Course>.Failure(Poly.Runtime.DomainFailure.Required("'Code' is required.", "Course.Code"));
        }
        if (code.Length < 3L)
        {
            return DomainResult<Course>.Failure(Poly.Runtime.DomainFailure.Length("'Code' must be at least 3 characters.", "Course.Code"));
        }
        if (code.Length > 12L)
        {
            return DomainResult<Course>.Failure(Poly.Runtime.DomainFailure.Length("'Code' must be at most 12 characters.", "Course.Code"));
        }
        if (string.IsNullOrEmpty(title))
        {
            return DomainResult<Course>.Failure(Poly.Runtime.DomainFailure.Required("'Title' is required.", "Course.Title"));
        }
        if (Course.ExistsWithCode(db, code))
        {
            return DomainResult<Course>.Failure(Poly.Runtime.DomainFailure.Unique("Unique constraint violated: 'Code' value is already used on another 'Course'.", "Course.Code"));
        }
        var created = new Course(code, title);
        db.Record("Course", "Code", code);
        return DomainResult<Course>.Success(created);
    }
    public DomainResult EnsureUnique(string propertyName, object value)
    {
        if (value == null)
        {
            return DomainResult.Success();
        }
        if (propertyName == "Code" && object.Equals(this.Code, value))
        {
            return DomainResult.Success();
        }
        return DomainResult.Failure(Poly.Runtime.DomainFailure.Constraint("A unique assign needs the storage port.", "Course"));
    }
    public object __Snapshot()
    {
        var __state = new object?[2];
        __state[0] = this.Code;
        __state[1] = this.Title;
        return __state;
    }
    public void __Restore(object state)
    {
        var __saved = (object?[])state;
        this.Code = (string)__saved[0]!;
        this.Title = (string)__saved[1]!;
    }
    public static System.Boolean ExistsWithCode(Poly.Runtime.IStoragePort db, System.String code) => db.Exists("Course", "Code", code);
}