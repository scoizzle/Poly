#nullable enable
using Poly.Runtime;

public class Course
{
    private Course() { }
    private Course(string code, string title)
    {
        this.Code = code;
        this.Title = title;
    }
    public string Code { get; private set; } = default!;
    public string Title { get; private set; } = default!;
    public static DomainResult<Course> Create(string code, string title, Poly.Runtime.IStoragePort db)
    {
        if (string.IsNullOrEmpty(code))
        {
            return DomainResult<Course>.Failure("'Code' is required.");
        }
        if (code.Length < 3L)
        {
            return DomainResult<Course>.Failure("'Code' must be at least 3 characters.");
        }
        if (code.Length > 12L)
        {
            return DomainResult<Course>.Failure("'Code' must be at most 12 characters.");
        }
        if (string.IsNullOrEmpty(title))
        {
            return DomainResult<Course>.Failure("'Title' is required.");
        }
        if (Course.ExistsWithCode(db, code))
        {
            return DomainResult<Course>.Failure("Unique constraint violated: 'Code' value is already used on another 'Course'.");
        }
        var created = new Course(code, title);
        db.Record("Course", "Code", code);
        return DomainResult<Course>.Success(created);
    }
    public DomainResult EnsureUnique(string propertyName, object value)
    {
        if (value == null)
        {
            return DomainResult.Success();
        }
        if (propertyName == "Code" && object.Equals(this.Code, value))
        {
            return DomainResult.Success();
        }
        return DomainResult.Failure("A unique assign needs the storage port.");
    }
    public static System.Boolean ExistsWithCode(Poly.Runtime.IStoragePort db, System.String code) => db.Exists("Course", "Code", code);
}