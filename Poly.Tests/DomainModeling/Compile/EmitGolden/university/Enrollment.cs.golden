#nullable enable
using System;
using System.Collections.Generic;

public enum EnrollmentStage
{
    Pending = 0,
    Registered = 1,
    Completed = 2,
    Dropped = 3
}

public class Enrollment
{
    private List<Student>? _studentEnrollmentsDroppedSubscribers;
    private List<Student>? _studentEnrollmentsCompletedSubscribers;
    private List<Section>? _sectionEnrollmentsRegisteredSubscribers;
    private List<Section>? _sectionEnrollmentsDroppedSubscribers;
    private int _notifyDepth;
    private Enrollment()
    { }
    private Enrollment(Section? section = null, Student? student = null, DateOnly? dueDate = null, DateOnly? enrolledOn = null, long grade = 0L)
    {
        this.DueDate = dueDate ?? DateOnly.FromDateTime(DateTime.Today);
        this.EnrolledOn = enrolledOn ?? DateOnly.FromDateTime(DateTime.Today);
        this.Grade = grade;
        this.Section = section;
        this.Student = student;
        this.CurrentStage = EnrollmentStage.Pending;
    }
    public DateOnly DueDate { get; private set; }
    public DateOnly EnrolledOn { get; private set; }
    public long Grade { get; private set; }
    public Section? Section { get; private set; }
    public Student? Student { get; private set; }
    public EnrollmentStage CurrentStage { get; private set; }
    private DomainResult<Section> CreateSection(long cap, Term offeringTerm, Course? course, Instructor? instructor, long offeredSeats = 0L, long seatsTaken = 0L, long waitCleared = 0L)
    {
        var sectionResult = Section.Create(cap, offeringTerm, course, instructor, new List<Enrollment>(), new List<WaitOffer>(), offeredSeats, seatsTaken, waitCleared);
        if (!sectionResult.IsSuccess)
        {
            return DomainResult<Section>.Failure(sectionResult.ErrorMessage ?? "");
        }
        var section = sectionResult.Value;
        this.Section = section;
        return DomainResult<Section>.Success(section);
    }
    private DomainResult<Student> CreateStudent(string email, string name, long completions = 0L, long holds = 0L, long lastGrade = 0L, long maxCredits = 18L, long openCredits = 0L)
    {
        var studentResult = Student.Create(email, name, new List<Enrollment>(), completions, holds, lastGrade, maxCredits, openCredits);
        if (!studentResult.IsSuccess)
        {
            return DomainResult<Student>.Failure(studentResult.ErrorMessage ?? "");
        }
        var student = studentResult.Value;
        this.Student = student;
        return DomainResult<Student>.Success(student);
    }
    public DomainResult Confirm()
    {
        if (this.CurrentStage != EnrollmentStage.Pending)
        {
            return DomainResult.Failure("'Confirm' requires stage 'Pending' on entity 'Enrollment'.");
        }
        if (this.Section == null)
        {
            return DomainResult.Failure("'Confirm' requires a linked 'section' on entity 'Enrollment'.");
        }
        if (this.SectionFull())
        {
            return DomainResult.Failure("'Confirm' blocked by policy 'SectionFull'.");
        }
        this.DueDate = this.EnrolledOn.AddDays((int)14L);
        var previousStage0 = this.CurrentStage;
        this.CurrentStage = EnrollmentStage.Registered;
        this.NotifyRegisteredSubscribers(previousStage0);
        return DomainResult.Success();
    }
    public DomainResult Withdraw()
    {
        if (this.CurrentStage != EnrollmentStage.Pending)
        {
            return DomainResult.Failure("'Withdraw' requires stage 'Pending' on entity 'Enrollment'.");
        }
        var previousStage0 = this.CurrentStage;
        this.CurrentStage = EnrollmentStage.Dropped;
        this.NotifyDroppedSubscribers(previousStage0);
        return DomainResult.Success();
    }
    public DomainResult RecordGrade(long score)
    {
        if (this.CurrentStage != EnrollmentStage.Registered)
        {
            return DomainResult.Failure("'RecordGrade' requires stage 'Registered' on entity 'Enrollment'.");
        }
        if (score >= 70L)
        {
            var assignValue0 = score;
            if (assignValue0 < 0L)
            {
                return DomainResult.Failure("'Grade' must be >= 0.");
            }
            if (assignValue0 > 100L)
            {
                return DomainResult.Failure("'Grade' must be <= 100.");
            }
            this.Grade = assignValue0;
        }
        else
        {
            var assignValue1 = 0L;
            if (assignValue1 < 0L)
            {
                return DomainResult.Failure("'Grade' must be >= 0.");
            }
            if (assignValue1 > 100L)
            {
                return DomainResult.Failure("'Grade' must be <= 100.");
            }
            this.Grade = assignValue1;
        }
        return DomainResult.Success();
    }
    public DomainResult Complete()
    {
        if (this.CurrentStage != EnrollmentStage.Registered)
        {
            return DomainResult.Failure("'Complete' requires stage 'Registered' on entity 'Enrollment'.");
        }
        var previousStage0 = this.CurrentStage;
        this.CurrentStage = EnrollmentStage.Completed;
        this.NotifyCompletedSubscribers(previousStage0);
        return DomainResult.Success();
    }
    public DomainResult Drop()
    {
        if (this.CurrentStage != EnrollmentStage.Registered)
        {
            return DomainResult.Failure("'Drop' requires stage 'Registered' on entity 'Enrollment'.");
        }
        var previousStage0 = this.CurrentStage;
        this.CurrentStage = EnrollmentStage.Dropped;
        this.NotifyDroppedSubscribers(previousStage0);
        return DomainResult.Success();
    }
    public bool SectionFull() => this.Section != null && this.Section!.SeatsTaken >= 1L;
    public bool IsPassing() => this.Grade >= 70L;
    internal void RegisterStudentEnrollmentsDroppedSubscriber(Student subscriber)
    {
        if (this._studentEnrollmentsDroppedSubscribers == null)
        {
            this._studentEnrollmentsDroppedSubscribers = new List<Student>();
        }
        this._studentEnrollmentsDroppedSubscribers.Add(subscriber);
    }
    internal void RegisterStudentEnrollmentsCompletedSubscriber(Student subscriber)
    {
        if (this._studentEnrollmentsCompletedSubscribers == null)
        {
            this._studentEnrollmentsCompletedSubscribers = new List<Student>();
        }
        this._studentEnrollmentsCompletedSubscribers.Add(subscriber);
    }
    internal void RegisterSectionEnrollmentsRegisteredSubscriber(Section subscriber)
    {
        if (this._sectionEnrollmentsRegisteredSubscribers == null)
        {
            this._sectionEnrollmentsRegisteredSubscribers = new List<Section>();
        }
        this._sectionEnrollmentsRegisteredSubscribers.Add(subscriber);
    }
    internal void RegisterSectionEnrollmentsDroppedSubscriber(Section subscriber)
    {
        if (this._sectionEnrollmentsDroppedSubscribers == null)
        {
            this._sectionEnrollmentsDroppedSubscribers = new List<Section>();
        }
        this._sectionEnrollmentsDroppedSubscribers.Add(subscriber);
    }
    internal void NotifyDroppedSubscribers(EnrollmentStage previousStage)
    {
        this.EnterNotifyCascade("Dropped");
        try
        {
            if (this._studentEnrollmentsDroppedSubscribers != null)
            {
                foreach (var sub in this._studentEnrollmentsDroppedSubscribers)
                {
                    sub.WhenEachEnrollmentDropped();
                }
            }
            if (this._sectionEnrollmentsDroppedSubscribers != null)
            {
                foreach (var sub in this._sectionEnrollmentsDroppedSubscribers)
                {
                    sub.WhenEachEnrollmentDropped();
                }
            }
        }
        finally
        {
            this.ExitNotifyCascade();
        }
    }
    internal void NotifyCompletedSubscribers(EnrollmentStage previousStage)
    {
        this.EnterNotifyCascade("Completed");
        try
        {
            if (this._studentEnrollmentsCompletedSubscribers != null)
            {
                foreach (var sub in this._studentEnrollmentsCompletedSubscribers)
                {
                    sub.WhenEachEnrollmentCompleted();
                    sub.WhenEachEnrollmentCompleted(this);
                }
            }
        }
        finally
        {
            this.ExitNotifyCascade();
        }
    }
    internal void NotifyRegisteredSubscribers(EnrollmentStage previousStage)
    {
        this.EnterNotifyCascade("Registered");
        try
        {
            if (this._sectionEnrollmentsRegisteredSubscribers != null)
            {
                foreach (var sub in this._sectionEnrollmentsRegisteredSubscribers)
                {
                    sub.WhenEachEnrollmentRegistered();
                }
            }
        }
        finally
        {
            this.ExitNotifyCascade();
        }
    }
    public static DomainResult<Enrollment> Create(Section? section = null, Student? student = null, DateOnly? dueDate = null, DateOnly? enrolledOn = null, long grade = 0L)
    {
        if (grade < 0L)
        {
            return DomainResult<Enrollment>.Failure("'Grade' must be >= 0.");
        }
        if (grade > 100L)
        {
            return DomainResult<Enrollment>.Failure("'Grade' must be <= 100.");
        }
        var created = new Enrollment(section, student, dueDate, enrolledOn, grade);
        if (section != null)
        {
            section.AttachEnrollments(created);
        }
        if (student != null)
        {
            student.AttachEnrollments(created);
        }
        return DomainResult<Enrollment>.Success(created);
    }
