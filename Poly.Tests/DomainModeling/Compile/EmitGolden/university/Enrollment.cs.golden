        __state[7] = (this._studentEnrollmentsCompletedSubscribers == null ? null : new List<Student>(this._studentEnrollmentsCompletedSubscribers));
        __state[8] = (this._sectionEnrollmentsRegisteredSubscribers == null ? null : new List<Section>(this._sectionEnrollmentsRegisteredSubscribers));
        __state[9] = (this._sectionEnrollmentsDroppedSubscribers == null ? null : new List<Section>(this._sectionEnrollmentsDroppedSubscribers));
        __state[10] = this._notifyDepth;
