#nullable enable
using Poly.Runtime;

public enum InstructorStage
{
    Ready = 0,
    Leave = 1
}

public class Instructor
{
    private Instructor() { }
    private Instructor(string name, string email)
    {
        this.Name = name;
        this.Email = email;
        this.CurrentStage = InstructorStage.Ready;
    }
    public string Name { get; private set; } = default!;
    public string Email { get; private set; } = default!;
    public InstructorStage CurrentStage { get; private set; }
    public DomainResult GoOnLeave()
    {
        if (this.CurrentStage != InstructorStage.Ready)
        {
            return DomainResult.Failure("'GoOnLeave' requires stage 'Ready' on entity 'Instructor'.");
        }
        this.CurrentStage = InstructorStage.Leave;
        return DomainResult.Success();
    }
    public DomainResult Return()
    {
        if (this.CurrentStage != InstructorStage.Leave)
        {
            return DomainResult.Failure("'Return' requires stage 'Leave' on entity 'Instructor'.");
        }
        this.CurrentStage = InstructorStage.Ready;
        return DomainResult.Success();
    }
    public static DomainResult<Instructor> Create(string name, string email, Poly.Runtime.IStoragePort db)
    {
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Instructor>.Failure("'Name' is required.");
        }
        if (string.IsNullOrEmpty(email))
        {
            return DomainResult<Instructor>.Failure("'Email' is required.");
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(email, "^[^@]+@[^@]+\\z"))
        {
            return DomainResult<Instructor>.Failure("'Email' does not match the required pattern.");
        }
        if (Instructor.ExistsWithEmail(db, email))
        {
            return DomainResult<Instructor>.Failure("Unique constraint violated: 'Email' value is already used on another 'Instructor'.");
        }
        var created = new Instructor(name, email);
        db.Record("Instructor", "Email", email);
        return DomainResult<Instructor>.Success(created);
    }
    public DomainResult EnsureUnique(string propertyName, object value)
    {
        if (value == null)
        {
            return DomainResult.Success();
        }
        if (propertyName == "Email" && object.Equals(this.Email, value))
        {
            return DomainResult.Success();
        }
        return DomainResult.Failure("A unique assign needs the storage port.");
    }
    public static System.Boolean ExistsWithEmail(Poly.Runtime.IStoragePort db, System.String email) => db.Exists("Instructor", "Email", email);
}