#nullable enable
using Poly.Runtime;

internal enum InstructorStage
{
    Ready = 0,
    Leave = 1
}

internal class Instructor : Poly.Runtime.IActionScoped
{
    private Instructor() { }
    private Instructor(string name, string email)
    {
        this.Name = name;
        this.Email = email;
        this.CurrentStage = InstructorStage.Ready;
    }
    public string Name { get; private set; } = default!;
    public string Email { get; private set; } = default!;
    public InstructorStage CurrentStage { get; private set; }
    internal DomainResult GoOnLeave()
    {
        if (this.CurrentStage != InstructorStage.Ready)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'GoOnLeave' requires stage 'Ready' on entity 'Instructor'.", "Instructor.GoOnLeave", "Ready"));
        }
        this.CurrentStage = InstructorStage.Leave;
        return DomainResult.Success();
    }
    internal DomainResult Return()
    {
        if (this.CurrentStage != InstructorStage.Leave)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Stage("'Return' requires stage 'Leave' on entity 'Instructor'.", "Instructor.Return", "Leave"));
        }
        this.CurrentStage = InstructorStage.Ready;
        return DomainResult.Success();
    }
    internal static DomainResult<Instructor> Create(string name, string email, Poly.Runtime.IStoragePort db)
    {
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Instructor>.Failure(Poly.Runtime.DomainFailure.Required("'Name' is required.", "Instructor.Name"));
        }
        if (string.IsNullOrEmpty(email))
        {
            return DomainResult<Instructor>.Failure(Poly.Runtime.DomainFailure.Required("'Email' is required.", "Instructor.Email"));
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(email, "^[^@]+@[^@]+\\z"))
        {
            return DomainResult<Instructor>.Failure(Poly.Runtime.DomainFailure.Pattern("'Email' does not match the required pattern.", "Instructor.Email"));
        }
        if (Instructor.ExistsWithEmail(db, email))
        {
            return DomainResult<Instructor>.Failure(Poly.Runtime.DomainFailure.Unique("Unique constraint violated: 'Email' value is already used on another 'Instructor'.", "Instructor.Email"));
        }
        var created = new Instructor(name, email);
        db.Record("Instructor", "Email", email);
        return DomainResult<Instructor>.Success(created);
    }
    public DomainResult EnsureUnique(string propertyName, object value)
    {
        if (value == null)
        {
            return DomainResult.Success();
        }
        if (propertyName == "Email" && object.Equals(this.Email, value))
        {
            return DomainResult.Success();
        }
        return DomainResult.Failure(Poly.Runtime.DomainFailure.Constraint("A unique assign needs the storage port.", "Instructor"));
    }
    public object __Snapshot()
    {
        var __state = new object?[3];
        __state[0] = this.Name;
        __state[1] = this.Email;
        __state[2] = this.CurrentStage;
        return __state;
    }
    public void __Restore(object state)
    {
        var __saved = (object?[])state;
        this.Name = (string)__saved[0]!;
        this.Email = (string)__saved[1]!;
        this.CurrentStage = (InstructorStage)__saved[2]!;
    }
    public static System.Boolean ExistsWithEmail(Poly.Runtime.IStoragePort db, System.String email) => db.Exists("Instructor", "Email", email);
}