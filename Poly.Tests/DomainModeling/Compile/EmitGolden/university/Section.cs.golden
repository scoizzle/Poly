#nullable enable
using System.Collections.Generic;

public enum SectionStage
{
    Open = 0,
    Closed = 1
}

public class Section
{
    private List<Enrollment> _enrollments = new List<Enrollment>();
    private List<WaitOffer> _waitlist = new List<WaitOffer>();
    private Section(long cap, Term offeringTerm, Course? course = null, Instructor? instructor = null, IEnumerable<Enrollment>? enrollments = null, IEnumerable<WaitOffer>? waitlist = null, long offeredSeats = 0L, long seatsTaken = 0L, long waitCleared = 0L)
    {
        this.Cap = cap;
        this.OfferingTerm = offeringTerm;
        this.OfferedSeats = offeredSeats;
        this.SeatsTaken = seatsTaken;
        this.WaitCleared = waitCleared;
        this.Course = course;
        this.Instructor = instructor;
        this._enrollments = new List<Enrollment>(enrollments ?? new List<Enrollment>());
        this._waitlist = new List<WaitOffer>(waitlist ?? new List<WaitOffer>());
        this.CurrentStage = SectionStage.Open;
        this.InitializeSubscriptions();
    }
    public long Cap { get; private set; }
    public long OfferedSeats { get; private set; }
    public Term OfferingTerm { get; private set; }
    public long SeatsTaken { get; private set; }
    public long WaitCleared { get; private set; }
    public Course? Course { get; private set; }
    public Instructor? Instructor { get; private set; }
    public IReadOnlyList<Enrollment> Enrollments
    {
        get => this._enrollments;
    }
    public IReadOnlyList<WaitOffer> Waitlist
    {
        get => this._waitlist;
    }
    public SectionStage CurrentStage { get; private set; }
    internal void AttachEnrollments(Enrollment child)
    {
        this._enrollments.Add(child);
        child.RegisterSectionEnrollmentsRegisteredSubscriber(this);
        child.RegisterSectionEnrollmentsDroppedSubscriber(this);
    }
    public DomainResult<WaitOffer> CreateWaitlist(Student? student = null)
    {
        var waitOfferResult = WaitOffer.Create(student, this);
        if (!waitOfferResult.IsSuccess)
        {
            return DomainResult<WaitOffer>.Failure(waitOfferResult.ErrorMessage ?? "");
        }
        var waitOffer = waitOfferResult.Value;
        return DomainResult<WaitOffer>.Success(waitOffer);
    }
    internal void AttachWaitlist(WaitOffer child)
    {
        this._waitlist.Add(child);
        child.RegisterSectionWaitlistOfferedSubscriber(this);
        child.RegisterSectionWaitlistCancelledSubscriber(this);
    }
    public DomainResult Close()
    {
        if (this.CurrentStage != SectionStage.Open)
        {
            return DomainResult.Failure("'Close' requires stage 'Open' on entity 'Section'.");
        }
        if (!this.HasInstructor())
        {
            return DomainResult.Failure("'Close' blocked by policy 'HasInstructor'.");
        }
        this.CurrentStage = SectionStage.Closed;
        return DomainResult.Success();
    }
    public DomainResult<WaitOffer> Queue(Student who)
    {
        if (this.CurrentStage != SectionStage.Open)
        {
            return DomainResult<WaitOffer>.Failure("'Queue' requires stage 'Open' on entity 'Section'.");
        }
        var create0 = this.CreateWaitlist(who);
        if (!create0.IsSuccess)
        {
            return DomainResult<WaitOffer>.Failure(create0.ErrorMessage ?? "");
        }
        var created1 = create0.Value;
        return DomainResult<WaitOffer>.Success(created1);
    }
    public DomainResult StaffLeave()
    {
        if (this.CurrentStage != SectionStage.Open)
        {
            return DomainResult.Failure("'StaffLeave' requires stage 'Open' on entity 'Section'.");
        }
        if (!this.HasInstructor())
        {
            return DomainResult.Failure("'StaffLeave' blocked by policy 'HasInstructor'.");
        }
        if (this.Instructor == null)
        {
            return DomainResult.Failure("'StaffLeave' requires a linked 'instructor' on entity 'Section'.");
        }
        var invoke0 = this.Instructor.GoOnLeave();
        if (!invoke0.IsSuccess)
        {
            return DomainResult.Failure(invoke0.ErrorMessage ?? "");
        }
        return DomainResult.Success();
    }
    public DomainResult Reopen()
    {
        if (this.CurrentStage != SectionStage.Closed)
        {
            return DomainResult.Failure("'Reopen' requires stage 'Closed' on entity 'Section'.");
        }
        this.CurrentStage = SectionStage.Open;
        return DomainResult.Success();
    }
    public bool AtCap() => this.SeatsTaken >= this.Cap;
    public bool HasInstructor() => this.Instructor != null;
    public bool HasWaiters() => this.Waitlist.Count > 0;
    internal void WhenEachEnrollmentRegistered()
    {
        this.SeatsTaken = this.SeatsTaken + 1L;
    }
    internal void WhenEachEnrollmentDropped()
    {
        this.SeatsTaken = this.SeatsTaken - 1L;
    }
    internal void WhenAnyWaitOfferOffered()
    {
        var linkedMatched = false;
        foreach (var linkedTarget in this.Waitlist)
        {
            if (linkedTarget.CurrentStage == WaitOfferStage.Offered)
            {
                linkedMatched = true;
            }
        }
        if (!linkedMatched)
        {
            return;
        }
        this.OfferedSeats = this.OfferedSeats + 1L;
    }
    internal void WhenAllWaitOfferCancelled(WaitOfferStage? previousStage)
    {
        var linkedMatched = false;
        foreach (var linkedTarget in this.Waitlist)
        {
            linkedMatched = true;
            if (linkedTarget.CurrentStage != WaitOfferStage.Cancelled)
            {
                return;
            }
        }
        if (!linkedMatched)
        {
            return;
        }
        if (previousStage == WaitOfferStage.Cancelled)
        {
            return;
        }
        this.WaitCleared = 1L;
    }
    public static DomainResult<Section> Create(long cap, Term offeringTerm, Course? course = null, Instructor? instructor = null, IEnumerable<Enrollment>? enrollments = null, IEnumerable<WaitOffer>? waitlist = null, long offeredSeats = 0L, long seatsTaken = 0L, long waitCleared = 0L)
    {
        if (cap < 1L)
        {
            return DomainResult<Section>.Failure("'Cap' must be >= 1.");
        }
        if (cap > 200L)
        {
            return DomainResult<Section>.Failure("'Cap' must be <= 200.");
        }
        if (object.ReferenceEquals(offeringTerm, null))
        {
            return DomainResult<Section>.Failure("'OfferingTerm' is required.");
        }
        if (offeringTerm != Term.Fall && offeringTerm != Term.Spring && offeringTerm != Term.Summer)
        {
            return DomainResult<Section>.Failure(string.Concat("'", offeringTerm, "' is not a valid member of Term for property 'OfferingTerm'."));
        }
        var created = new Section(cap, offeringTerm, course, instructor, enrollments, waitlist, offeredSeats, seatsTaken, waitCleared);
        return DomainResult<Section>.Success(created);
    }
    private void InitializeSubscriptions()
    {
        foreach (var target in this.Enrollments)
        {
            target.RegisterSectionEnrollmentsRegisteredSubscriber(this);
        }
        foreach (var target in this.Enrollments)
        {
            target.RegisterSectionEnrollmentsDroppedSubscriber(this);
        }
        foreach (var target in this.Waitlist)
        {
            target.RegisterSectionWaitlistOfferedSubscriber(this);
        }
        foreach (var target in this.Waitlist)
        {
            target.RegisterSectionWaitlistCancelledSubscriber(this);
        }
    }
}