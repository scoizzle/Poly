    public bool AtCap() => this.SeatsTaken >= this.Cap;
    public bool HasInstructor() => this.Instructor != null;
    public bool HasWaiters() => this.Waitlist.Count > 0;
    internal void WhenEachEnrollmentRegistered()
    {
        this.SeatsTaken = this.SeatsTaken + 1L;
    }
    internal void WhenEachEnrollmentDropped()
    {
        this.SeatsTaken = this.SeatsTaken - 1L;
    }
    internal void WhenAnyWaitOfferOffered()
    {
        var linkedMatched = false;
        foreach (var linkedTarget in this.Waitlist)
        {
            if (linkedTarget.CurrentStage == WaitOfferStage.Offered)
            {
                linkedMatched = true;
            }
        }
        if (!linkedMatched)
        {
            return;
        }
        this.OfferedSeats = this.OfferedSeats + 1L;
    }
    internal void WhenAllWaitOfferCancelled(WaitOfferStage? previousStage)
    {
        var linkedMatched = false;
        foreach (var linkedTarget in this.Waitlist)
        {
            linkedMatched = true;
            if (linkedTarget.CurrentStage != WaitOfferStage.Cancelled)
            {
                return;
            }
        }
        if (!linkedMatched)
        {
            return;
        }
        if (previousStage == WaitOfferStage.Cancelled)
        {
            return;
        }
        this.WaitCleared = 1L;
    }
    public static DomainResult<Section> Create(long cap, Term offeringTerm, Course? course = null, Instructor? instructor = null, IEnumerable<Enrollment>? enrollments = null, IEnumerable<WaitOffer>? waitlist = null, long seatsTaken = 0L, long offeredSeats = 0L, long waitCleared = 0L)
    {
        if (cap < 1L)
        {
            return DomainResult<Section>.Failure(Poly.Runtime.DomainFailure.Range("'Cap' must be >= 1.", "Section.Cap"));
        }
        if (cap > 200L)
        {
            return DomainResult<Section>.Failure(Poly.Runtime.DomainFailure.Range("'Cap' must be <= 200.", "Section.Cap"));
        }
        if ((object)offeringTerm == null)
        {
            return DomainResult<Section>.Failure(Poly.Runtime.DomainFailure.Required("'OfferingTerm' is required.", "Section.OfferingTerm"));
        }
        if (offeringTerm != Term.Fall && offeringTerm != Term.Spring && offeringTerm != Term.Summer)
        {
            return DomainResult<Section>.Failure(Poly.Runtime.DomainFailure.Enum(string.Concat("'", offeringTerm, "' is not a valid member of Term for property 'OfferingTerm'."), "Section.OfferingTerm"));
        }
        var created = new Section(cap, offeringTerm, course, instructor, enrollments, waitlist, seatsTaken, offeredSeats, waitCleared);
        return DomainResult<Section>.Success(created);
    }
    private void InitializeSubscriptions()
    {
        foreach (var target in this.Enrollments)
        {
            target.RegisterSectionEnrollmentsRegisteredSubscriber(this);
        }
        foreach (var target in this.Enrollments)
