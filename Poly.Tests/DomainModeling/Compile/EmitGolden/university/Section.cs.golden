            target.RegisterSectionEnrollmentsDroppedSubscriber(this);
        }
        foreach (var target in this.Waitlist)
        {
            target.RegisterSectionWaitlistOfferedSubscriber(this);
        }
        foreach (var target in this.Waitlist)
        {
            target.RegisterSectionWaitlistCancelledSubscriber(this);
        }
    }
