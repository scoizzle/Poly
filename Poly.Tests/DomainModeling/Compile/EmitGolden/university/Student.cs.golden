#nullable enable
using System;
using System.Collections.Generic;

using Poly.Runtime;

public enum StudentStage
{
    Active = 0,
    Suspended = 1
}

public class Student
{
    private List<Enrollment> _enrollments = new List<Enrollment>();
    private Student() { }
    private Student(string name, string email, IEnumerable<Enrollment>? enrollments = null, long maxCredits = 18L, long openCredits = 0L, long holds = 0L, long completions = 0L, long lastGrade = 0L)
    {
        this.Name = name;
        this.Email = email;
        this.MaxCredits = maxCredits;
        this.OpenCredits = openCredits;
        this.Holds = holds;
        this.Completions = completions;
        this.LastGrade = lastGrade;
        this._enrollments = new List<Enrollment>(enrollments ?? new List<Enrollment>());
        this.CurrentStage = StudentStage.Active;
        this.InitializeSubscriptions();
    }
    public string Name { get; private set; } = default!;
    public string Email { get; private set; } = default!;
    public long MaxCredits { get; private set; }
    public long OpenCredits { get; private set; }
    public long Holds { get; private set; }
    public long Completions { get; private set; }
    public long LastGrade { get; private set; }
    public IReadOnlyList<Enrollment> Enrollments
    {
        get => this._enrollments;
    }
    public StudentStage CurrentStage { get; private set; }
    public DomainResult<Enrollment> CreateEnrollments(Section? section = null, DateOnly? enrolledOn = null, DateOnly? dueDate = null, long grade = 0L)
    {
        var enrollmentResult = Enrollment.Create(section, this, enrolledOn, dueDate, grade);
        if (!enrollmentResult.IsSuccess)
        {
            return DomainResult<Enrollment>.Failure(enrollmentResult.ErrorMessage ?? "");
        }
        var enrollment = enrollmentResult.Value;
        return DomainResult<Enrollment>.Success(enrollment);
    }
    internal void AttachEnrollments(Enrollment child)
    {
        this._enrollments.Add(child);
        child.RegisterStudentEnrollmentsDroppedSubscriber(this);
        child.RegisterStudentEnrollmentsCompletedSubscriber(this);
    }
    public DomainResult<Enrollment> Enroll(Section offering)
    {
        if (this.CurrentStage != StudentStage.Active)
        {
            return DomainResult<Enrollment>.Failure("'Enroll' requires stage 'Active' on entity 'Student'.");
        }
        if (this.AtLimit())
        {
            return DomainResult<Enrollment>.Failure("'Enroll' blocked by policy 'AtLimit'.");
        }
        this.OpenCredits = this.OpenCredits + 3L;
        var create0 = this.CreateEnrollments(offering);
        if (!create0.IsSuccess)
        {
            return DomainResult<Enrollment>.Failure(create0.ErrorMessage ?? "");
        }
        var created1 = create0.Value;
        return DomainResult<Enrollment>.Success(created1);
    }
    public DomainResult DropRegistered()
    {
        if (this.CurrentStage != StudentStage.Active)
        {
            return DomainResult.Failure("'DropRegistered' requires stage 'Active' on entity 'Student'.");
        }
        foreach (var target0 in this.Enrollments)
        {
            if (target0.CurrentStage != EnrollmentStage.Registered)
            {
                continue;
            }
            var result1 = target0.Drop();
            if (!result1.IsSuccess)
            {
                return DomainResult.Failure(result1.ErrorMessage ?? "");
            }
        }
        return DomainResult.Success();
    }
    public DomainResult DropAllRegistered()
    {
        if (this.CurrentStage != StudentStage.Active)
        {
            return DomainResult.Failure("'DropAllRegistered' requires stage 'Active' on entity 'Student'.");
        }
        var invoke0 = this.DropRegistered();
        if (!invoke0.IsSuccess)
        {
            return DomainResult.Failure(invoke0.ErrorMessage ?? "");
        }
        return DomainResult.Success();
    }
    public DomainResult CompleteRegistered()
    {
        if (this.CurrentStage != StudentStage.Active)
        {
            return DomainResult.Failure("'CompleteRegistered' requires stage 'Active' on entity 'Student'.");
        }
        foreach (var target0 in this.Enrollments)
        {
            if (target0.CurrentStage != EnrollmentStage.Registered)
            {
                continue;
            }
            var result1 = target0.Complete();
            if (!result1.IsSuccess)
            {
                return DomainResult.Failure(result1.ErrorMessage ?? "");
            }
        }
        return DomainResult.Success();
    }
    public DomainResult CompletePassing()
    {
        if (this.CurrentStage != StudentStage.Active)
        {
            return DomainResult.Failure("'CompletePassing' requires stage 'Active' on entity 'Student'.");
        }
        foreach (var target0 in this.Enrollments)
        {
            if (!target0.IsPassing())
            {
                continue;
            }
            var result1 = target0.Complete();
            if (!result1.IsSuccess)
            {
                return DomainResult.Failure(result1.ErrorMessage ?? "");
            }
        }
        return DomainResult.Success();
    }
    public DomainResult Suspend()
    {
        if (this.CurrentStage != StudentStage.Active)
        {
            return DomainResult.Failure("'Suspend' requires stage 'Active' on entity 'Student'.");
        }
        this.CurrentStage = StudentStage.Suspended;
        this.Holds = this.Holds + 1L;
        return DomainResult.Success();
    }
    public DomainResult Reinstate()
    {
        if (this.CurrentStage != StudentStage.Suspended)
        {
            return DomainResult.Failure("'Reinstate' requires stage 'Suspended' on entity 'Student'.");
        }
        this.CurrentStage = StudentStage.Active;
        return DomainResult.Success();
    }
    public bool AtLimit() => this.OpenCredits >= this.MaxCredits;
    public bool HasLoad() => this.Enrollments.Count > 0;
    internal void WhenEachEnrollmentDropped()
    {
        this.OpenCredits = this.OpenCredits - 3L;
    }
    internal void WhenEachEnrollmentCompleted()
    {
        this.OpenCredits = this.OpenCredits - 3L;
    }
    internal void WhenEachEnrollmentCompleted(Enrollment done)
    {
        this.Completions = this.Completions + 1L;
        this.LastGrade = done.Grade;
    }
    public static DomainResult<Student> Create(string name, string email, Poly.Runtime.IStoragePort db, IEnumerable<Enrollment>? enrollments = null, long maxCredits = 18L, long openCredits = 0L, long holds = 0L, long completions = 0L, long lastGrade = 0L)
    {
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Student>.Failure(Poly.Runtime.DomainFailure.Required("'Name' is required.", "Student.Name"));
        }
        if (string.IsNullOrEmpty(email))
        {
            return DomainResult<Student>.Failure(Poly.Runtime.DomainFailure.Required("'Email' is required.", "Student.Email"));
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(email, "^[^@]+@[^@]+\\z"))
        {
            return DomainResult<Student>.Failure(Poly.Runtime.DomainFailure.Pattern("'Email' does not match the required pattern.", "Student.Email"));
        }
        if (maxCredits < 1L)
        {
            return DomainResult<Student>.Failure(Poly.Runtime.DomainFailure.Range("'MaxCredits' must be >= 1.", "Student.MaxCredits"));
        }
        if (maxCredits > 24L)
        {
            return DomainResult<Student>.Failure(Poly.Runtime.DomainFailure.Range("'MaxCredits' must be <= 24.", "Student.MaxCredits"));
        }
        if (Student.ExistsWithEmail(db, email))
        {
            return DomainResult<Student>.Failure(Poly.Runtime.DomainFailure.Unique("Unique constraint violated: 'Email' value is already used on another 'Student'.", "Student.Email"));
        }
        var created = new Student(name, email, enrollments, maxCredits, openCredits, holds, completions, lastGrade);
        db.Record("Student", "Email", email);
        return DomainResult<Student>.Success(created);
    }
    private void InitializeSubscriptions()
    {
        foreach (var target in this.Enrollments)
        {
            target.RegisterStudentEnrollmentsDroppedSubscriber(this);
        }
        foreach (var target in this.Enrollments)
        {
            target.RegisterStudentEnrollmentsCompletedSubscriber(this);
        }
    }
    public DomainResult EnsureUnique(string propertyName, object value)
    {
        if (value == null)
        {
            return DomainResult.Success();
        }
        if (propertyName == "Email" && object.Equals(this.Email, value))
        {
            return DomainResult.Success();
        }
        return DomainResult.Failure("A unique assign needs the storage port.");
    }
    public static System.Boolean ExistsWithEmail(Poly.Runtime.IStoragePort db, System.String email) => db.Exists("Student", "Email", email);
}