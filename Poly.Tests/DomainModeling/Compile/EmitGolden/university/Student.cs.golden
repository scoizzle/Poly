    {
        get => this._enrollments;
    }
    public StudentStage CurrentStage { get; private set; }
    private DomainResult<Enrollment> CreateEnrollments(Section? section, DateOnly? dueDate = null, DateOnly? enrolledOn = null, long grade = 0L)
    {
        var enrollmentResult = Enrollment.Create(section, this, dueDate, enrolledOn, grade);
        if (!enrollmentResult.IsSuccess)
        {
            return DomainResult<Enrollment>.Failure(enrollmentResult.ErrorMessage ?? "");
        }
        var enrollment = enrollmentResult.Value;
        return DomainResult<Enrollment>.Success(enrollment);
    }
    internal void AttachEnrollments(Enrollment child)
    {
        this._enrollments.Add(child);
        child.RegisterStudentEnrollmentsDroppedSubscriber(this);
        child.RegisterStudentEnrollmentsCompletedSubscriber(this);
    }
    public DomainResult<Enrollment> Enroll(Section offering)
    {
        if (this.CurrentStage != StudentStage.Active)
        {
            return DomainResult<Enrollment>.Failure("'Enroll' requires stage 'Active' on entity 'Student'.");
        }
        if (this.AtLimit())
        {
            return DomainResult<Enrollment>.Failure("'Enroll' blocked by policy 'AtLimit'.");
        }
        var create0 = this.ProbeCreate("Enrollment", "section", (object)offering);
        if (!create0.IsSuccess)
        {
            return DomainResult<Enrollment>.Failure(create0.ErrorMessage ?? "");
        }
        this.OpenCredits = this.OpenCredits + 3L;
        var create1 = this.CreateIn("enrollments", "section", (object)offering);
        if (!create1.IsSuccess)
        {
            return DomainResult<Enrollment>.Failure(create1.ErrorMessage ?? "");
        }
        var created2 = create1.Value;
        return DomainResult<Enrollment>.Success((Enrollment)created2);
    }
    public DomainResult DropRegistered()
    {
        if (this.CurrentStage != StudentStage.Active)
        {
            return DomainResult.Failure("'DropRegistered' requires stage 'Active' on entity 'Student'.");
        }
        var matched1 = false;
        foreach (var target0 in this.Enrollments)
        {
            if (!(target0.CurrentStage == EnrollmentStage.Registered))
            {
                continue;
            }
            matched1 = true;
            var result2 = target0.Drop();
            if (!result2.IsSuccess)
            {
                return DomainResult.Failure(result2.ErrorMessage ?? "");
            }
        }
        if (!matched1)
        {
            return DomainResult.Failure("for enrollments.Drop matched zero targets.");
        }
        return DomainResult.Success();
    }
    public DomainResult DropAllRegistered()
    {
        if (this.CurrentStage != StudentStage.Active)
        {
            return DomainResult.Failure("'DropAllRegistered' requires stage 'Active' on entity 'Student'.");
        }
        var invoke0 = this.DropRegistered();
        if (!invoke0.IsSuccess)
        {
            return DomainResult.Failure(invoke0.ErrorMessage ?? "");
        }
        return DomainResult.Success();
    }
    public DomainResult CompleteRegistered()
    {
        if (this.CurrentStage != StudentStage.Active)
        {
            return DomainResult.Failure("'CompleteRegistered' requires stage 'Active' on entity 'Student'.");
        }
        var matched1 = false;
