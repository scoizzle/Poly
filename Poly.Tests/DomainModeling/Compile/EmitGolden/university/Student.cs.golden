            return DomainResult.Failure("for enrollments.Complete matched zero targets.");
        }
        return DomainResult.Success();
    }
    public DomainResult CompletePassing()
    {
        if (this.CurrentStage != StudentStage.Active)
        {
            return DomainResult.Failure("'CompletePassing' requires stage 'Active' on entity 'Student'.");
        }
        var matched1 = false;
        foreach (var target0 in this.Enrollments)
