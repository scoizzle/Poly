    }
    public DomainResult Suspend()
    {
        if (this.CurrentStage != StudentStage.Active)
        {
            return DomainResult.Failure("'Suspend' requires stage 'Active' on entity 'Student'.");
        }
        this.CurrentStage = StudentStage.Suspended;
        this.Holds = this.Holds + 1L;
        return DomainResult.Success();
    }
    public DomainResult Reinstate()
    {
        if (this.CurrentStage != StudentStage.Suspended)
        {
            return DomainResult.Failure("'Reinstate' requires stage 'Suspended' on entity 'Student'.");
        }
        this.CurrentStage = StudentStage.Active;
        return DomainResult.Success();
    }
    public bool AtLimit() => this.OpenCredits >= this.MaxCredits;
    public bool HasLoad() => this.Enrollments.Count > 0L;
    internal void WhenEachEnrollmentDropped()
    {
        this.OpenCredits = this.OpenCredits - 3L;
    }
    internal void WhenEachEnrollmentCompleted()
    {
        this.OpenCredits = this.OpenCredits - 3L;
    }
    internal void WhenEachEnrollmentCompleted(Enrollment done)
    {
        this.Completions = this.Completions + 1L;
        this.LastGrade = done.Grade;
    }
    public static DomainResult<Student> Create(string email, string name, IEnumerable<Enrollment>? enrollments = null, long completions = 0L, long holds = 0L, long lastGrade = 0L, long maxCredits = 18L, long openCredits = 0L)
    {
        if (string.IsNullOrEmpty(email))
        {
            return DomainResult<Student>.Failure("'Email' is required.");
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(email, "^[^@]+@[^@]+$"))
        {
            return DomainResult<Student>.Failure("'Email' does not match the required pattern.");
        }
        if (maxCredits < 1L)
        {
            return DomainResult<Student>.Failure("'MaxCredits' must be >= 1.");
        }
        if (maxCredits > 24L)
        {
            return DomainResult<Student>.Failure("'MaxCredits' must be <= 24.");
        }
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Student>.Failure("'Name' is required.");
        }
        var created = new Student(email, name, enrollments, completions, holds, lastGrade, maxCredits, openCredits);
        var uniqueCheck = created.EnsureUnique("Email", email);
        if (!uniqueCheck.IsSuccess)
        {
            return DomainResult<Student>.Failure(uniqueCheck.ErrorMessage ?? "");
        }
        return DomainResult<Student>.Success(created);
    }
    private void InitializeSubscriptions()
    {
        foreach (var target in this.Enrollments)
        {
            target.RegisterStudentEnrollmentsDroppedSubscriber(this);
        }
        foreach (var target in this.Enrollments)
        {
            target.RegisterStudentEnrollmentsCompletedSubscriber(this);
        }
    }
