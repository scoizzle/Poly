#nullable enable
using System;
using System.Collections.Generic;

public enum WaitOfferStage
{
    Queued = 0,
    Offered = 1,
    Cancelled = 2
}

public class WaitOffer
{
    private List<Section>? _sectionWaitlistOfferedSubscribers;
    private List<Section>? _sectionWaitlistCancelledSubscribers;
    private int _notifyDepth;
    private WaitOffer()
    { }
    private WaitOffer(Student? student = null, Section? section = null)
    {
        this.Student = student;
        this.Section = section;
        this.CurrentStage = WaitOfferStage.Queued;
    }
    public Student? Student { get; private set; }
    public Section? Section { get; private set; }
    public WaitOfferStage CurrentStage { get; private set; }
    public DomainResult Seat()
    {
        if (this.CurrentStage != WaitOfferStage.Queued)
        {
            return DomainResult.Failure("'Seat' requires stage 'Queued' on entity 'WaitOffer'.");
        }
        this.CurrentStage = WaitOfferStage.Offered;
        this.NotifyOfferedSubscribers();
        return DomainResult.Success();
    }
    public DomainResult Cancel()
    {
        if (this.CurrentStage == WaitOfferStage.Queued || this.CurrentStage == WaitOfferStage.Offered)
        {
            var previousStage0 = this.CurrentStage;
            this.CurrentStage = WaitOfferStage.Cancelled;
            this.NotifyCancelledSubscribers(previousStage0);
            return DomainResult.Success();
        }
        return DomainResult.Failure("'Cancel' is not valid for the current stage on entity 'WaitOffer'.");
    }
    internal void RegisterSectionWaitlistOfferedSubscriber(Section subscriber)
    {
        if (this._sectionWaitlistOfferedSubscribers == null)
        {
            this._sectionWaitlistOfferedSubscribers = new List<Section>();
        }
        foreach (var existing in this._sectionWaitlistOfferedSubscribers)
        {
            if (object.ReferenceEquals(existing, subscriber))
            {
                return;
            }
        }
        this._sectionWaitlistOfferedSubscribers.Add(subscriber);
    }
    internal void RegisterSectionWaitlistCancelledSubscriber(Section subscriber)
    {
        if (this._sectionWaitlistCancelledSubscribers == null)
        {
            this._sectionWaitlistCancelledSubscribers = new List<Section>();
        }
        foreach (var existing in this._sectionWaitlistCancelledSubscribers)
        {
            if (object.ReferenceEquals(existing, subscriber))
            {
                return;
            }
        }
        this._sectionWaitlistCancelledSubscribers.Add(subscriber);
    }
    internal void NotifyOfferedSubscribers()
    {
        this.EnterNotifyCascade("Offered");
        try
        {
            if (this._sectionWaitlistOfferedSubscribers != null)
            {
                foreach (var sub in this._sectionWaitlistOfferedSubscribers)
                {
                    sub.WhenAnyWaitOfferOffered();
                }
            }
        }
        finally
        {
            this.ExitNotifyCascade();
        }
    }
    internal void NotifyCancelledSubscribers(WaitOfferStage? previousStage)
    {
        this.EnterNotifyCascade("Cancelled");
        try
        {
            if (this._sectionWaitlistCancelledSubscribers != null)
            {
                foreach (var sub in this._sectionWaitlistCancelledSubscribers)
                {
                    sub.WhenAllWaitOfferCancelled(previousStage);
                }
            }
        }
        finally
        {
            this.ExitNotifyCascade();
        }
    }
    public static DomainResult<WaitOffer> Create(Student? student = null, Section? section = null)
    {
        var created = new WaitOffer(student, section);
        if (section != null)
        {
            section.AttachWaitlist(created);
        }
        return DomainResult<WaitOffer>.Success(created);
    }
    private void EnterNotifyCascade(string stageName)
    {
        if (this._notifyDepth >= 16)
        {
            throw new System.InvalidOperationException(string.Concat("Subscription cascade on entity 'WaitOffer' exceeded max depth (16) while notifying '", stageName, "'."));
        }
        this._notifyDepth = this._notifyDepth + 1;
    }
    private void ExitNotifyCascade()
    {
        this._notifyDepth = this._notifyDepth - 1;
    }
}