using System;
using System.Collections.Generic;

public class Delivery
{
    private Delivery()
    { }
    private Delivery(string notes, string reference, long weight, Truck? truck = null)
    {
        this.Notes = notes;
        this.Reference = reference;
        this.Weight = weight;
        this.Truck = truck;
    }
    public string Notes { get; private set; } = default!;
    public string Reference { get; private set; } = default!;
    public long Weight { get; private set; }
    public Truck? Truck { get; private set; }
    private DomainResult<Truck> CreateTruck(long maxLoad, string vin, Warehouse? warehouse, long currentLoad = 0L)
    {
        var truckResult = Truck.Create(maxLoad, vin, warehouse, new List<Delivery>(), currentLoad);
        if (!truckResult.IsSuccess)
        {
            return DomainResult<Truck>.Failure(truckResult.ErrorMessage ?? "");
        }
        var truck = truckResult.Value;
        this.Truck = truck;
        return DomainResult<Truck>.Success(truck);
    }
    public DomainResult Confirm(string notes)
    {
        this.Notes = notes;
        return DomainResult.Success();
    }
    public static DomainResult<Delivery> Create(string notes, string reference, long weight, Truck? truck = null)
    {
        if (string.IsNullOrEmpty(reference))
        {
            return DomainResult<Delivery>.Failure("'Reference' is required.");
        }
        if (reference.Length < 4L)
        {
            return DomainResult<Delivery>.Failure("'Reference' must be at least 4 characters.");
        }
        if (reference.Length > 20L)
        {
            return DomainResult<Delivery>.Failure("'Reference' must be at most 20 characters.");
        }
        if (weight < 1L)
        {
            return DomainResult<Delivery>.Failure("'Weight' must be >= 1.");
        }
        if (weight > 40000L)
        {
            return DomainResult<Delivery>.Failure("'Weight' must be <= 40000.");
        }
        var created = new Delivery(notes, reference, weight, truck);
        if (truck != null)
        {
            truck.AttachDeliveries(created);
        }
        return DomainResult<Delivery>.Success(created);
    }
    public DomainResult EnsureUnique(string propertyName, object value) => DomainResult.Success();
