#nullable enable
using Poly.Runtime;

public class Delivery
{
    private Delivery() { }
    private Delivery(string reference, long weight, string notes = "", Truck? truck = null)
    {
        this.Reference = reference;
        this.Weight = weight;
        this.Notes = notes;
        this.Truck = truck;
    }
    public string Reference { get; private set; } = default!;
    public long Weight { get; private set; }
    public string Notes { get; private set; } = default!;
    public Truck? Truck { get; private set; }
    public DomainResult Confirm(string notes)
    {
        var assignValue0 = notes;
        if (System.String.IsNullOrEmpty(assignValue0))
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Required("'Notes' is required.", "Delivery.Notes"));
        }
        this.Notes = assignValue0;
        return DomainResult.Success();
    }
    public static DomainResult<Delivery> Create(string reference, long weight, string notes = "", Truck? truck = null)
    {
        if (string.IsNullOrEmpty(reference))
        {
            return DomainResult<Delivery>.Failure(Poly.Runtime.DomainFailure.Required("'Reference' is required.", "Delivery.Reference"));
        }
        if (reference.Length < 4L)
        {
            return DomainResult<Delivery>.Failure(Poly.Runtime.DomainFailure.Length("'Reference' must be at least 4 characters.", "Delivery.Reference"));
        }
        if (reference.Length > 20L)
        {
            return DomainResult<Delivery>.Failure(Poly.Runtime.DomainFailure.Length("'Reference' must be at most 20 characters.", "Delivery.Reference"));
        }
        if (weight < 1L)
        {
            return DomainResult<Delivery>.Failure(Poly.Runtime.DomainFailure.Range("'Weight' must be >= 1.", "Delivery.Weight"));
        }
        if (weight > 40000L)
        {
            return DomainResult<Delivery>.Failure(Poly.Runtime.DomainFailure.Range("'Weight' must be <= 40000.", "Delivery.Weight"));
        }
        if (string.IsNullOrEmpty(notes))
        {
            return DomainResult<Delivery>.Failure(Poly.Runtime.DomainFailure.Required("'Notes' is required.", "Delivery.Notes"));
        }
        var created = new Delivery(reference, weight, notes, truck);
        if (truck != null)
        {
            truck.AttachDeliveries(created);
        }
        return DomainResult<Delivery>.Success(created);
    }
}