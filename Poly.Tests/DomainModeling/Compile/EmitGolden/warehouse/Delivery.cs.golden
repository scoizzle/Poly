    private DomainResult<object> BindCreate(string typeName, Dictionary<string, object> values)
    {
        if (typeName == "Warehouse")
        {
            var typed = Warehouse.Create((values.ContainsKey("Capacity") ? (long?)values["Capacity"] ?? 0L : 0L), (values.ContainsKey("Code") ? (string?)values["Code"] ?? "" : ""), (values.ContainsKey("Name") ? (string?)values["Name"] ?? "" : ""), (values.ContainsKey("Zip") ? (string?)values["Zip"] ?? "" : ""), new List<Truck>(), (values.ContainsKey("SafetyStock") ? (long?)values["SafetyStock"] ?? 0L : 0L), (values.ContainsKey("Status") ? (TruckStatus?)values["Status"] ?? TruckStatus.Idle : TruckStatus.Idle));
            if (!typed.IsSuccess)
            {
                return DomainResult<object>.Failure(typed.ErrorMessage ?? "");
            }
            else
            {
                return DomainResult<object>.Success(typed.Value);
            }
        }
        if (typeName == "Truck")
        {
            var typed = Truck.Create((values.ContainsKey("MaxLoad") ? (long?)values["MaxLoad"] ?? 0L : 0L), (values.ContainsKey("Vin") ? (string?)values["Vin"] ?? "" : ""), (values.ContainsKey("warehouse") ? (Warehouse?)values["warehouse"] ?? null : null), new List<Delivery>(), (values.ContainsKey("CurrentLoad") ? (long?)values["CurrentLoad"] ?? 0L : 0L));
            if (!typed.IsSuccess)
            {
                return DomainResult<object>.Failure(typed.ErrorMessage ?? "");
            }
            else
            {
                return DomainResult<object>.Success(typed.Value);
            }
        }
        if (typeName == "Delivery")
        {
            var typed = Delivery.Create((values.ContainsKey("Notes") ? (string?)values["Notes"] ?? "" : ""), (values.ContainsKey("Reference") ? (string?)values["Reference"] ?? "" : ""), (values.ContainsKey("Weight") ? (long?)values["Weight"] ?? 0L : 0L), (values.ContainsKey("truck") ? (Truck?)values["truck"] ?? null : null));
            if (!typed.IsSuccess)
            {
                return DomainResult<object>.Failure(typed.ErrorMessage ?? "");
            }
            else
            {
                return DomainResult<object>.Success(typed.Value);
            }
        }
        return DomainResult<object>.Failure("Unknown type '" + typeName + "'.");
    }
    private DomainResult<object> BindCreateIn(string relationshipName, Dictionary<string, object> values)
    {
        if (relationshipName == "truck")
        {
            var typed = this.CreateTruck((values.ContainsKey("MaxLoad") ? (long?)values["MaxLoad"] ?? 0L : 0L), (values.ContainsKey("Vin") ? (string?)values["Vin"] ?? "" : ""), (values.ContainsKey("warehouse") ? (Warehouse?)values["warehouse"] ?? null : null), (values.ContainsKey("CurrentLoad") ? (long?)values["CurrentLoad"] ?? 0L : 0L));
            if (!typed.IsSuccess)
            {
                return DomainResult<object>.Failure(typed.ErrorMessage ?? "");
            }
            else
            {
                return DomainResult<object>.Success(typed.Value);
            }
        }
        return DomainResult<object>.Failure("Unknown relationship '" + relationshipName + "'.");
    }
    private DomainResult BindProbeCreate(string typeName, Dictionary<string, object> values)
    {
        if (typeName == "Warehouse")
        {
            var typed = Warehouse.Create((values.ContainsKey("Capacity") ? (long?)values["Capacity"] ?? 0L : 0L), (values.ContainsKey("Code") ? (string?)values["Code"] ?? "" : ""), (values.ContainsKey("Name") ? (string?)values["Name"] ?? "" : ""), (values.ContainsKey("Zip") ? (string?)values["Zip"] ?? "" : ""), new List<Truck>(), (values.ContainsKey("SafetyStock") ? (long?)values["SafetyStock"] ?? 0L : 0L), (values.ContainsKey("Status") ? (TruckStatus?)values["Status"] ?? TruckStatus.Idle : TruckStatus.Idle));
            if (!typed.IsSuccess)
            {
                return DomainResult.Failure(typed.ErrorMessage ?? "");
            }
            return DomainResult.Success();
        }
        if (typeName == "Truck")
        {
            var typed = Truck.Create((values.ContainsKey("MaxLoad") ? (long?)values["MaxLoad"] ?? 0L : 0L), (values.ContainsKey("Vin") ? (string?)values["Vin"] ?? "" : ""), (values.ContainsKey("warehouse") ? (Warehouse?)values["warehouse"] ?? null : null), new List<Delivery>(), (values.ContainsKey("CurrentLoad") ? (long?)values["CurrentLoad"] ?? 0L : 0L));
            if (!typed.IsSuccess)
            {
                return DomainResult.Failure(typed.ErrorMessage ?? "");
            }
            return DomainResult.Success();
        }
        if (typeName == "Delivery")
        {
            var typed = Delivery.Create((values.ContainsKey("Notes") ? (string?)values["Notes"] ?? "" : ""), (values.ContainsKey("Reference") ? (string?)values["Reference"] ?? "" : ""), (values.ContainsKey("Weight") ? (long?)values["Weight"] ?? 0L : 0L), (values.ContainsKey("truck") ? (Truck?)values["truck"] ?? null : null));
            if (!typed.IsSuccess)
            {
                return DomainResult.Failure(typed.ErrorMessage ?? "");
            }
            return DomainResult.Success();
        }
        return DomainResult.Failure("Unknown type '" + typeName + "'.");
    }
