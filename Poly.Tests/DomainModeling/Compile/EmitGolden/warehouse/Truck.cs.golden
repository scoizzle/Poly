#nullable enable
using System.Collections.Generic;

public enum TruckStage
{
    Idle = 0,
    EnRoute = 1,
    OutOfService = 2
}

public class Truck
{
    private List<Delivery> _deliveries = new List<Delivery>();
    private Truck() { }
    private Truck(string vin, long maxLoad, Warehouse? warehouse = null, IEnumerable<Delivery>? deliveries = null, long currentLoad = 0L, TruckStatus status = TruckStatus.Idle)
    {
        this.Vin = vin;
        this.MaxLoad = maxLoad;
        this.CurrentLoad = currentLoad;
        this.Status = status;
        this.Warehouse = warehouse;
        this._deliveries = new List<Delivery>(deliveries ?? new List<Delivery>());
        this.CurrentStage = TruckStage.Idle;
    }
    public string Vin { get; private set; } = default!;
    public long MaxLoad { get; private set; }
    public long CurrentLoad { get; private set; }
    public TruckStatus Status { get; private set; }
    public Warehouse? Warehouse { get; private set; }
    public IReadOnlyList<Delivery> Deliveries
    {
        get => this._deliveries;
    }
    public TruckStage CurrentStage { get; private set; }
    internal void AttachDeliveries(Delivery child)
    {
        this._deliveries.Add(child);
    }
    public DomainResult Load(long weight)
    {
        var assignValue0 = this.CurrentLoad + weight;
        if (assignValue0 < 0L)
        {
            return DomainResult.Failure("'CurrentLoad' must be >= 0.");
        }
        if (assignValue0 > 40000L)
        {
            return DomainResult.Failure("'CurrentLoad' must be <= 40000.");
        }
        this.CurrentLoad = assignValue0;
        return DomainResult.Success();
    }
    public DomainResult Dispatch()
    {
        this.CurrentStage = TruckStage.EnRoute;
        this.Status = TruckStatus.EnRoute;
        return DomainResult.Success();
    }
    public bool IsOverloaded() => this.CurrentLoad > this.MaxLoad;
    public static DomainResult<Truck> Create(string vin, long maxLoad, Poly.Runtime.IStoragePort db, Warehouse? warehouse = null, IEnumerable<Delivery>? deliveries = null, long currentLoad = 0L, TruckStatus status = TruckStatus.Idle)
    {
        if (string.IsNullOrEmpty(vin))
        {
            return DomainResult<Truck>.Failure("'Vin' is required.");
        }
        if (vin.Length < 17L)
        {
            return DomainResult<Truck>.Failure("'Vin' must be at least 17 characters.");
        }
        if (vin.Length > 17L)
        {
            return DomainResult<Truck>.Failure("'Vin' must be at most 17 characters.");
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(vin, "^[A-HJ-NPR-Z0-9]{17}\\z"))
        {
            return DomainResult<Truck>.Failure("'Vin' does not match the required pattern.");
        }
        if (maxLoad < 1L)
        {
            return DomainResult<Truck>.Failure("'MaxLoad' must be >= 1.");
        }
        if (maxLoad > 40000L)
        {
            return DomainResult<Truck>.Failure("'MaxLoad' must be <= 40000.");
        }
        if (currentLoad < 0L)
        {
            return DomainResult<Truck>.Failure("'CurrentLoad' must be >= 0.");
        }
        if (currentLoad > 40000L)
        {
            return DomainResult<Truck>.Failure("'CurrentLoad' must be <= 40000.");
        }
        if (status != TruckStatus.Idle && status != TruckStatus.EnRoute && status != TruckStatus.Maintenance && status != TruckStatus.OutOfService)
        {
            return DomainResult<Truck>.Failure(string.Concat("'", status, "' is not a valid member of TruckStatus for property 'Status'."));
        }
        if (Truck.ExistsWithVin(db, vin))
        {
            return DomainResult<Truck>.Failure("Unique constraint violated: 'Vin' value is already used on another 'Truck'.");
        }
        var created = new Truck(vin, maxLoad, warehouse, deliveries, currentLoad, status);
        if (warehouse != null)
        {
            warehouse.AttachTrucks(created);
        }
        db.Record("Truck", "Vin", vin);
        return DomainResult<Truck>.Success(created);
    }
    public DomainResult EnsureUnique(string propertyName, object value)
    {
        if (value == null)
        {
            return DomainResult.Success();
        }
        if (propertyName == "Vin" && object.Equals(this.Vin, value))
        {
            return DomainResult.Success();
        }
        return DomainResult.Failure("A unique assign needs the storage port.");
    }
    public static System.Boolean ExistsWithVin(Poly.Runtime.IStoragePort db, System.String vin) => db.Exists("Truck", "Vin", vin);
}