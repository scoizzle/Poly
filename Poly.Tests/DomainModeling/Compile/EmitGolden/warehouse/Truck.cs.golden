#nullable enable
using System;
using System.Collections.Generic;

public enum TruckStage
{
    EnRoute = 0,
    OutOfService = 1,
    Idle = 2
}

public class Truck
{
    private List<Delivery> _deliveries;
    private Truck()
    {
        this._deliveries = new List<Delivery>();
    }
    private Truck(long maxLoad, string vin, Warehouse? warehouse = null, IEnumerable<Delivery>? deliveries = null, long currentLoad = 0L)
    {
        this.CurrentLoad = currentLoad;
        this.MaxLoad = maxLoad;
        this.Vin = vin;
        this.Warehouse = warehouse;
        this._deliveries = new List<Delivery>(deliveries ?? new List<Delivery>());
        this.CurrentStage = TruckStage.EnRoute;
        {
            var assignValue0 = TruckStatus.EnRoute;
            if (assignValue0 != TruckStatus.Idle && assignValue0 != TruckStatus.EnRoute && assignValue0 != TruckStatus.Maintenance && assignValue0 != TruckStatus.OutOfService)
            {
                throw new ConstraintFailureException("'Status' is not a valid member of TruckStatus.");
            }
            this.Status = assignValue0;
        }
    }
    public long CurrentLoad { get; private set; }
    public long MaxLoad { get; private set; }
    public TruckStatus Status { get; private set; }
    public string Vin { get; private set; } = default!;
    public Warehouse? Warehouse { get; private set; }
    public IReadOnlyList<Delivery> Deliveries
    {
        get => this._deliveries;
    }
    public TruckStage CurrentStage { get; private set; }
    internal void AttachDeliveries(Delivery child)
    {
        this._deliveries.Add(child);
    }
    public DomainResult Load(long weight)
    {
        var assignValue0 = this.CurrentLoad + weight;
        if (assignValue0 < 0L)
        {
            return DomainResult.Failure("'CurrentLoad' must be >= 0.");
        }
        if (assignValue0 > 40000L)
        {
            return DomainResult.Failure("'CurrentLoad' must be <= 40000.");
        }
        this.CurrentLoad = assignValue0;
        return DomainResult.Success();
    }
    public DomainResult Dispatch()
    {
        this.CurrentStage = TruckStage.EnRoute;
        {
            var assignValue0 = TruckStatus.EnRoute;
            if (assignValue0 != TruckStatus.Idle && assignValue0 != TruckStatus.EnRoute && assignValue0 != TruckStatus.Maintenance && assignValue0 != TruckStatus.OutOfService)
            {
                return DomainResult.Failure("'Status' is not a valid member of TruckStatus.");
            }
            this.Status = assignValue0;
        }
        return DomainResult.Success();
    }
    public bool IsOverloaded() => this.CurrentLoad > this.MaxLoad;
    public static DomainResult<Truck> Create(long maxLoad, string vin, Warehouse? warehouse = null, IEnumerable<Delivery>? deliveries = null, long currentLoad = 0L)
    {
        if (currentLoad < 0L)
        {
            return DomainResult<Truck>.Failure("'CurrentLoad' must be >= 0.");
        }
        if (currentLoad > 40000L)
        {
            return DomainResult<Truck>.Failure("'CurrentLoad' must be <= 40000.");
        }
        if (maxLoad < 1L)
        {
            return DomainResult<Truck>.Failure("'MaxLoad' must be >= 1.");
        }
        if (maxLoad > 40000L)
        {
            return DomainResult<Truck>.Failure("'MaxLoad' must be <= 40000.");
        }
        if (string.IsNullOrEmpty(vin))
        {
            return DomainResult<Truck>.Failure("'Vin' is required.");
        }
        if (vin.Length < 17L)
        {
            return DomainResult<Truck>.Failure("'Vin' must be at least 17 characters.");
        }
        if (vin.Length > 17L)
        {
            return DomainResult<Truck>.Failure("'Vin' must be at most 17 characters.");
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(vin, "^[A-HJ-NPR-Z0-9]{17}$"))
        {
            return DomainResult<Truck>.Failure("'Vin' does not match the required pattern.");
        }
        var created = new Truck(maxLoad, vin, warehouse, deliveries, currentLoad);
        if (warehouse != null)
        {
            warehouse.AttachTrucks(created);
        }
        return DomainResult<Truck>.Success(created);
    }
    public DomainResult EnsureUnique(string propertyName, object @value) => DomainResult.Success();
    private void OnEntryEnRoute()
    {
        var assignValue0 = TruckStatus.EnRoute;
        if (assignValue0 != TruckStatus.Idle && assignValue0 != TruckStatus.EnRoute && assignValue0 != TruckStatus.Maintenance && assignValue0 != TruckStatus.OutOfService)
        {
            throw new ConstraintFailureException("'Status' is not a valid member of TruckStatus.");
        }
        this.Status = assignValue0;
    }
}