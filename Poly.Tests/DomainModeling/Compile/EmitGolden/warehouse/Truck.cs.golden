    public bool IsOverloaded() => this.CurrentLoad > this.MaxLoad;
    public static DomainResult<Truck> Create(long maxLoad, string vin, Warehouse? warehouse = null, IEnumerable<Delivery>? deliveries = null, long currentLoad = 0L)
    {
        if (currentLoad < 0L)
        {
            return DomainResult<Truck>.Failure("'CurrentLoad' must be >= 0.");
        }
        if (currentLoad > 40000L)
        {
            return DomainResult<Truck>.Failure("'CurrentLoad' must be <= 40000.");
        }
        if (maxLoad < 1L)
        {
            return DomainResult<Truck>.Failure("'MaxLoad' must be >= 1.");
        }
        if (maxLoad > 40000L)
        {
            return DomainResult<Truck>.Failure("'MaxLoad' must be <= 40000.");
        }
        if (string.IsNullOrEmpty(vin))
        {
            return DomainResult<Truck>.Failure("'Vin' is required.");
        }
        if (vin.Length < 17L)
        {
            return DomainResult<Truck>.Failure("'Vin' must be at least 17 characters.");
        }
        if (vin.Length > 17L)
        {
            return DomainResult<Truck>.Failure("'Vin' must be at most 17 characters.");
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(vin, "^[A-HJ-NPR-Z0-9]{17}$"))
        {
            return DomainResult<Truck>.Failure("'Vin' does not match the required pattern.");
        }
        var created = new Truck(maxLoad, vin, warehouse, deliveries, currentLoad);
        var uniqueCheck = created.EnsureUnique("Vin", vin);
        if (!uniqueCheck.IsSuccess)
        {
            return DomainResult<Truck>.Failure(uniqueCheck.ErrorMessage ?? "");
        }
        if (warehouse != null)
        {
            warehouse.AttachTrucks(created);
        }
        return DomainResult<Truck>.Success(created);
    }
