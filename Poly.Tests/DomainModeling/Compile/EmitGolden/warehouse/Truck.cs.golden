    private DomainResult<Warehouse> CreateWarehouse(long capacity, string code, string name, string zip, long safetyStock = 100L, TruckStatus status = TruckStatus.Idle)
    {
        var warehouseResult = Warehouse.Create(capacity, code, name, zip, new List<Truck>(), safetyStock, status);
        if (!warehouseResult.IsSuccess)
        {
            return DomainResult<Warehouse>.Failure(warehouseResult.ErrorMessage ?? "");
        }
        var warehouse = warehouseResult.Value;
        this.Warehouse = warehouse;
        return DomainResult<Warehouse>.Success(warehouse);
    }
