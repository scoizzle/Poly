#nullable enable
using System;
using System.Collections.Generic;

public class Warehouse
{
    private List<Truck> _trucks;
    private Warehouse()
    {
        this._trucks = new List<Truck>();
    }
    private Warehouse(long capacity, string code, string name, string zip, IEnumerable<Truck>? trucks = null, long safetyStock = 100L, TruckStatus status = TruckStatus.Idle)
    {
        this.Capacity = capacity;
        this.Code = code;
        this.Name = name;
        this.SafetyStock = safetyStock;
        this.Status = status;
        this.Zip = zip;
        this._trucks = new List<Truck>(trucks ?? new List<Truck>());
    }
    public long Capacity { get; private set; }
    public string Code { get; private set; } = default!;
    public string Name { get; private set; } = default!;
    public long SafetyStock { get; private set; }
    public TruckStatus Status { get; private set; }
    public string Zip { get; private set; } = default!;
    public IReadOnlyList<Truck> Trucks
    {
        get => this._trucks;
    }
    private DomainResult<Truck> CreateTrucks(long maxLoad, string vin, long currentLoad = 0L)
    {
        var truckResult = Truck.Create(maxLoad, vin, this, new List<Delivery>(), currentLoad);
        if (!truckResult.IsSuccess)
        {
            return DomainResult<Truck>.Failure(truckResult.ErrorMessage ?? "");
        }
        var truck = truckResult.Value;
        return DomainResult<Truck>.Success(truck);
    }
    internal void AttachTrucks(Truck child)
    {
        this._trucks.Add(child);
    }
    public DomainResult AdjustCapacity(long delta)
    {
        var assignValue0 = this.Capacity + delta;
        if (assignValue0 < 1L)
        {
            return DomainResult.Failure("'Capacity' must be >= 1.");
        }
        if (assignValue0 > 10000L)
        {
            return DomainResult.Failure("'Capacity' must be <= 10000.");
        }
        this.Capacity = assignValue0;
        return DomainResult.Success();
    }
    public DomainResult SetStatus(TruckStatus status)
    {
        var assignValue0 = status;
        if (assignValue0 != TruckStatus.Idle && assignValue0 != TruckStatus.EnRoute && assignValue0 != TruckStatus.Maintenance && assignValue0 != TruckStatus.OutOfService)
        {
            return DomainResult.Failure("'Status' is not a valid member of TruckStatus.");
        }
        this.Status = assignValue0;
        return DomainResult.Success();
    }
    public DomainResult<Truck> RegisterTruck(string vin, long maxLoad)
    {
        var create0 = this.CreateTrucks(maxLoad, vin);
        if (!create0.IsSuccess)
        {
            return DomainResult<Truck>.Failure(create0.ErrorMessage ?? "");
        }
        var created1 = create0.Value;
        return DomainResult<Truck>.Success(created1);
    }
    public bool IsOperational() => this.Capacity > 0L;
    public bool HasCapacity() => this.Capacity > 0L;
    public static DomainResult<Warehouse> Create(long capacity, string code, string name, string zip, IEnumerable<Truck>? trucks = null, long safetyStock = 100L, TruckStatus status = TruckStatus.Idle)
    {
        if (capacity < 1L)
        {
            return DomainResult<Warehouse>.Failure("'Capacity' must be >= 1.");
        }
        if (capacity > 10000L)
        {
            return DomainResult<Warehouse>.Failure("'Capacity' must be <= 10000.");
        }
        if (string.IsNullOrEmpty(code))
        {
            return DomainResult<Warehouse>.Failure("'Code' is required.");
        }
        if (code.Length < 2L)
        {
            return DomainResult<Warehouse>.Failure("'Code' must be at least 2 characters.");
        }
        if (code.Length > 10L)
        {
            return DomainResult<Warehouse>.Failure("'Code' must be at most 10 characters.");
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(code, "^WH-[0-9]{3}$"))
        {
            return DomainResult<Warehouse>.Failure("'Code' does not match the required pattern.");
        }
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Warehouse>.Failure("'Name' is required.");
        }
        if (name.Length < 3L)
        {
            return DomainResult<Warehouse>.Failure("'Name' must be at least 3 characters.");
        }
        if (name.Length > 50L)
        {
            return DomainResult<Warehouse>.Failure("'Name' must be at most 50 characters.");
        }
        if (safetyStock < 0L)
        {
            return DomainResult<Warehouse>.Failure("'SafetyStock' must be >= 0.");
        }
        if (safetyStock > 5000L)
        {
            return DomainResult<Warehouse>.Failure("'SafetyStock' must be <= 5000.");
        }
        if (status != TruckStatus.Idle && status != TruckStatus.EnRoute && status != TruckStatus.Maintenance && status != TruckStatus.OutOfService)
        {
            return DomainResult<Warehouse>.Failure("'Status' is not a valid member of TruckStatus.");
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(zip, "^\\d{5}$"))
        {
            return DomainResult<Warehouse>.Failure("'Zip' does not match the required pattern.");
        }
        var created = new Warehouse(capacity, code, name, zip, trucks, safetyStock, status);
        return DomainResult<Warehouse>.Success(created);
    }
    public DomainResult EnsureUnique(string propertyName, object value) => DomainResult.Success();
}