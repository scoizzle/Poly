#nullable enable
using System.Collections.Generic;

using Poly.Runtime;

public class Warehouse
{
    private List<Truck> _trucks = new List<Truck>();
    private Warehouse() { }
    private Warehouse(string code, string name, string zip, long capacity, IEnumerable<Truck>? trucks = null, long safetyStock = 100L, TruckStatus status = TruckStatus.Idle)
    {
        this.Code = code;
        this.Name = name;
        this.Zip = zip;
        this.Capacity = capacity;
        this.SafetyStock = safetyStock;
        this.Status = status;
        this._trucks = new List<Truck>(trucks ?? new List<Truck>());
    }
    public string Code { get; private set; } = default!;
    public string Name { get; private set; } = default!;
    public string Zip { get; private set; } = default!;
    public long Capacity { get; private set; }
    public long SafetyStock { get; private set; }
    public TruckStatus Status { get; private set; }
    public IReadOnlyList<Truck> Trucks
    {
        get => this._trucks;
    }
    public DomainResult<Truck> CreateTrucks(string vin, long maxLoad, Poly.Runtime.IStoragePort db, long currentLoad = 0L, TruckStatus status = TruckStatus.Idle)
    {
        var truckResult = Truck.Create(vin, maxLoad, db, this, new List<Delivery>(), currentLoad, status);
        if (!truckResult.IsSuccess)
        {
            return DomainResult<Truck>.Failure(truckResult.ErrorMessage ?? "");
        }
        var truck = truckResult.Value;
        return DomainResult<Truck>.Success(truck);
    }
    internal void AttachTrucks(Truck child)
    {
        this._trucks.Add(child);
    }
    public DomainResult AdjustCapacity(long delta)
    {
        var assignValue0 = this.Capacity + delta;
        if (assignValue0 < 1L)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Range("'Capacity' must be >= 1.", "Warehouse.Capacity"));
        }
        if (assignValue0 > 10000L)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Range("'Capacity' must be <= 10000.", "Warehouse.Capacity"));
        }
        this.Capacity = assignValue0;
        return DomainResult.Success();
    }
    public DomainResult SetStatus(TruckStatus status)
    {
        var assignValue0 = status;
        if (assignValue0 != TruckStatus.Idle && assignValue0 != TruckStatus.EnRoute && assignValue0 != TruckStatus.Maintenance && assignValue0 != TruckStatus.OutOfService)
        {
            return DomainResult.Failure(Poly.Runtime.DomainFailure.Enum("'Status' is not a valid member of TruckStatus.", "Warehouse.Status"));
        }
        this.Status = assignValue0;
        return DomainResult.Success();
    }
    public DomainResult<Truck> RegisterTruck(string vin, long maxLoad, Poly.Runtime.IStoragePort db)
    {
        var create0 = this.CreateTrucks(vin, maxLoad, db, 0L, TruckStatus.Idle);
        if (!create0.IsSuccess)
        {
            return DomainResult<Truck>.Failure(create0.ErrorMessage ?? "");
        }
        var created1 = create0.Value;
        return DomainResult<Truck>.Success(created1);
    }
    public bool IsOperational() => this.Capacity > 0L;
    public bool HasCapacity() => this.Capacity > 0L;
    public static DomainResult<Warehouse> Create(string code, string name, string zip, long capacity, Poly.Runtime.IStoragePort db, IEnumerable<Truck>? trucks = null, long safetyStock = 100L, TruckStatus status = TruckStatus.Idle)
    {
        if (string.IsNullOrEmpty(code))
        {
            return DomainResult<Warehouse>.Failure(Poly.Runtime.DomainFailure.Required("'Code' is required.", "Warehouse.Code"));
        }
        if (code.Length < 2L)
        {
            return DomainResult<Warehouse>.Failure(Poly.Runtime.DomainFailure.Length("'Code' must be at least 2 characters.", "Warehouse.Code"));
        }
        if (code.Length > 10L)
        {
            return DomainResult<Warehouse>.Failure(Poly.Runtime.DomainFailure.Length("'Code' must be at most 10 characters.", "Warehouse.Code"));
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(code, "^WH-[0-9]{3}\\z"))
        {
            return DomainResult<Warehouse>.Failure(Poly.Runtime.DomainFailure.Pattern("'Code' does not match the required pattern.", "Warehouse.Code"));
        }
        if (string.IsNullOrEmpty(name))
        {
            return DomainResult<Warehouse>.Failure(Poly.Runtime.DomainFailure.Required("'Name' is required.", "Warehouse.Name"));
        }
        if (name.Length < 3L)
        {
            return DomainResult<Warehouse>.Failure(Poly.Runtime.DomainFailure.Length("'Name' must be at least 3 characters.", "Warehouse.Name"));
        }
        if (name.Length > 50L)
        {
            return DomainResult<Warehouse>.Failure(Poly.Runtime.DomainFailure.Length("'Name' must be at most 50 characters.", "Warehouse.Name"));
        }
        if (string.IsNullOrEmpty(zip))
        {
            return DomainResult<Warehouse>.Failure(Poly.Runtime.DomainFailure.Required("'Zip' is required.", "Warehouse.Zip"));
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(zip, "^\\d{5}\\z"))
        {
            return DomainResult<Warehouse>.Failure(Poly.Runtime.DomainFailure.Pattern("'Zip' does not match the required pattern.", "Warehouse.Zip"));
        }
        if (capacity < 1L)
        {
            return DomainResult<Warehouse>.Failure(Poly.Runtime.DomainFailure.Range("'Capacity' must be >= 1.", "Warehouse.Capacity"));
        }
        if (capacity > 10000L)
        {
            return DomainResult<Warehouse>.Failure(Poly.Runtime.DomainFailure.Range("'Capacity' must be <= 10000.", "Warehouse.Capacity"));
        }
        if (safetyStock < 0L)
        {
            return DomainResult<Warehouse>.Failure(Poly.Runtime.DomainFailure.Range("'SafetyStock' must be >= 0.", "Warehouse.SafetyStock"));
        }
        if (safetyStock > 5000L)
        {
            return DomainResult<Warehouse>.Failure(Poly.Runtime.DomainFailure.Range("'SafetyStock' must be <= 5000.", "Warehouse.SafetyStock"));
        }
        if (status != TruckStatus.Idle && status != TruckStatus.EnRoute && status != TruckStatus.Maintenance && status != TruckStatus.OutOfService)
        {
            return DomainResult<Warehouse>.Failure(Poly.Runtime.DomainFailure.Enum(string.Concat("'", status, "' is not a valid member of TruckStatus for property 'Status'."), "Warehouse.Status"));
        }
        if (Warehouse.ExistsWithCode(db, code))
        {
            return DomainResult<Warehouse>.Failure(Poly.Runtime.DomainFailure.Unique("Unique constraint violated: 'Code' value is already used on another 'Warehouse'.", "Warehouse.Code"));
        }
        var created = new Warehouse(code, name, zip, capacity, trucks, safetyStock, status);
        db.Record("Warehouse", "Code", code);
        return DomainResult<Warehouse>.Success(created);
    }
    public DomainResult EnsureUnique(string propertyName, object value)
    {
        if (value == null)
        {
            return DomainResult.Success();
        }
        if (propertyName == "Code" && object.Equals(this.Code, value))
        {
            return DomainResult.Success();
        }
        return DomainResult.Failure("A unique assign needs the storage port.");
    }
    public static System.Boolean ExistsWithCode(Poly.Runtime.IStoragePort db, System.String code) => db.Exists("Warehouse", "Code", code);
}