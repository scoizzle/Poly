<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <OutputType>Library</OutputType>
        <RootNamespace>Poly</RootNamespace>

        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <PackageId>Poly</PackageId>
        <Authors>Scot 'Scoizzle' Murphy</Authors>
        <Product>Poly</Product>
        <Description>Domain models as libraries: a .poly DSL lowered to one symbolic operation module, analyzed fail-closed, then run on a stack VM or printed as C#.</Description>
        <Copyright>Scot 'Scoizzle' Murphy</Copyright>
        <PackageProjectUrl>https://github.com/scoizzle/Poly/</PackageProjectUrl>
        <RepositoryUrl>https://github.com/scoizzle/Poly/</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <Owners>Scot 'Scoizzle' Murphy</Owners>
        <Version>1.0.1</Version>
    </PropertyGroup>

    <ItemGroup>
        <!-- The storage port and constraint failure the emitted C# names, in their own
             BCL-only assembly. Transitive, so consumers need no edit. -->
        <ProjectReference Include="..\Poly.Runtime\Poly.Runtime.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Enables smoke / integration tests in Poly.Tests to reach internal RISC VM types during development and transition.
             No effect on public API surface or packaged consumers. -->
        <InternalsVisibleTo Include="Poly.Tests" />
        <InternalsVisibleTo Include="Poly.Mcp" />
        <InternalsVisibleTo Include="Poly.Packs.Product" />
        <InternalsVisibleTo Include="Poly.Compile" />
    </ItemGroup>
</Project>