domain Checkout

Order: entity {
  Total: Number default(0)
  Pay: action (request: ChargeRequest) {
    assign Total to Total
  }
}

// Surface-only sibling: Lower erases the bind and Pay still runs.
Stripe: contract internal stripe v1 {
  ChargeRequest: value {
    Amount: Number
    Currency: Text
  }
  Charge: outbound operation ChargeRequest
}

ChargeOrder: bind Stripe Charge to Pay request
