// =============================================================================
// Library Checkout System — Poly DSL Domain Model
//
// Showcases Phase 1a/1b surface:
//   • Entities with rich constraints (required, unique, range, length, pattern,
//     equals, enum)
//   • Lifecycle stages with entry/exit effects and actions
//   • Policies with arithmetic, collection quantifiers, nav reads
//   • Actions with parameters, require gates, invoke, create, create in,
//     conditional, delete
//   • Cross-entity notifications via stage subscriptions (when)
//   • Entity inheritance
//   • N1 navigation properties (one-to-many, one-to-one)
// =============================================================================

domain Library


// =============================================================================
// Book — core inventory item with full lifecycle
// =============================================================================

Book: entity {
  Title: Text required                                     // required string
  Author: Text required
  ISBN: Text unique length(10, 17)                          // unique + length
  Pages: Number range(1, 10000)                             // numeric range
  Genre: Text enum(Fiction, NonFiction, Reference)          // closed enum
  Condition: Text equals("New") enum(New, Good, Fair, Poor) // enum with default
  CheckedOutTo: Text                                        // member ID when out
  TimesBorrowed: Number

  // ── Policies ───────────────────────────────────────────────────────────────
  IsNew: policy { Condition is "New" }
  IsPopular: policy { TimesBorrowed >= 10 }

  // ── On-shelf: available for checkout ───────────────────────────────────────
  OnShelf: stage {
    CheckOut: action (memberId: Text) {
      invoke ValidateEligibility
      assign CheckedOutTo to memberId
      transition to CheckedOut
    }
  }

  // ── Checked-out: in a member's possession ──────────────────────────────────
  CheckedOut: stage {
    entry { assign TimesBorrowed to TimesBorrowed + 1 }
    Return: action {
      assign CheckedOutTo to ""
      transition to OnShelf
    }
    ReportDamaged: action { transition to Damaged }
  }

  // ── Damaged: needs repair or disposal ──────────────────────────────────────
  Damaged: stage {
    entry { assign Condition to "Poor" }
    Repair: action {
      assign Condition to "Good"
      transition to OnShelf
    }
    WriteOff: action { transition to Discarded }
  }

  // ── Discarded: removed from circulation (terminal) ─────────────────────────
  Discarded: stage { }

  // ── Entity-level actions ───────────────────────────────────────────────────
  ValidateEligibility: action {
    // Validation logic (no-op stub — policy gates would apply in practice)
  }
}


// =============================================================================
// LoanRecord — tracks individual borrowing events (created by CheckOut)
// =============================================================================

LoanRecord: entity {
  BookTitle: Text required
  MemberName: Text required
  CheckedOutAt: DateTime
  ReturnedAt: DateTime

  Active: stage {
    Complete: action {
      transition to Completed
    }
  }

  Completed: stage { }
}


// =============================================================================
// Reservation — hold request for a currently checked-out book
// =============================================================================

Reservation: entity {
  member: Member
  book: Book
  PlacedAt: DateTime
  FulfilledAt: DateTime

  Pending: stage {
    Fulfill: action { transition to Fulfilled }
    Cancel: action { transition to Cancelled }
  }

  Fulfilled: stage { }

  Cancelled: stage { }
}


// =============================================================================
// Member — library patron with status, policies, and relationships
// =============================================================================

Member: entity {
  Name: Text required
  Email: Text unique pattern("^[^@]+@[^@]+$")
  MemberSince: Date
  Status: Text equals("Active") enum(Active, Suspended, Closed)
  MaxItems: Number range(1, 20) required
  CurrentBorrowCount: Number
  IsMinor: Boolean
  LastActivity: DateTime

  // ── Policies ───────────────────────────────────────────────────────────────
  IsAdult: policy { IsMinor is false }
  GoodStanding: policy { Status is "Active" }
  AtLimit: policy { CurrentBorrowCount >= MaxItems }

  // ── Navigation properties ──────────────────────────────────────────────────
  books: many Book              // currently checked-out books
  fines: many Fine              // outstanding or historical fines
  reservations: many Reservation

  // ── Active — normal operating state ────────────────────────────────────────
  Active: stage {
    Suspend: action
      require not AtLimit          // gate: can't suspend someone at their limit
    {
      assign Status to "Suspended"
      if (CurrentBorrowCount > 0) {
        assign MaxItems to CurrentBorrowCount
      }
      transition to Suspended
    }

    // Auto-suspend when any related book enters the Damaged stage
    when books Damaged {
      assign Status to "Suspended"
      transition to Suspended
    }

    CloseAccount: action { transition to Closed }
  }

  // ── Suspended — borrowing frozen, can be reinstated ────────────────────────
  Suspended: stage {
    entry { assign MaxItems to 0 }
    exit  { assign MaxItems to 5 }
    Reinstate: action {
      assign Status to "Active"
      transition to Active
    }
  }

  // ── Closed — account terminated ────────────────────────────────────────────
  Closed: stage { }
}


// =============================================================================
// PremiumMember — inherits all of Member, adds loyalty benefits
// =============================================================================

PremiumMember: Member entity {
  RewardPoints: Number
  Tier: Text enum(Silver, Gold, Platinum)
  PriorityQueue: Boolean

  IsLoyal: policy { RewardPoints >= 100 }
  HasPriority: policy { PriorityQueue is true }
}


// =============================================================================
// Fine — penalty for late, lost, or damaged items
// =============================================================================

Fine: entity {
  Amount: Number required
  Reason: Text
  DateIssued: DateTime
  Paid: Boolean
  Waived: Boolean

  // The member this fine belongs to
  patron: Member

  // ── Unpaid — active penalty ────────────────────────────────────────────────
  Unpaid: stage {
    // Conditional: waive small fines automatically
    Pay: action {
      if (Amount <= 0) {
        assign Paid to true
        assign Waived to true
      } else {
        assign Paid to true
      }
      transition to Paid
    }
    Waive: action {
      assign Amount to 0
      assign Paid to true
      assign Waived to true
      delete                        // soft-delete: removes fine from consideration
    }
  }

  // ── Paid — resolved ────────────────────────────────────────────────────────
  Paid: stage {
    entry { assign Paid to true }
  }
}
