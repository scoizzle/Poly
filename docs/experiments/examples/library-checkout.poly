// =============================================================================
// Library Checkout System — Poly DSL Domain Model
//
// Three concerns, cleanly separated:
//   • Book — catalog entry (static definition, no lifecycle)
//   • Patron — user profile with borrowing lifecycle (Active → Suspended → Closed)
//   • Loan — transactional record carrying the check-out → overdue → returned
//     lifecycle. The Loan connects a Book (by ISBN) to a Patron.
//   • Fine — monetary penalty tied to a patron
//
// Showcases Phase 1a/1b surface:
//   • Entities with rich constraints  |  • Actions with parameters, require
//   • Policies with arithmetic, nav   |    gates, conditional, create in,
//     reads, collection quantifiers   |    invoke, delete
//   • Lifecycle stages with entry/exit | • Cross-entity subscriptions (when)
//     effects and actions              | • Navigation properties (N1: one-to-many)
// =============================================================================

domain Library

// =============================================================================
// Book — catalog entry. A static definition with no lifecycle or actions.
// Books are identified by ISBN and represent the "what" of a library.
// =============================================================================

Book: entity {
  Title: Text required
  Author: Text required
  ISBN: Text unique length(10, 17)
  Pages: Number range(1, 10000)
  Genre: Text enum(Fiction, NonFiction, Reference)
}


// =============================================================================
// Patron — library user with borrowing privileges and account lifecycle.
// =============================================================================

Patron: entity {
  Name: Text required
  Email: Text unique pattern("^[^@]+@[^@]+$")
  MemberSince: Date
  Status: Text default("Active") enum(Active, Suspended, Closed)
  MaxItems: Number range(1, 20) required
  CurrentBorrowCount: Number
  OutstandingFines: Number

  // ── Navigation Properties ──────────────────────────────────────────────────
  loans: many Loan
  fines: many Fine

  // ── Policies ───────────────────────────────────────────────────────────────
  GoodStanding: policy { Status is "Active" }
  AtLimit: policy { CurrentBorrowCount >= MaxItems }
  HasFines: policy { OutstandingFines > 0 }
  HasOverdueLoans: policy { any loans where Status is "Overdue" }
  AccountInGoodStanding: policy {
    Status is "Active" and OutstandingFines == 0
  }

  // ── Active — can borrow ────────────────────────────────────────────────────
  Active: stage {
    CheckOut: action (book: Book)
      require GoodStanding
      require not AtLimit
      require not HasFines
    {
      create in loans { BookIsbn: book.ISBN }
      assign CurrentBorrowCount to CurrentBorrowCount + 1
    }

    Suspend: action
      require not AtLimit
    {
      assign Status to "Suspended"
      assign CurrentBorrowCount to 0
      transition to Suspended
    }

    // Auto-fine when any related loan goes overdue
    when loans Overdue {
      create Fine { Amount: 5 Reason: "Overdue item" }
      assign OutstandingFines to OutstandingFines + 5
    }

    CloseAccount: action { transition to Closed }
  }

  // ── Suspended — borrowing frozen ───────────────────────────────────────────
  Suspended: stage {
    entry { assign MaxItems to 0 }
    exit  { assign MaxItems to 5 }
    Reinstate: action
      require not HasOverdueLoans
    {
      assign Status to "Active"
      transition to Active
    }
  }

  // ── Closed — account terminated ────────────────────────────────────────────
  Closed: stage { }
}


// =============================================================================
// Loan — a single borrowing event. Represents one book checked out by one patron.
// This is where the real lifecycle lives: Active → Overdue → Returned.
// =============================================================================

Loan: entity {
  BookIsbn: Text required
  Status: Text
  CheckedOutAt: DateTime
  DueDate: DateTime
  ReturnedAt: DateTime
  TimesRenewed: Number

  // Reference to the actual catalog entry
  book: Book
  // The patron who borrowed this item (set implicitly by create in loans)
  borrower: Patron

  // ── Active — currently borrowed and not yet overdue ────────────────────────
  Active: stage {
    Renew: action {
      assign DueDate to DueDate + 14
      assign TimesRenewed to TimesRenewed + 1
    }
  }

  // ── Overdue — beyond due date; fines applied at patron level via subscription ──
  Overdue: stage { }

  // ── Returned — resolved ─────────────────────────────────────────────────────
  Returned: stage { }
}


// =============================================================================
// Fine — monetary penalty for overdue, lost, or damaged items
// =============================================================================

Fine: entity {
  Amount: Number required
  Reason: Text
  DateIssued: DateTime
  Paid: Boolean

  // The patron who owes this fine
  patron: Patron

  // ── Unpaid — penalty is active ─────────────────────────────────────────────
  Unpaid: stage {
    Pay: action {
      if (Amount <= 0) {
        assign Paid to true
        delete
      } else {
        assign Paid to true
      }
      transition to Resolved
    }
    Waive: action {
      assign Amount to 0
      assign Paid to true
      transition to Resolved
    }
  }

  // ── Resolved — paid or waived ──────────────────────────────────────────────
  Resolved: stage {
    entry { assign Paid to true }
  }
}


// =============================================================================
// PremiumPatron — independent loyalty profile, not a subtype of Patron
// =============================================================================

PremiumPatron: entity {
  Name: Text required
  Email: Text unique pattern("^[^@]+@[^@]+$")
  RewardPoints: Number
  Tier: Text enum(Silver, Gold, Platinum) default("Silver")
  PriorityAccess: Boolean

  IsLoyal: policy { RewardPoints >= 100 }
  HasPriority: policy { PriorityAccess is true }
  UnlimitedItems: policy { Tier is "Platinum" or PriorityAccess is true }
}

