domain CiPipeline

Conclusion: enum {
  Success,
  Failure,
  Cancelled,
  Skipped,
}

Step: entity {
  Name: Text
  Command: Text
  Pending: stage {
    Run: action {
      transition to Running
    }
  }
  Running: stage {
    Succeed: action {
      transition to Passed
    }
    Fail: action {
      transition to Failed
    }
  }
  Passed: stage {
  }
  Failed: stage {
    Retry: action {
      transition to Pending
    }
  }
}

Job: entity {
  Name: Text
  Steps: many Step
  needs: many Job
  Queued: stage {
    Start: action {
      transition to Running
    }
    Skip: action {
      transition to Skipped
    }
  }
  Running: stage {
    Finish: action {
      transition to Passed
    }
    Cancel: action {
      transition to Cancelled
    }
  }
  Passed: stage {
  }
  Skipped: stage {
  }
  Cancelled: stage {
  }
}

Run: entity {
  Number: Number
  Jobs: many Job
  Queued: stage {
    Dispatch: action {
      transition to Running
    }
  }
  Running: stage {
    Complete: action {
      transition to Passed
    }
    Cancel: action {
      transition to Cancelled
    }
  }
  Passed: stage {
  }
  Cancelled: stage {
  }
}
