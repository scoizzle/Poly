domain PolyPipeline

Severity: enum {
  Error,
  Warning,
  Info,
}

Diagnostic: entity {
  Code: Text length(2, 12)
  Message: Text
  ElementPath: Text optional
  Severity: Severity
}

Source: entity {
  Path: Text unique
  diagnostics: many Diagnostic
  Clean: policy { count diagnostics where Severity is Error is 0 }
  Parsed: stage {
    Load: action
      require Clean {
      transition to Loaded
    }
  }
  Loaded: stage {
    Resolve: action {
      transition to Resolved
    }
  }
  Resolved: stage {
    Analyze: action {
      transition to Analyzed
    }
  }
  Analyzed: stage {
    Lower: action {
      if (count diagnostics where Severity is Error > 0) {
        transition to Failed
      }
      else {
        transition to Lowered
      }
    }
  }
  Lowered: stage {
    Produce: action {
      transition to Produced
    }
  }
  Produced: stage {
  }
  Failed: stage {
  }
}
