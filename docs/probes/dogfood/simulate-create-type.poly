domain SimulateCreateType
uses temporal
uses storage

// Dogfood: MCP simulate create Type when source owns unambiguous many-rel.
// Expect: Fine registered, unlinked. Patron.fines stays 0; HasFines /
// HasFineCount false; reverse Fine.patron unlinked. Use create in Rel to link.

Patron: entity {
  Name: Text required
  fines: many Fine
  HasFines: policy { fines exists }
  HasFineCount: policy { count fines > 0 }
  NoFines: policy { count fines == 0 }

  Active: stage {
    AssessByType: action -> Fine {
      create Fine { Amount: 5 Reason: "TypeCreate" }
    }
  }
}

Fine: entity {
  Amount: Number range(0, 500) required
  Reason: Text required
  patron: Patron
}
