domain SimulateCreateCreateIn
uses temporal
uses storage

// Dogfood PR51 combined: Type-create vs create-in under one MCP session.
// Sequential AssessByType then AssessByRel on the same Patron.
// Compare list_instances(Fine), evaluate_policy(HasFines/HasFineCount/NoFines),
// and invoke returnInstanceId linkage after each action.

Patron: entity {
  Name: Text required
  fines: many Fine
  HasFines: policy { fines exists }
  HasFineCount: policy { count fines > 0 }
  NoFines: policy { count fines == 0 }

  Active: stage {
    AssessByType: action -> Fine {
      create Fine { Amount: 5 Reason: "TypeCreate" }
    }
    AssessByRel: action -> Fine {
      create in fines { Amount: 7 Reason: "CreateIn" }
    }
  }
}

Fine: entity {
  Amount: Number range(0, 500) required
  Reason: Text required
  patron: Patron
}
