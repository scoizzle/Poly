<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Poly.DslCompiler</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The [Range] argument rule is internal; Poly.Tests proves it directly across the
         CLR numeric types, including short/byte targets the DSL cannot name. -->
