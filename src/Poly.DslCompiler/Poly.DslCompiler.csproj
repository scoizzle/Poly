  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Poly/Poly.csproj" />
    <ProjectReference Include="../Poly.Packs.Product/Poly.Packs.Product.csproj" />
  </ItemGroup>

</Project>
