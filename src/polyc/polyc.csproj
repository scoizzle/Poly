<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>polyc</AssemblyName>
    <RootNamespace>Polyc</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>polyc</ToolCommandName>
    <PackageId>Poly.Polyc</PackageId>
    <Description>The Poly compiler: check and build .poly domains, and serve them over LSP and MCP.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Poly.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Poly/Poly.csproj" />
    <ProjectReference Include="../Poly.Compile/Poly.Compile.csproj" />
    <ProjectReference Include="../Poly.Packs.Product/Poly.Packs.Product.csproj" />
    <ProjectReference Include="../../Poly.Mcp/Poly.Mcp.csproj" />
  </ItemGroup>

</Project>
